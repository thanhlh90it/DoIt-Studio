---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "DoIT-Studio | Cybernetic Digital Workspace", 
  description = "Tối giản, Sáng tạo và Xây dựng các ứng dụng chất lượng cao với tư duy kỹ thuật tương lai." 
} = Astro.props;

const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { name: "Trang chủ", mobileName: "Trang chủ", href: "/", code: "01" },
  { name: "Ý tưởng Ứng dụng", mobileName: "Ứng dụng", href: "/apps", code: "02" },
  { name: "Triết lý sống", mobileName: "Triết lý", href: "/philosophy", code: "03" },
  { name: "Trang cá nhân", mobileName: "Hồ sơ", href: "/profile", code: "04" },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="vi" class="dark scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#02040a] text-slate-100 font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen flex flex-col selection:bg-cyan-500 selection:text-black relative bg-grid-pattern overflow-x-hidden w-full">
    <!-- Ultramarine Ambient Background Laser Light -->
    <div class="ambient-glow-ultramarine top-0 left-1/2 -translate-x-1/2 w-[90vw] max-w-[900px] h-[300px] sm:h-[380px] opacity-60 sm:opacity-70 pointer-events-none"></div>

    <!-- Header Navbar HUD -->
    <header class="sticky top-2 sm:top-4 z-50 max-w-5xl mx-auto px-2.5 sm:px-4 w-full">
      <div class="glass-card hud-corners rounded-xl sm:rounded-2xl px-3 sm:px-4 py-2 sm:py-2.5 flex items-center justify-between shadow-2xl shadow-blue-950/80 border border-blue-500/30 backdrop-blur-xl bg-[#030712]/90">
        <!-- Logo HUD -->
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-tr from-blue-700 via-blue-600 to-cyan-400 p-0.5 shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform duration-300">
            <div class="w-full h-full bg-black rounded-[10px] flex items-center justify-center">
              <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5" viewBox="0 0 512 512" fill="none">
                <path d="M 130 140 C 130 128, 140 118, 154 118 L 220 118 C 285 118, 330 162, 330 256 C 330 350, 285 394, 220 394 L 154 394 C 140 394, 130 384, 130 372 Z M 186 174 L 186 338 L 218 338 C 255 338, 274 308, 274 256 C 274 204, 255 174, 218 174 Z" fill="url(#nav-logo-grad)" />
                <circle cx="360" cy="336" r="32" fill="#00F0FF" />
                <defs>
                  <linearGradient id="nav-logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#38BDF8" />
                    <stop offset="100%" stop-color="#1D4ED8" />
                  </linearGradient>
                </defs>
              </svg>
            </div>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center gap-1">
              <span class="font-tech font-bold text-base sm:text-lg tracking-tight bg-gradient-to-r from-white via-slate-100 to-slate-300 bg-clip-text text-transparent">
                DoIT<span class="text-cyan-400 font-mono text-xs sm:text-sm">[STUDIO]</span>
              </span>
            </div>
            <span class="hidden sm:block text-[9px] sm:text-[10px] font-mono text-slate-400 tracking-widest uppercase">SYS.CORE // v2.4</span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1 bg-black/80 p-1.5 rounded-xl border border-slate-800">
          {navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={`px-3 py-1.5 rounded-lg text-xs font-mono font-medium transition-all duration-300 flex items-center gap-1.5 ${
                  active
                    ? 'bg-gradient-to-r from-blue-700 to-blue-600 text-cyan-200 border border-cyan-400/40 shadow-lg shadow-blue-600/40'
                    : 'text-slate-400 hover:text-slate-100 hover:bg-slate-900/80'
                }`}
              >
                <span class="text-[10px] text-blue-400 font-bold">{item.code}.</span>
                <span>{item.name}</span>
              </a>
            );
          })}
        </nav>

        <!-- Availability Status Badge -->
        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href="/profile"
            class="inline-flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-mono font-bold px-2.5 sm:px-3.5 py-1.5 rounded-lg sm:rounded-xl bg-black text-cyan-300 border border-cyan-500/40 hover:bg-blue-950/80 hover:border-cyan-400 transition-all duration-300 shadow-sm"
          >
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
            </span>
            <span>CONNECT</span>
          </a>
        </div>
      </div>

      <!-- Mobile Responsive Navigation Bar (Grid 4 columns, clean touch target) -->
      <nav class="md:hidden grid grid-cols-4 gap-1 mt-2 glass-card hud-corners rounded-xl py-1.5 px-1.5 border border-blue-500/30 text-center font-mono">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`py-1.5 px-1 rounded-lg text-[11px] font-semibold transition-all truncate ${
                active ? 'bg-blue-600/40 text-cyan-200 border border-cyan-400/40' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-900/50'
              }`}
            >
              {item.mobileName}
            </a>
          );
        })}
      </nav>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow z-10 relative w-full overflow-x-hidden">
      <slot />
    </main>

    <!-- Footer HUD Telemetry Console -->
    <footer class="border-t border-blue-900/50 bg-[#02040a]/95 backdrop-blur-md py-8 sm:py-12 mt-16 sm:mt-20 relative z-10 font-mono w-full">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-6 sm:pb-8 border-b border-slate-800/80 text-center md:text-left">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-blue-700 to-cyan-500 p-0.5 shadow-md shadow-blue-600/40 shrink-0">
              <div class="w-full h-full bg-black rounded-[10px] flex items-center justify-center">
                <svg class="w-4 h-4" viewBox="0 0 512 512" fill="none">
                  <path d="M 130 140 C 130 128, 140 118, 154 118 L 220 118 C 285 118, 330 162, 330 256 C 330 350, 285 394, 220 394 L 154 394 C 140 394, 130 384, 130 372 Z M 186 174 L 186 338 L 218 338 C 255 338, 274 308, 274 256 C 274 204, 255 174, 218 174 Z" fill="#38BDF8" />
                  <circle cx="360" cy="336" r="32" fill="#00F0FF" />
                </svg>
              </div>
            </div>
            <div>
              <span class="font-tech font-bold text-white tracking-tight text-base">DoIT-Studio</span>
              <p class="text-[10px] sm:text-xs text-slate-400">CYBERNETIC PRODUCT & PHILOSOPHY LAB</p>
            </div>
          </div>

          <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6 text-xs text-slate-400">
            <a href="/" class="hover:text-cyan-300 transition-colors">// Home</a>
            <a href="/apps" class="hover:text-cyan-300 transition-colors">// Apps</a>
            <a href="/philosophy" class="hover:text-cyan-300 transition-colors">// Philosophy</a>
            <a href="/profile" class="hover:text-cyan-300 transition-colors">// Profile</a>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-[11px] sm:text-xs text-slate-500">
          <p>© {new Date().getFullYear()} DoIT-Studio. ALL PROTOCOLS RESERVED.</p>
          <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-3">
            <span class="text-cyan-400">[SYS_STATUS: ONLINE]</span>
            <span class="hidden sm:inline">•</span>
            <span class="text-blue-400">ASTRO 5 SSG</span>
            <span class="hidden sm:inline">•</span>
            <span class="text-slate-400">BUILD: 0x8F4A</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
