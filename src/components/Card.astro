---
interface Props {
  title: string;
  description: string;
  badge?: string;
}

const { title, description, badge = "Feature" } = Astro.props;
---

<div class="glass-card hud-corners p-6 rounded-2xl relative overflow-hidden border border-slate-800 shadow-xl">
  <div class="flex items-center justify-between mb-4">
    <span class="px-2.5 py-1 rounded bg-blue-500/15 text-cyan-300 text-xs font-mono font-bold border border-cyan-500/30 uppercase tracking-wider">
      {badge}
    </span>
  </div>
  <h4 class="font-tech text-lg font-bold text-white mb-2 tracking-tight">{title}</h4>
  <p class="text-slate-400 text-sm leading-relaxed">{description}</p>
</div>
