---
interface Props {
  title: string;
  description: string;
  date: string;
  slug: string;
  readTime?: string;
  category?: string;
}

const { 
  title, 
  description, 
  date, 
  slug, 
  readTime = "5 phút đọc", 
  category = "Bài viết" 
} = Astro.props;

const href = slug.startsWith('/') ? slug : `/philosophy/${slug}`;
---

<a 
  href={href} 
  class="group block glass-card hud-corners glass-card-hover p-6 rounded-2xl relative overflow-hidden"
>
  <!-- Background Ultramarine Cyber Glow -->
  <div class="absolute -top-10 -right-10 w-36 h-36 bg-cyan-500/10 rounded-full blur-2xl group-hover:scale-125 transition-transform duration-500 pointer-events-none"></div>

  <!-- Meta Info Header -->
  <div class="flex items-center gap-2.5 text-xs text-slate-400 mb-3 flex-wrap font-mono">
    <span class="px-2.5 py-0.5 rounded bg-blue-600/20 text-cyan-300 font-bold border border-cyan-400/30 uppercase tracking-wider text-[10px]">
      LOG // {category}
    </span>
    <span class="text-slate-600">•</span>
    <span>[{date}]</span>
    {readTime && (
      <>
        <span class="text-slate-600">•</span>
        <span class="text-slate-400">{readTime}</span>
      </>
    )}
  </div>

  <!-- Article Title -->
  <h3 class="font-tech text-xl font-bold text-white group-hover:text-cyan-300 transition-colors mb-3 leading-snug tracking-tight">
    {title}
  </h3>

  <!-- Excerpt / Description -->
  <p class="text-slate-400 text-sm leading-relaxed mb-5 line-clamp-2">
    {description}
  </p>

  <!-- Read More Footer -->
  <div class="flex items-center text-xs font-mono font-bold text-cyan-400 group-hover:text-cyan-300 gap-1.5 transition-all">
    <span>READ_PROTOCOL</span>
    <span class="group-hover:translate-x-1.5 transition-transform duration-300 text-sm">→</span>
  </div>
</a>
