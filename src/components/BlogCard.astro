---
interface Props {
  title: string;
  description: string;
  date: string;
  slug: string;
  readTime?: string;
  category?: string;
}

const { 
  title, 
  description, 
  date, 
  slug, 
  readTime = "5 phút đọc", 
  category = "Bài viết" 
} = Astro.props;

const href = slug.startsWith('/') ? slug : `/philosophy/${slug}`;
---

<a 
  href={href} 
  class="group block glass-card hud-corners glass-card-hover p-7 sm:p-9 rounded-3xl relative overflow-hidden"
>
  <!-- Background Ultramarine Cyber Glow -->
  <div class="absolute -top-12 -right-12 w-44 h-44 bg-cyan-500/15 rounded-full blur-3xl group-hover:scale-125 transition-transform duration-500 pointer-events-none"></div>

  <!-- Meta Info Header -->
  <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-400 mb-4 flex-wrap font-mono">
    <span class="px-3 py-1 rounded-md bg-blue-600/25 text-cyan-300 font-bold border border-cyan-400/40 uppercase tracking-wider text-xs">
      LOG // {category}
    </span>
    <span class="text-slate-600">•</span>
    <span>[{date}]</span>
    {readTime && (
      <>
        <span class="text-slate-600">•</span>
        <span class="text-slate-300">{readTime}</span>
      </>
    )}
  </div>

  <!-- Article Title -->
  <h3 class="font-tech text-2xl sm:text-3xl font-bold text-white group-hover:text-cyan-300 transition-colors mb-4 leading-snug tracking-tight">
    {title}
  </h3>

  <!-- Excerpt / Description -->
  <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-6 line-clamp-2">
    {description}
  </p>

  <!-- Read More Footer -->
  <div class="flex items-center text-xs sm:text-sm font-mono font-bold text-cyan-400 group-hover:text-cyan-300 gap-2 transition-all">
    <span>READ_PROTOCOL</span>
    <span class="group-hover:translate-x-2 transition-transform duration-300 text-base">→</span>
  </div>
</a>
