---
interface Props {
  title: string;
  description: string;
  date?: string;
  slug: string;
  tags?: string[];
  status?: string;
}

const { 
  title, 
  description, 
  date, 
  slug, 
  tags = [], 
  status = "Đang phát triển" 
} = Astro.props;

const href = slug.startsWith('/') ? slug : `/apps/${slug}`;

const statusStyles: Record<string, string> = {
  'Đang phát triển': 'bg-blue-500/20 text-cyan-300 border-blue-400/50',
  'Ý tưởng': 'bg-sky-500/20 text-sky-200 border-sky-400/50',
  'Thử nghiệm (Beta)': 'bg-cyan-500/20 text-cyan-200 border-cyan-400/60 shadow-md shadow-cyan-500/20',
  'Hoàn thành': 'bg-blue-600/25 text-blue-200 border-blue-400/50',
};

const statusClass = statusStyles[status] || 'bg-blue-500/20 text-cyan-300 border-blue-400/50';
---

<a 
  href={href} 
  class="group block glass-card hud-corners glass-card-hover p-7 sm:p-9 rounded-3xl relative overflow-hidden flex flex-col justify-between"
>
  <!-- Background Ambient Glow Accent -->
  <div class="absolute -top-16 -right-16 w-48 h-48 bg-gradient-to-br from-blue-600/25 via-cyan-500/15 to-transparent rounded-full blur-3xl group-hover:scale-125 transition-transform duration-500 pointer-events-none"></div>

  <div>
    <div class="flex items-center justify-between gap-3 mb-5 font-mono">
      {status && (
        <span class={`text-xs font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-lg border backdrop-blur-md ${statusClass}`}>
          ● {status}
        </span>
      )}
      {date && (
        <span class="text-xs sm:text-sm text-slate-400 font-medium">
          [{date}]
        </span>
      )}
    </div>

    <h3 class="font-tech text-2xl sm:text-3xl font-bold text-white group-hover:text-cyan-300 transition-colors flex items-center justify-between gap-3 mb-4 tracking-tight leading-snug">
      <span>{title}</span>
      <span class="w-10 h-10 rounded-xl bg-black border border-slate-800 flex items-center justify-center text-slate-400 group-hover:text-cyan-300 group-hover:border-cyan-400/60 group-hover:bg-blue-950/80 group-hover:translate-x-1 transition-all text-sm font-mono shrink-0">
        ↗
      </span>
    </h3>

    <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8 line-clamp-3">
      {description}
    </p>
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 pt-5 border-t border-slate-800/80 mt-auto font-mono">
      {tags.map((tag, idx) => (
        <span class="text-xs text-slate-200 px-3 py-1.5 rounded-lg bg-black/90 border border-slate-800 group-hover:border-blue-800 transition-colors font-medium">
          #0x0{idx + 1}_{tag}
        </span>
      ))}
    </div>
  )}
</a>
