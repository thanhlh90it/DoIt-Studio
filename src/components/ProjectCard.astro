---
interface Props {
  title: string;
  description: string;
  date?: string;
  slug: string;
  tags?: string[];
  status?: string;
}

const { 
  title, 
  description, 
  date, 
  slug, 
  tags = [], 
  status = "Đang phát triển" 
} = Astro.props;

const href = slug.startsWith('/') ? slug : `/apps/${slug}`;

const statusStyles: Record<string, string> = {
  'Đang phát triển': 'bg-blue-500/15 text-cyan-300 border-blue-500/40',
  'Ý tưởng': 'bg-sky-500/15 text-sky-300 border-sky-500/40',
  'Thử nghiệm (Beta)': 'bg-cyan-500/15 text-cyan-200 border-cyan-400/50 shadow-sm shadow-cyan-500/30',
  'Hoàn thành': 'bg-blue-600/20 text-blue-200 border-blue-400/40',
};

const statusClass = statusStyles[status] || 'bg-blue-500/15 text-cyan-300 border-blue-500/40';
---

<a 
  href={href} 
  class="group block glass-card hud-corners glass-card-hover p-6 rounded-2xl relative overflow-hidden flex flex-col justify-between"
>
  <!-- Background Ambient Glow Accent -->
  <div class="absolute -top-12 -right-12 w-40 h-40 bg-gradient-to-br from-blue-600/20 via-cyan-500/10 to-transparent rounded-full blur-2xl group-hover:scale-125 transition-transform duration-500 pointer-events-none"></div>

  <div>
    <div class="flex items-center justify-between gap-3 mb-4 font-mono">
      {status && (
        <span class={`text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-md border backdrop-blur-md ${statusClass}`}>
          ● {status}
        </span>
      )}
      {date && (
        <span class="text-[11px] text-slate-400">
          [{date}]
        </span>
      )}
    </div>

    <h3 class="font-tech text-xl font-bold text-white group-hover:text-cyan-300 transition-colors flex items-center justify-between gap-2 mb-3 tracking-tight">
      <span>{title}</span>
      <span class="w-8 h-8 rounded-lg bg-black border border-slate-800 flex items-center justify-center text-slate-400 group-hover:text-cyan-300 group-hover:border-cyan-400/50 group-hover:bg-blue-950/60 group-hover:translate-x-0.5 transition-all text-xs font-mono shrink-0">
        ↗
      </span>
    </h3>

    <p class="text-slate-400 text-sm leading-relaxed mb-6 line-clamp-3">
      {description}
    </p>
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-800/80 mt-auto font-mono">
      {tags.map((tag, idx) => (
        <span class="text-[10px] text-slate-300 px-2.5 py-1 rounded-md bg-black/90 border border-slate-800 group-hover:border-blue-900/80 transition-colors">
          #0x0{idx + 1}_{tag}
        </span>
      ))}
    </div>
  )}
</a>
