---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredApps = [
  {
    slug: 'dotask-minimalist',
    title: 'DoTask Minimalist',
    description: 'Ứng dụng quản lý công việc theo phương pháp Kanban kết hợp Pomodoro tối giản, giúp tập trung cao độ.',
    date: '14/08/2026',
    status: 'Đang phát triển',
    tags: ['Astro', 'Tailwind', 'TypeScript']
  },
  {
    slug: 'mindspace-notes',
    title: 'MindSpace Notes',
    description: 'Công cụ ghi chú liên kết dạng mạng lưới (Bi-directional linking) dành cho việc quản lý tri thức cá nhân (PKM).',
    date: '10/08/2026',
    status: 'Ý tưởng',
    tags: ['MDX', 'React', 'LocalFirst']
  }
];
---

<MainLayout title="DoIT-Studio | Futuristic Digital Workspace & Cybernetic Lab" description="Biến ý tưởng thành sản phẩm số tối giản, hiệu quả và chia sẻ triết lý phát triển phần mềm tương lai.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-16 sm:pt-20 sm:pb-24 md:pt-28 md:pb-28 border-b border-blue-900/40 w-full">
    <!-- Ultramarine Ambient Laser Glow Orbs -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90vw] max-w-[700px] h-[280px] sm:h-[360px] bg-gradient-to-tr from-blue-600/40 via-cyan-500/20 to-transparent blur-[120px] rounded-full pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <!-- Terminal Prompt Line -->
      <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 rounded-xl glass-card hud-corners border border-cyan-500/40 text-[10px] sm:text-xs font-mono text-cyan-300 mb-6 sm:mb-8 shadow-xl shadow-blue-950/60 max-w-[95vw] truncate">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping shrink-0"></span>
        <span class="font-bold tracking-wider truncate">&gt; DOIT_STUDIO_OS v2.4 // STATUS: ACTIVE [200 OK]</span>
      </div>

      <h1 class="font-tech text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-white leading-tight sm:leading-tight mb-4 sm:mb-6">
        Biến Ý Tưởng Thành <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-cyan-300 via-blue-400 to-cyan-400 bg-clip-text text-transparent drop-shadow-sm">
          Sản Phẩm Số Tối Giản
        </span>
      </h1>

      <p class="text-slate-400 text-sm sm:text-base md:text-lg max-w-2xl mx-auto mb-8 sm:mb-10 leading-relaxed">
        DoIT-Studio là phòng thí nghiệm số cá nhân — nơi nghiên cứu, thiết kế ứng dụng tinh gọn và đúc kết các phương pháp luận phát triển phần mềm bền vững.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 font-mono w-full max-w-sm mx-auto sm:max-w-none">
        <a href="/apps" class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-600 text-white text-xs sm:text-sm font-bold shadow-xl shadow-blue-600/40 hover:scale-[1.02] border border-cyan-400/40 transition-all duration-300 text-center">
          EXECUTE_APPS ⚡
        </a>
        <a href="/philosophy" class="w-full sm:w-auto px-7 py-3.5 rounded-xl glass-card hud-corners text-cyan-300 text-xs sm:text-sm font-bold border border-slate-700 hover:bg-blue-950/70 hover:border-cyan-400 transition-all duration-300 text-center">
          VIEW_PROTOCOLS 📡
        </a>
      </div>
    </div>
  </section>

  <!-- Studio System Telemetry Dashboard Bar -->
  <section class="py-8 sm:py-10 border-b border-blue-900/40 bg-black/80 font-mono w-full">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6 text-center">
      <div class="p-3.5 sm:p-4 rounded-xl glass-card hud-corners border border-blue-900/60">
        <div class="text-xl sm:text-3xl font-black font-mono text-cyan-400 mb-0.5 sm:mb-1">04+</div>
        <div class="text-[9px] sm:text-[11px] text-slate-400 uppercase tracking-widest font-semibold">// APPS & IDEAS</div>
      </div>
      <div class="p-3.5 sm:p-4 rounded-xl glass-card hud-corners border border-blue-900/60">
        <div class="text-xl sm:text-3xl font-black font-mono text-blue-400 mb-0.5 sm:mb-1">03+</div>
        <div class="text-[9px] sm:text-[11px] text-slate-400 uppercase tracking-widest font-semibold">// PHILOSOPHY LOGS</div>
      </div>
      <div class="p-3.5 sm:p-4 rounded-xl glass-card hud-corners border border-blue-900/60">
        <div class="text-xl sm:text-3xl font-black font-mono text-cyan-300 mb-0.5 sm:mb-1">100%</div>
        <div class="text-[9px] sm:text-[11px] text-slate-400 uppercase tracking-widest font-semibold">// ZERO_BLOAT UI</div>
      </div>
      <div class="p-3.5 sm:p-4 rounded-xl glass-card hud-corners border border-blue-900/60">
        <div class="text-xl sm:text-3xl font-black font-mono text-sky-400 mb-0.5 sm:mb-1">ASTRO 5</div>
        <div class="text-[9px] sm:text-[11px] text-slate-400 uppercase tracking-widest font-semibold">// SSG ENGINE</div>
      </div>
    </div>
  </section>

  <!-- Core Pillars -->
  <section class="py-14 sm:py-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="text-center mb-10 sm:mb-14">
      <span class="text-[10px] sm:text-xs font-mono font-bold text-cyan-400 tracking-widest uppercase px-3 sm:px-3.5 py-1 rounded-md bg-blue-600/20 border border-cyan-400/30">
        // CORE ARCHITECTURE MODULES
      </span>
      <h2 class="font-tech text-2xl sm:text-4xl font-extrabold text-white mt-3 sm:mt-4 tracking-tight">
        Ba Trụ Cột Hệ Thống Tại DoIT-Studio
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <!-- Pillar 1 -->
      <div class="glass-card hud-corners glass-card-hover p-6 sm:p-8 rounded-2xl relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-blue-600/20 border border-cyan-400/40 text-cyan-300 flex items-center justify-center mb-5 sm:mb-6 text-xl sm:text-2xl shadow-lg shadow-cyan-500/20">
            💡
          </div>
          <h3 class="font-tech text-lg sm:text-xl font-bold text-white mb-2 sm:mb-3">Ý Tưởng Ứng Dụng</h3>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-6">
            Nơi thử nghiệm và hiện thực hóa các ý tưởng phần mềm phục vụ công việc hàng ngày với giao diện tinh gọn, mượt mà.
          </p>
        </div>
        <a href="/apps" class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300">
          <span>LOAD_MODULE_APPS</span>
          <span class="text-base">→</span>
        </a>
      </div>

      <!-- Pillar 2 -->
      <div class="glass-card hud-corners glass-card-hover p-6 sm:p-8 rounded-2xl relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-cyan-600/20 border border-cyan-400/40 text-cyan-200 flex items-center justify-center mb-5 sm:mb-6 text-xl sm:text-2xl shadow-lg shadow-cyan-500/20">
            🧩
          </div>
          <h3 class="font-tech text-lg sm:text-xl font-bold text-white mb-2 sm:mb-3">Triết Lý & Tư Duy</h3>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-6">
            Những đúc kết cá nhân về lối sống tối giản, hiệu suất công việc và nguyên tắc sáng tạo phần mềm bền vững.
          </p>
        </div>
        <a href="/philosophy" class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300">
          <span>READ_PROTOCOLS</span>
          <span class="text-base">→</span>
        </a>
      </div>

      <!-- Pillar 3 (Span 2 columns on tablet 2-col layout) -->
      <div class="glass-card hud-corners glass-card-hover p-6 sm:p-8 rounded-2xl relative overflow-hidden flex flex-col justify-between sm:col-span-2 lg:col-span-1">
        <div>
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-blue-700/20 border border-blue-400/40 text-blue-300 flex items-center justify-center mb-5 sm:mb-6 text-xl sm:text-2xl shadow-lg shadow-blue-600/20">
            👤
          </div>
          <h3 class="font-tech text-lg sm:text-xl font-bold text-white mb-2 sm:mb-3">Hồ Sơ Cá Nhân</h3>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-6">
            Thông tin giới thiệu tác giả, kinh nghiệm phát triển phần mềm, bộ kỹ năng chuyên môn và phương thức kết nối.
          </p>
        </div>
        <a href="/profile" class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300">
          <span>ACCESS_PROFILE</span>
          <span class="text-base">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Apps Section Preview -->
  <section class="py-12 sm:py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-blue-900/40 w-full">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 sm:mb-10 gap-3 sm:gap-4">
      <div>
        <span class="text-[10px] sm:text-xs font-mono font-bold text-cyan-400 tracking-widest uppercase">
          // FEATURED_PROJECTS_SHOWCASE
        </span>
        <h2 class="font-tech text-2xl sm:text-3xl font-bold text-white mt-1">Dự Án Nổi Bật</h2>
      </div>
      <a href="/apps" class="text-xs font-mono font-bold text-slate-400 hover:text-cyan-400 transition-colors">
        EXPLORE_ALL_APPS →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      {featuredApps.map((app) => (
        <ProjectCard
          title={app.title}
          description={app.description}
          date={app.date}
          slug={app.slug}
          status={app.status}
          tags={app.tags}
        />
      ))}
    </div>
  </section>
</MainLayout>
