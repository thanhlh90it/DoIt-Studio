---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredApps = [
  {
    slug: '/nhata',
    title: 'NhàTa',
    description: 'Không gian số ấm áp, riêng tư cho tổ ấm gia đình: Lịch biểu chung & TKB, phân chia việc nhà tích sao đổi quà cho con, album kỷ niệm và quản lý chi tiêu.',
    date: '24/08/2026',
    status: 'Thử nghiệm (Beta)',
    tags: ['React Native', 'Expo', 'Firebase', 'Family']
  },
  {
    slug: '/apps/securevault',
    title: 'SecureVault',
    description: 'Két sắt cá nhân bảo mật cao trên thiết bị di động — ẩn và bảo vệ ảnh, video riêng tư với Face ID, Blur Shield, chống chụp màn hình. 100% cục bộ, không máy chủ.',
    date: '19/08/2026',
    status: 'Thử nghiệm (Beta)',
    tags: ['React Native', 'Expo', 'Privacy', 'iOS', 'Android']
  },
  {
    slug: '/noduletrack',
    title: 'NoduleTrack',
    description: 'Ứng dụng di động y tế cá nhân chuyên biệt hỗ trợ số hóa hồ sơ siêu âm, theo dõi tốc độ tăng trưởng của nang, nhân, hạch và nhắc lịch tái khám chuẩn TI-RADS/BI-RADS.',
    date: '18/08/2026',
    status: 'Đã phát hành (Google Play)',
    tags: ['HealthTech', 'TI-RADS', 'Google Play', 'Mobile']
  },
  {
    slug: 'dotask-minimalist',
    title: 'DoTask Minimalist',
    description: 'Ứng dụng quản trị công việc theo phương pháp Kanban kết hợp Pomodoro tối giản, giúp tập trung cao độ và tối ưu hiệu suất làm việc hàng ngày.',
    date: '14/08/2026',
    status: 'Đang phát triển',
    tags: ['Astro', 'Tailwind', 'TypeScript', 'Focus']
  }
];

const pillars = [
  {
    code: '01',
    title: 'Product Engineering',
    subTitle: 'Từ Ý Tưởng Đến Sản Phẩm Thật',
    description: 'Nghiên cứu thị trường, thiết kế UX/UI, xây dựng MVP và đưa ứng dụng lên App Store, Google Play & Web Cloud với quy trình tinh gọn, kiểm thử an toàn.',
    tags: ['Astro 5', 'React Native', 'TypeScript', 'Local-First'],
    linkText: 'KHÁM PHÁ SẢN PHẨM',
    href: '/apps',
    icon: 'code'
  },
  {
    code: '02',
    title: 'IT & AI Coaching',
    subTitle: 'Huấn Luyện Thực Chiến 1-on-1',
    description: 'Đào tạo kỹ sư phần mềm & nhà sáng lập làm chủ AI-assisted coding (Cursor, Claude, Gemini, AGY), tư duy kiến trúc hệ thống và nhân bản năng suất thực tế.',
    tags: ['AI Coding', 'Agentic Workflows', 'Clean Code', '1-on-1'],
    linkText: 'ĐĂNG KÝ COACHING',
    href: '/profile',
    icon: 'cpu'
  },
  {
    code: '03',
    title: 'Outsourcing & Chuyển Đổi Số',
    subTitle: 'Giải Pháp May Đo Doanh Nghiệp',
    description: 'Tư vấn kiến trúc công nghệ, phát triển phần mềm theo đơn đặt hàng và tự động hóa quy trình nghiệp vụ nội bộ cho doanh nghiệp SME với chi phí tối ưu.',
    tags: ['Custom Web/App', 'Process Automation', 'Cloud Security'],
    linkText: 'NHẬN TƯ VẤN DỰ ÁN',
    href: '/profile',
    icon: 'cloud'
  },
  {
    code: '04',
    title: 'Open Knowledge & Triết Lý',
    subTitle: 'Tri Thức Mở & Tư Duy Kỹ Sư',
    description: 'Chia sẻ các bài học kiến trúc hệ thống, triết lý sống tối giản (Minimalism), quản trị năng lượng cá nhân và đóng góp các bộ công cụ mã nguồn mở.',
    tags: ['Tech Philosophy', 'Architecture Logs', 'Open Source'],
    linkText: 'ĐỌC BÀI VIẾT KỸ THUẬT',
    href: '/philosophy',
    icon: 'book'
  }
];

const engineeringValues = [
  {
    title: 'Thực Chiến (Pragmatic Execution)',
    desc: 'Ưu tiên kết quả vận hành thực tế. Tập trung "Ship to Production" — Nói được, Làm được, tạo ra giá trị hữu hình đo lường được.',
    badge: 'ACTION_FIRST'
  },
  {
    title: 'Kỹ Nghệ Tinh Gọn (Zero-Bloat)',
    desc: 'Kiến trúc bền vững, mã nguồn sạch, bảo mật cao và trải nghiệm người dùng mượt mà không chi tiết thừa hay mã nguồn rác.',
    badge: 'CLEAN_CORE'
  },
  {
    title: 'Đột Phá Cùng AI (AI-Empowered)',
    desc: 'Lấy AI làm đòn bẩy khuếch đại năng suất, ứng dụng sâu AI Agents và quy trình tự động hóa vào mọi khâu phát triển.',
    badge: 'AI_AUGMENTED'
  },
  {
    title: 'Tri Thức Cởi Mở (Open Sharing)',
    desc: 'Đúc kết bài học từ thực tế sản xuất và cởi mở chia sẻ tri thức để nâng tầm năng lực cho cộng đồng kỹ sư thế hệ mới.',
    badge: 'GIVE_BACK'
  }
];
---

<MainLayout 
  title="DoIT-Studio | Cybernetic Product Venture & Tech Mentorship Lab" 
  description="Hiện thực hoá ý tưởng số — Đột phá cùng IT & Trí tuệ nhân tạo. Solo Tech Venture Studio, Coaching IT & AI thực chiến và Chuyển đổi số tinh gọn."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 sm:pt-20 sm:pb-28 md:pt-28 md:pb-36 border-b border-blue-900/40 w-full">
    <!-- Ultramarine & Cyan Ambient Laser Glow Orbs -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90vw] max-w-[900px] h-[340px] sm:h-[460px] bg-gradient-to-tr from-blue-600/40 via-cyan-500/20 to-transparent blur-[140px] rounded-full pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <!-- Live Telemetry Status Badge -->
      <div class="inline-flex items-center gap-2.5 px-4.5 py-2 rounded-xl glass-card hud-corners border border-cyan-500/40 text-xs sm:text-sm font-mono text-cyan-300 mb-8 sm:mb-10 shadow-xl shadow-blue-950/70 max-w-[95vw] truncate">
        <span class="relative flex h-2.5 w-2.5 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyan-400"></span>
        </span>
        <span class="font-bold tracking-wider truncate">&gt; DOIT_STUDIO_OS // SYS.STATUS: OPERATIONAL [200 OK]</span>
      </div>

      <!-- Main Headline with Cyber Gradient -->
      <h1 class="font-tech text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-white leading-none sm:leading-tight mb-6 sm:mb-8">
        Hiện Thực Hóa Ý Tưởng Số <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-cyan-300 via-blue-400 to-cyan-400 bg-clip-text text-transparent drop-shadow-sm">
          Đột Phá Cùng IT &amp; AI
        </span>
      </h1>

      <!-- Brand Mission Subtitle -->
      <p class="text-slate-300 text-base sm:text-xl md:text-2xl max-w-3xl mx-auto mb-10 sm:mb-12 leading-relaxed font-['Plus_Jakarta_Sans',sans-serif]">
        <strong class="text-white font-semibold">DoIT-Studio</strong> là Solo Venture Studio &amp; Tech Mentorship Lab — nơi biến các ý tưởng công nghệ phức tạp thành sản phẩm số tinh gọn, huấn luyện kỹ sư làm chủ AI và đồng hành chuyển đổi số thực chiến.
      </p>

      <!-- Dual Call To Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 font-mono w-full max-w-md mx-auto sm:max-w-none">
        <a 
          href="/apps" 
          class="w-full sm:w-auto px-9 py-4 rounded-2xl bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-600 text-white text-sm sm:text-base font-bold shadow-xl shadow-blue-600/40 hover:scale-[1.03] border border-cyan-400/40 transition-all duration-300 text-center flex items-center justify-center gap-2 group cursor-pointer"
        >
          <span>KHÁM PHÁ SẢN PHẨM</span>
          <span class="group-hover:translate-x-1 transition-transform">⚡</span>
        </a>
        <a 
          href="/profile" 
          class="w-full sm:w-auto px-9 py-4 rounded-2xl glass-card hud-corners text-cyan-300 text-sm sm:text-base font-bold border border-slate-700 hover:bg-blue-950/80 hover:border-cyan-400 transition-all duration-300 text-center flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>KẾT NỐI &amp; COACHING</span>
          <span>📡</span>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 mt-10 sm:mt-12 text-xs sm:text-sm font-mono text-slate-400">
        <span class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-black/60 border border-slate-800">
          <span class="text-cyan-400">✓</span> 100% Zero-Bloat
        </span>
        <span class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-black/60 border border-slate-800">
          <span class="text-blue-400">⚡</span> AI-Augmented
        </span>
        <span class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-black/60 border border-slate-800">
          <span class="text-emerald-400">🔒</span> Local-First Privacy
        </span>
      </div>
    </div>
  </section>

  <!-- Studio Telemetry Dashboard Bar -->
  <section class="py-10 sm:py-12 border-b border-blue-900/40 bg-black/85 font-mono w-full">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 text-center">
      <div class="p-5 sm:p-6 rounded-2xl glass-card hud-corners border border-blue-900/60 hover:border-cyan-500/40 transition-colors">
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black font-mono text-cyan-400 mb-1">04</div>
        <div class="text-xs sm:text-sm text-slate-300 uppercase tracking-widest font-semibold">// CORE PILLARS</div>
      </div>
      <div class="p-5 sm:p-6 rounded-2xl glass-card hud-corners border border-blue-900/60 hover:border-cyan-500/40 transition-colors">
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black font-mono text-blue-400 mb-1">03+</div>
        <div class="text-xs sm:text-sm text-slate-300 uppercase tracking-widest font-semibold">// LIVE PRODUCTS</div>
      </div>
      <div class="p-5 sm:p-6 rounded-2xl glass-card hud-corners border border-blue-900/60 hover:border-cyan-500/40 transition-colors">
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black font-mono text-emerald-400 mb-1">100%</div>
        <div class="text-xs sm:text-sm text-slate-300 uppercase tracking-widest font-semibold">// ZERO_BLOAT CODE</div>
      </div>
      <div class="p-5 sm:p-6 rounded-2xl glass-card hud-corners border border-blue-900/60 hover:border-cyan-500/40 transition-colors">
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black font-mono text-sky-400 mb-1">AI-1st</div>
        <div class="text-xs sm:text-sm text-slate-300 uppercase tracking-widest font-semibold">// DEV WORKFLOW</div>
      </div>
    </div>
  </section>

  <!-- Bento Grid: 4 Core Business Pillars -->
  <section class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="text-center mb-12 sm:mb-16">
      <span class="text-xs sm:text-sm font-mono font-bold text-cyan-400 tracking-widest uppercase px-4 py-1.5 rounded-lg bg-blue-600/20 border border-cyan-400/35">
        // SYSTEM_CAPABILITIES_MATRIX
      </span>
      <h2 class="font-tech text-3xl sm:text-5xl font-extrabold text-white mt-4 tracking-tight">
        4 Trụ Cột Hoạt Động Cốt Lõi
      </h2>
      <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto mt-3">
        Mô hình vận hành khép kín kết hợp giữa nghiên cứu sản phẩm độc lập, huấn luyện kỹ thuật thực chiến và giải pháp chuyển đổi số.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {pillars.map((pillar) => (
        <div class="glass-card hud-corners glass-card-hover p-8 sm:p-10 rounded-3xl relative overflow-hidden flex flex-col justify-between border border-slate-800 hover:border-cyan-400/50">
          <div>
            <div class="flex items-center justify-between gap-4 mb-6">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-600/20 to-cyan-500/20 border border-cyan-400/45 text-cyan-300 flex items-center justify-center shadow-lg shadow-cyan-500/20">
                {pillar.icon === 'code' && (
                  <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                )}
                {pillar.icon === 'cpu' && (
                  <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                  </svg>
                )}
                {pillar.icon === 'cloud' && (
                  <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
                  </svg>
                )}
                {pillar.icon === 'book' && (
                  <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                )}
              </div>
              <span class="text-xs font-mono font-bold text-cyan-400 px-3 py-1 rounded-md bg-blue-950/80 border border-blue-800">
                MODULE // {pillar.code}
              </span>
            </div>

            <h3 class="font-tech text-2xl sm:text-3xl font-bold text-white mb-2">{pillar.title}</h3>
            <p class="text-cyan-400 font-mono text-xs sm:text-sm font-semibold mb-4">{pillar.subTitle}</p>
            <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-6 font-['Plus_Jakarta_Sans',sans-serif]">
              {pillar.description}
            </p>

            <div class="flex flex-wrap gap-2 mb-8 font-mono">
              {pillar.tags.map((tag) => (
                <span class="text-xs text-slate-300 px-3 py-1 rounded-lg bg-black border border-slate-800">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <a 
            href={pillar.href} 
            class="inline-flex items-center gap-2 text-xs sm:text-sm font-mono font-bold text-cyan-300 hover:text-white group pt-4 border-t border-slate-800/80 cursor-pointer"
          >
            <span>{pillar.linkText}</span>
            <span class="text-base group-hover:translate-x-1.5 transition-transform">→</span>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Apps Section Preview -->
  <section class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-blue-900/40 w-full">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 sm:mb-14 gap-4">
      <div>
        <span class="text-xs sm:text-sm font-mono font-bold text-cyan-400 tracking-widest uppercase">
          // FEATURED_PROJECTS_SHOWCASE
        </span>
        <h2 class="font-tech text-3xl sm:text-4xl lg:text-5xl font-bold text-white mt-2">
          Sản Phẩm &amp; Dự Án Thực Chiến
        </h2>
      </div>
      <a 
        href="/apps" 
        class="text-xs sm:text-sm font-mono font-bold text-cyan-400 hover:text-white flex items-center gap-1.5 transition-colors cursor-pointer"
      >
        <span>XEM TOÀN BỘ SẢN PHẨM</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {featuredApps.map((app) => (
        <ProjectCard
          title={app.title}
          description={app.description}
          date={app.date}
          slug={app.slug}
          status={app.status}
          tags={app.tags}
        />
      ))}
    </div>
  </section>

  <!-- Engineering Values Section -->
  <section class="py-16 sm:py-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-blue-900/40 w-full">
    <div class="text-center mb-12 sm:mb-16">
      <span class="text-xs sm:text-sm font-mono font-bold text-cyan-400 tracking-widest uppercase px-4 py-1.5 rounded-lg bg-blue-600/20 border border-cyan-400/35">
        // CRAFTSMANSHIP_PRINCIPLES
      </span>
      <h2 class="font-tech text-3xl sm:text-4xl lg:text-5xl font-bold text-white mt-4">
        Triết Lý Kỹ Nghệ Tại DoIT-Studio
      </h2>
      <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto mt-3">
        Những nguyên tắc bất biến định hình chất lượng trong mọi sản phẩm phần mềm và chương trình đào tạo.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {engineeringValues.map((val) => (
        <div class="glass-card hud-corners p-7 rounded-2xl border border-slate-800 hover:border-cyan-400/40 transition-colors flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-mono font-bold text-cyan-300 px-2.5 py-1 rounded bg-blue-950 border border-blue-800 uppercase tracking-wider inline-block mb-4">
              {val.badge}
            </span>
            <h3 class="font-tech text-lg sm:text-xl font-bold text-white mb-3">{val.title}</h3>
            <p class="text-slate-300 text-sm leading-relaxed font-['Plus_Jakarta_Sans',sans-serif]">
              {val.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Climax Call to Action Section -->
  <section class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-blue-900/40 w-full">
    <div class="glass-card hud-corners p-8 sm:p-14 rounded-3xl text-center relative overflow-hidden border border-blue-500/40 shadow-2xl shadow-blue-950/90">
      <!-- Background Glow Light -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto">
        <span class="text-xs sm:text-sm font-mono font-bold text-cyan-300 uppercase tracking-widest px-4 py-1.5 rounded-lg bg-blue-600/30 border border-cyan-400/40">
          // INITIATE_COLLABORATION
        </span>

        <h2 class="font-tech text-3xl sm:text-5xl font-black text-white mt-6 mb-6 tracking-tight">
          Sẵn Sàng Hiện Thực Hóa <br class="hidden sm:inline" />
          Ý Tưởng Công Nghệ Của Bạn?
        </h2>

        <p class="text-slate-300 text-base sm:text-xl leading-relaxed mb-10 font-['Plus_Jakarta_Sans',sans-serif]">
          Cho dù bạn đang tìm kiếm đối tác phát triển sản phẩm, cần tư vấn chuyển đổi số doanh nghiệp hay muốn nâng tầm kỹ năng lập trình với AI 1-on-1 — DoIT-Studio luôn sẵn sàng đồng hành.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 font-mono">
          <a 
            href="mailto:contact@doitstudio.tech" 
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-600 text-white text-sm sm:text-base font-bold shadow-xl shadow-blue-600/40 hover:scale-[1.02] border border-cyan-400/40 transition-all text-center flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>✉️ GỬI EMAIL TRAO ĐỔI</span>
          </a>
          <a 
            href="/profile" 
            class="w-full sm:w-auto px-8 py-4 rounded-2xl glass-card hud-corners text-slate-200 text-sm sm:text-base font-bold border border-slate-700 hover:bg-slate-900 transition-all text-center flex items-center justify-center gap-2 cursor-pointer"
          >
