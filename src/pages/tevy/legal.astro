  <!-- ================= 7. Interactive Scrollspy & Smooth Navigation Script ================= -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Scrollspy for Sidebar Navigation
      const sections = document.querySelectorAll('.chapter-section, .article-block, .executive-card');
      const sidebarItems = document.querySelectorAll('.sidebar-nav-item');
      const mobilePills = document.querySelectorAll('.pill-link');

      function updateActiveNav() {
        let currentSectionId = '';
        const scrollPosition = window.scrollY + 180;

        sections.forEach(section => {
          const sectionTop = section.offsetTop;
          const sectionHeight = section.offsetHeight;
          if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {
            currentSectionId = section.getAttribute('id');
          }
        });

        if (currentSectionId) {
          // Update Sidebar
          sidebarItems.forEach(item => {
            if (item.getAttribute('data-target') === currentSectionId) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });

          // Update Mobile Pills
          mobilePills.forEach(pill => {
            const href = pill.getAttribute('href');
            if (href === '#' + currentSectionId || (currentSectionId.startsWith('terms') && href === '#terms') || (currentSectionId.startsWith('privacy') && href === '#privacy') || (currentSectionId.startsWith('child-safety') && href === '#child-safety')) {
              pill.classList.add('active');
            } else {
              pill.classList.remove('active');
            }
          });
        }
      }

      window.addEventListener('scroll', updateActiveNav, { passive: true });
      updateActiveNav();

      // 2. Smooth Scrolling with Offset for Anchor Links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          const targetId = this.getAttribute('href').substring(1);
          if (!targetId) return;
          const targetElement = document.getElementById(targetId);
          if (targetElement) {
            e.preventDefault();
            const topOffset = 130;
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - topOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });

            // Update URL hash without jumping
            history.pushState(null, null, '#' + targetId);
          }
        });
      });

      // 3. Handle initial hash if page is loaded with #terms, #privacy, etc.
      if (window.location.hash) {
        setTimeout(() => {
          const initialTarget = document.querySelector(window.location.hash);
          if (initialTarget) {
            const topOffset = 130;
            const elementPosition = initialTarget.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - topOffset;
            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        }, 150);
      }
    });
  </script>
