---
// src/pages/noduletrack/privacy-policy.astro
// NoduleTrack - Privacy Policy Page
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chính Sách Quyền Riêng Tư (Privacy Policy) | NoduleTrack - Ứng dụng theo dõi u, hạch, polyp</title>
  <meta name="description" content="Chính sách quyền riêng tư chính thức của ứng dụng NoduleTrack. Minh bạch cách thu thập, bảo mật và lưu trữ dữ liệu y tế, hình ảnh siêu âm và quyền của người dùng theo chuẩn Google Play Store.">
  <meta name="keywords" content="NoduleTrack Privacy Policy, chính sách quyền riêng tư NoduleTrack, bảo mật dữ liệu y bạ, quyền riêng tư hồ sơ khám bệnh, Google Play Store compliance, bảo mật Firebase y tế">
  <meta name="theme-color" content="#003C90">

  <!-- OpenGraph / Social Meta Tags -->
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://doitstudio.tech/noduletrack/privacy-policy">
  <meta property="og:title" content="Chính Sách Quyền Riêng Tư | NoduleTrack">
  <meta property="og:description" content="Cam kết bảo mật tuyệt đối dữ liệu y tế, hình ảnh siêu âm và quyền riêng tư của bạn và gia đình khi sử dụng NoduleTrack.">
  <meta property="og:image" content="/noduletrack/assets/brand/app-icon.svg">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/noduletrack/assets/brand/logo-mark.svg">
  <link rel="apple-touch-icon" href="/noduletrack/assets/brand/app-icon.svg">

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/noduletrack/styles/brand-tokens.css">
  <link rel="stylesheet" href="/noduletrack/styles/layout.css">
  <link rel="stylesheet" href="/noduletrack/styles/components.css">
  <link rel="stylesheet" href="/noduletrack/styles/animations.css">

  <style>
    /* Dedicated Privacy Policy Clinical Styles */
    :root {
      --privacy-sidebar-width: 290px;
    }

    .privacy-hero {
      background: linear-gradient(180deg, #FFFFFF 0%, #FAF8FF 100%);
      border-bottom: 1px solid var(--nt-color-border);
      padding-top: calc(var(--nt-header-height) + var(--nt-space-10));
      padding-bottom: var(--nt-space-12);
      position: relative;
      overflow: hidden;
    }

    .privacy-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 800px;
      height: 350px;
      background: radial-gradient(circle, rgba(0, 60, 144, 0.05) 0%, rgba(0, 168, 150, 0.03) 50%, transparent 70%);
      pointer-events-none;
      z-index: 0;
    }

    .privacy-hero-container {
      position: relative;
      z-index: 1;
    }

    .breadcrumbs {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--nt-space-2);
      font-size: var(--nt-text-xs);
      font-weight: 500;
      color: var(--nt-color-text-muted);
      margin-bottom: var(--nt-space-4);
    }

    .breadcrumbs a {
      color: var(--nt-color-primary);
      transition: color var(--nt-duration-fast) ease;
    }

    .breadcrumbs a:hover {
      color: var(--nt-color-primary-light);
      text-decoration: underline;
    }

    .meta-pills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--nt-space-3);
      margin-top: var(--nt-space-6);
    }

    .meta-pill {
      display: inline-flex;
      align-items: center;
      gap: var(--nt-space-2);
      padding: var(--nt-space-1) var(--nt-space-3);
      background-color: var(--nt-color-surface);
      border: 1px solid var(--nt-color-border);
      border-radius: var(--nt-radius-full);
      font-size: var(--nt-text-xs);
      color: var(--nt-color-text-secondary);
      box-shadow: var(--nt-shadow-subtle);
    }

    .meta-pill strong {
      color: var(--nt-color-text-primary);
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--nt-color-status-stable);
      display: inline-block;
      box-shadow: 0 0 0 2px var(--nt-color-status-stable-border);
    }

    /* Privacy Layout */
    .privacy-layout {
      display: grid;
      grid-template-columns: var(--privacy-sidebar-width) minmax(0, 1fr);
      gap: var(--nt-space-10);
      align-items: start;
      padding-top: var(--nt-space-10);
      padding-bottom: var(--nt-space-20);
    }

    @media (max-width: 991px) {
      .privacy-layout {
        grid-template-columns: 1fr;
        gap: var(--nt-space-8);
      }
    }

    /* Sticky Sidebar Navigation */
    .privacy-sidebar {
      position: sticky;
      top: calc(var(--nt-header-height) + var(--nt-space-6));
      display: flex;
      flex-direction: column;
      gap: var(--nt-space-6);
    }

    @media (max-width: 991px) {
      .privacy-sidebar {
        position: relative;
        top: 0;
      }
    }

    .toc-card {
      background-color: var(--nt-color-surface);
      border: 1px solid var(--nt-color-border);
      border-radius: var(--nt-radius-lg);
      padding: var(--nt-space-5);
      box-shadow: var(--nt-shadow-sm);
    }

    .toc-title {
      font-size: var(--nt-text-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--nt-color-text-muted);
      margin-bottom: var(--nt-space-4);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .toc-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: var(--nt-space-1);
    }

    .toc-link {
      display: flex;
      align-items: center;
      gap: var(--nt-space-2);
      padding: var(--nt-space-2) var(--nt-space-3);
      border-radius: var(--nt-radius-sm);
      font-size: var(--nt-text-sm);
      font-weight: 500;
      color: var(--nt-color-text-secondary);
      transition: all var(--nt-duration-fast) ease;
      line-height: 1.35;
    }

    .toc-link:hover {
      color: var(--nt-color-primary);
      background-color: var(--nt-color-primary-container);
    }

    .toc-link.active {
      color: var(--nt-color-primary-dark);
      background-color: var(--nt-color-primary-container);
      font-weight: 600;
      border-left: 3px solid var(--nt-color-primary);
    }

    .toc-num {
      font-family: var(--nt-font-mono);
      font-size: 0.75rem;
      color: var(--nt-color-text-muted);
      min-width: 18px;
    }

    .toc-link.active .toc-num {
      color: var(--nt-color-primary);
      font-weight: 700;
    }

    .help-box {
      background: linear-gradient(135deg, var(--nt-color-primary-dark) 0%, var(--nt-color-primary) 100%);
      color: var(--nt-color-text-on-primary);
      border-radius: var(--nt-radius-lg);
      padding: var(--nt-space-5);
      box-shadow: var(--nt-shadow-md);
    }

    .help-box h3 {
      font-size: var(--nt-text-base);
      font-weight: 700;
      margin-bottom: var(--nt-space-2);
      color: #FFFFFF;
    }

    .help-box p {
      font-size: var(--nt-text-xs);
      line-height: var(--nt-lh-sm);
      color: #D9E2FF;
      margin-bottom: var(--nt-space-4);
    }

    .help-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--nt-space-2);
      width: 100%;
      padding: var(--nt-space-2) var(--nt-space-4);
      background-color: var(--nt-color-secondary);
      color: #002B66;
      font-weight: 700;
      font-size: var(--nt-text-xs);
      border-radius: var(--nt-radius-sm);
      transition: all var(--nt-duration-fast) ease;
    }

    .help-btn:hover {
      background-color: var(--nt-color-secondary-light);
      transform: translateY(-1px);
    }

    /* Key Summary Highlights */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--nt-space-4);
      margin-bottom: var(--nt-space-10);
    }

    @media (max-width: 640px) {
      .summary-grid {
        grid-template-columns: 1fr;
      }
    }

    .summary-card {
      background-color: var(--nt-color-surface);
      border: 1px solid var(--nt-color-border);
      border-radius: var(--nt-radius-lg);
      padding: var(--nt-space-5);
      box-shadow: var(--nt-shadow-sm);
      display: flex;
      gap: var(--nt-space-4);
      transition: transform var(--nt-duration-fast) ease, box-shadow var(--nt-duration-fast) ease;
    }

    .summary-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--nt-shadow-md);
      border-color: var(--nt-color-primary-light);
    }

    .summary-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: var(--nt-radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .summary-icon-wrap.primary {
      background-color: var(--nt-color-primary-container);
      color: var(--nt-color-primary-dark);
    }

    .summary-icon-wrap.secondary {
      background-color: var(--nt-color-secondary-container);
      color: var(--nt-color-secondary-dark);
    }

    .summary-icon-wrap.stable {
      background-color: var(--nt-color-status-stable-bg);
      color: var(--nt-color-status-stable);
    }

    .summary-icon-wrap.info {
      background-color: var(--nt-color-status-info-bg);
      color: var(--nt-color-status-info);
    }

    .summary-content h3 {
      font-size: var(--nt-text-sm);
      font-weight: 700;
      color: var(--nt-color-text-primary);
      margin-bottom: var(--nt-space-1);
    }

    .summary-content p {
      font-size: var(--nt-text-xs);
      line-height: var(--nt-lh-sm);
      color: var(--nt-color-text-secondary);
    }

    /* Policy Content Sections */
    .policy-section {
      background-color: var(--nt-color-surface);
      border: 1px solid var(--nt-color-border);
      border-radius: var(--nt-radius-xl);
      padding: var(--nt-space-8);
      margin-bottom: var(--nt-space-8);
      box-shadow: var(--nt-shadow-sm);
      scroll-margin-top: calc(var(--nt-header-height) + var(--nt-space-6));
    }

    @media (max-width: 640px) {
      .policy-section {
        padding: var(--nt-space-5);
      }
    }

    .section-num-tag {
      display: inline-flex;
      align-items: center;
      gap: var(--nt-space-1);
      font-family: var(--nt-font-mono);
      font-size: var(--nt-text-xs);
      font-weight: 700;
      color: var(--nt-color-primary);
      background-color: var(--nt-color-primary-container);
      padding: 2px var(--nt-space-2);
      border-radius: var(--nt-radius-xs);
      margin-bottom: var(--nt-space-2);
      text-transform: uppercase;
    }

    .policy-section-title {
      font-size: var(--nt-text-xl);
      font-weight: 800;
      color: var(--nt-color-primary-dark);
      letter-spacing: -0.01em;
      margin-bottom: var(--nt-space-4);
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--nt-color-border-subtle);
      padding-bottom: var(--nt-space-3);
    }

    .policy-section-intro {
      font-size: var(--nt-text-sm);
      line-height: var(--nt-lh-base);
      color: var(--nt-color-text-secondary);
      margin-bottom: var(--nt-space-6);
    }

    /* Subsection Cards */
    .sub-item-card {
      background-color: var(--nt-color-surface-muted);
      border: 1px solid var(--nt-color-border);
      border-radius: var(--nt-radius-lg);
      padding: var(--nt-space-5);
      margin-bottom: var(--nt-space-4);
    }

    .sub-item-card:last-child {
      margin-bottom: 0;
    }

    .sub-item-header {
      display: flex;
      align-items: center;
      gap: var(--nt-space-3);
      margin-bottom: var(--nt-space-3);
    }

    .sub-item-badge {
      width: 28px;
      height: 28px;
      border-radius: var(--nt-radius-sm);
      background-color: var(--nt-color-primary);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--nt-font-mono);
      font-size: var(--nt-text-xs);
      font-weight: 700;
      flex-shrink: 0;
    }

    .sub-item-title {
      font-size: var(--nt-text-base);
      font-weight: 700;
      color: var(--nt-color-text-primary);
    }

    .sub-item-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: var(--nt-space-2);
      font-size: var(--nt-text-sm);
      color: var(--nt-color-text-secondary);
      line-height: var(--nt-lh-base);
    }

    .sub-item-list li {
      display: flex;
      align-items: flex-start;
      gap: var(--nt-space-2);
    }

    .sub-item-list li svg {
      flex-shrink: 0;
      margin-top: 3px;
    }

    .code-tag {
      font-family: var(--nt-font-mono);
      font-size: 0.8125rem;
      background-color: #EEF2F6;
      color: var(--nt-color-primary-dark);
      padding: 1px 6px;
      border-radius: var(--nt-radius-xs);
      border: 1px solid #D8E2EC;
    }

    /* Permissions Table Grid */
    .perm-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--nt-space-4);
    }

    @media (max-width: 768px) {
      .perm-grid {
        grid-template-columns: 1fr;
      }
    }

    .perm-card {
      border: 1px solid var(--nt-color-border);
      border-radius: var(--nt-radius-md);
      padding: var(--nt-space-4);
      background-color: var(--nt-color-surface);
      display: flex;
      flex-direction: column;
      gap: var(--nt-space-2);
    }

    .perm-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--nt-space-2);
    }

    .perm-name {
      font-size: var(--nt-text-sm);
      font-weight: 700;
      color: var(--nt-color-text-primary);
      display: flex;
      align-items: center;
      gap: var(--nt-space-2);
    }

    .perm-package {
      font-family: var(--nt-font-mono);
      font-size: 0.7rem;
      color: var(--nt-color-primary);
      background-color: var(--nt-color-primary-container);
      padding: 2px 6px;
      border-radius: var(--nt-radius-xs);
    }

    .perm-desc {
      font-size: var(--nt-text-xs);
      line-height: var(--nt-lh-sm);
      color: var(--nt-color-text-secondary);
    }

    /* Callout & Disclaimer Boxes */
    .callout-box {
      border-radius: var(--nt-radius-lg);
      padding: var(--nt-space-5);
      margin-top: var(--nt-space-4);
      display: flex;
      gap: var(--nt-space-4);
      align-items: flex-start;
    }

    .callout-box.warning {
      background-color: var(--nt-color-status-warning-bg);
      border: 1px solid var(--nt-color-status-warning-border);
      color: #78350F;
    }

    .callout-box.danger {
      background-color: var(--nt-color-status-critical-bg);
      border: 1px solid var(--nt-color-status-critical-border);
      color: #7F1D1D;
    }

    .callout-box.info {
      background-color: var(--nt-color-status-info-bg);
      border: 1px solid var(--nt-color-status-info-border);
      color: #1E3A8A;
    }

    .callout-box.success {
      background-color: var(--nt-color-status-stable-bg);
      border: 1px solid var(--nt-color-status-stable-border);
      color: #064E3B;
    }

    .callout-icon {
      flex-shrink: 0;
      margin-top: 2px;
    }

    .callout-content h4 {
      font-size: var(--nt-text-sm);
      font-weight: 700;
      margin-bottom: var(--nt-space-1);
    }

    .callout-content p {
      font-size: var(--nt-text-xs);
      line-height: var(--nt-lh-base);
    }

    /* Security Architecture Features */
    .security-feature-row {
      display: flex;
      align-items: flex-start;
      gap: var(--nt-space-4);
      padding: var(--nt-space-4);
      background-color: var(--nt-color-surface-muted);
      border-radius: var(--nt-radius-md);
      margin-bottom: var(--nt-space-3);
      border: 1px solid var(--nt-color-border);
    }

    .security-feature-row:last-child {
      margin-bottom: 0;
    }

    .sec-icon-circle {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background-color: var(--nt-color-primary-container);
      color: var(--nt-color-primary-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* Contact Card */
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--nt-space-4);
      margin-top: var(--nt-space-4);
    }

    @media (max-width: 768px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
    }

    .contact-card {
      background-color: var(--nt-color-surface-muted);
      border: 1px solid var(--nt-color-border);
      border-radius: var(--nt-radius-lg);
      padding: var(--nt-space-4);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--nt-space-2);
    }

    .contact-card svg {
      color: var(--nt-color-primary);
    }

    .contact-label {
      font-size: var(--nt-text-xs);
      font-weight: 700;
      color: var(--nt-color-text-muted);
      text-transform: uppercase;
    }

    .contact-value {
      font-size: var(--nt-text-sm);
      font-weight: 600;
      color: var(--nt-color-primary-dark);
      word-break: break-all;
    }

    .contact-card a.contact-value:hover {
      color: var(--nt-color-primary-light);
      text-decoration: underline;
    }

    /* Quick Print & Back to Top */
    .doc-actions {
      display: flex;
      align-items: center;
      gap: var(--nt-space-3);
    }

    .btn-action-outline {
      display: inline-flex;
      align-items: center;
      gap: var(--nt-space-2);
      padding: var(--nt-space-2) var(--nt-space-3);
      border: 1px solid var(--nt-color-border);
      border-radius: var(--nt-radius-sm);
      font-size: var(--nt-text-xs);
      font-weight: 600;
      color: var(--nt-color-text-secondary);
      background-color: var(--nt-color-surface);
      transition: all var(--nt-duration-fast) ease;
    }

    .btn-action-outline:hover {
      border-color: var(--nt-color-primary);
      color: var(--nt-color-primary);
      background-color: var(--nt-color-primary-container);
    }

    @media print {
      .header, .footer, .privacy-sidebar, .doc-actions, .help-box, #back-to-top-btn {
        display: none !important;
      }
      .privacy-layout {
        display: block !important;
        padding: 0 !important;
      }
      .policy-section {
        box-shadow: none !important;
        border: 1px solid #CCC !important;
        break-inside: avoid;
        margin-bottom: 24px !important;
      }
      .privacy-hero {
        padding-top: 20px !important;
      }
    }
  </style>
</head>
<body>

  <!-- ========================================================================
       1. Header / Navbar
       ======================================================================== -->
  <header class="header">
    <div class="container header-container">
      <a href="/noduletrack" class="header-logo" aria-label="NoduleTrack Home">
        <img src="/noduletrack/assets/brand/logo-full-horizontal.svg" alt="NoduleTrack Logo" width="168" height="38">
      </a>

      <nav aria-label="Main Navigation">
        <ul class="nav-menu">
          <li><a href="/noduletrack#features" class="nav-link">Tính năng</a></li>
          <li><a href="/noduletrack#pathologies" class="nav-link">4 Dạng Sang thương</a></li>
          <li><a href="/noduletrack#app-tour" class="nav-link">Trải nghiệm App</a></li>
          <li><a href="/noduletrack#simulator" class="nav-link">Mô phỏng Tăng trưởng</a></li>
          <li><a href="/noduletrack#summary" class="nav-link">Báo cáo Bác sĩ</a></li>
          <li><a href="/noduletrack#faq" class="nav-link">Hỏi đáp</a></li>
        </ul>
      </nav>

      <div class="header-actions">
        <a href="/noduletrack" class="btn btn-secondary" style="font-size: var(--nt-text-xs); padding: 8px 16px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 4px;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Trang chủ App
        </a>
        <a href="/noduletrack#download" class="btn btn-primary" style="font-size: var(--nt-text-xs); padding: 8px 16px;">Tải ứng dụng</a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <!-- ========================================================================
         2. Hero Banner & Metadata Strip
         ======================================================================== -->
    <section class="privacy-hero">
      <div class="container privacy-hero-container">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">DoIT-Studio</a>
          <span>/</span>
          <a href="/noduletrack">NoduleTrack</a>
          <span>/</span>
          <span style="color: var(--nt-color-text-primary); font-weight: 600;">Chính sách Quyền riêng tư</span>
