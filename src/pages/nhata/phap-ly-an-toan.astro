  <script is:inline>
    (function () {
      // 1. Sticky Navigation highlight
      const pills = document.querySelectorAll(".legal-nav-pill");
      const sections = document.querySelectorAll(".legal-card-section");

      window.addEventListener("scroll", () => {
        let current = "";
        sections.forEach((section) => {
          const sectionTop = section.offsetTop - 180;
          if (window.pageYOffset >= sectionTop) {
            current = section.getAttribute("id");
          }
        });

        pills.forEach((pill) => {
          pill.classList.remove("active");
          if (pill.getAttribute("href") === `#${current}`) {
            pill.classList.add("active");
          }
        });
      });

      // 2. Copy Template Button
      const copyBtn = document.getElementById("copyTemplateBtn");
      if (copyBtn) {
        copyBtn.addEventListener("click", () => {
          const templateText = `Kính gửi: thanhlh.developer@gmail.com
Tiêu đề: [Yêu cầu xóa tài khoản NhàTa] - [email_cua_ban@gmail.com]

Nội dung:
Xin chào Đội ngũ Hỗ trợ NhàTa,

Tôi là chủ sở hữu của tài khoản ứng dụng NhàTa với thông tin như sau:
- Email đăng ký tài khoản: [Điền email của bạn]
- Tên hiển thị trong ứng dụng: [Điền tên của bạn]
- Tên tổ ấm / Mã gia đình (nếu nhớ): [Điền thông tin]
- Phạm vi yêu cầu: [Xóa tài khoản cá nhân / Xóa hồ sơ của con / Xóa toàn bộ tổ ấm]

Tôi gửi email này yêu cầu Đội ngũ NhàTa tiến hành xóa vĩnh viễn tài khoản và toàn bộ dữ liệu liên quan khỏi hệ thống máy chủ cơ sở dữ liệu.

Tôi hiểu rằng hành động này là không thể khôi phục.
Xin chân thành cảm ơn!`;

          navigator.clipboard
            .writeText(templateText)
            .then(() => {
              const originalText = copyBtn.innerHTML;
              copyBtn.innerHTML = `<span>✓ Đã Sao Chép!</span>`;
              setTimeout(() => {
                copyBtn.innerHTML = originalText;
              }, 2500);
            })
            .catch(() => {
              alert(
                "Không thể tự động sao chép, bạn hãy bôi đen văn bản mẫu để sao chép nhé.",
              );
            });
        });
      }
    })();
  </script>
