  <!-- Interactive Client Scripts -->
  <script is:inline>
    (function () {
      // --- 1. Mobile Menu Toggle ---
      const mobileToggle = document.getElementById("mobileToggle");
      const mobileNavMenu = document.getElementById("mobileNavMenu");

      if (mobileToggle && mobileNavMenu) {
        mobileToggle.addEventListener("click", (e) => {
          e.stopPropagation();
          mobileNavMenu.classList.toggle("open");
        });

        document.addEventListener("click", (e) => {
          if (
            !mobileNavMenu.contains(e.target) &&
            !mobileToggle.contains(e.target)
          ) {
            mobileNavMenu.classList.remove("open");
          }
        });

        mobileNavMenu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            mobileNavMenu.classList.remove("open");
          });
        });
      }

      // --- 2. Interactive Feature Showcase Tabs & Screen Switcher ---
      const showcaseTabs = document.querySelectorAll(".showcase-tab");
      const screenSlides = document.querySelectorAll(".screen-slide");
      let autoRotateInterval = null;
      let currentTabIndex = 0;

      function switchTab(index) {
        showcaseTabs.forEach((tab) => tab.classList.remove("active"));
        screenSlides.forEach((slide) => slide.classList.remove("active"));

        if (showcaseTabs[index] && screenSlides[index]) {
          showcaseTabs[index].classList.add("active");
          screenSlides[index].classList.add("active");
          currentTabIndex = index;
        }
      }

      showcaseTabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          switchTab(index);
          if (autoRotateInterval) clearInterval(autoRotateInterval);
        });
      });

      function startAutoRotate() {
        autoRotateInterval = setInterval(() => {
          let nextIndex = (currentTabIndex + 1) % showcaseTabs.length;
          switchTab(nextIndex);
        }, 6000);
      }
      startAutoRotate();

      // --- 3. Interactive Star Points Simulator Widget ---
      const taskItems = document.querySelectorAll(".sim-task-item");
      const scoreNumber = document.getElementById("simScoreNumber");
      const rewardBox = document.getElementById("simRewardBox");
      const rewardStatus = document.getElementById("simRewardStatus");

      let currentStars = 0;

      function calculateStars() {
        let total = 0;
        taskItems.forEach((item) => {
          if (item.classList.contains("completed")) {
            const stars = parseInt(item.getAttribute("data-stars") || "0", 10);
            total += stars;
          }
        });

        currentStars = total;
        if (scoreNumber) {
          scoreNumber.textContent = currentStars;
        }

        if (rewardBox && rewardStatus) {
          if (currentStars >= 20) {
            rewardBox.classList.add("unlocked");
            rewardStatus.textContent =
              "✨ Đã mở khóa thành công! Bé được chọn quà rồi!";
            triggerConfettiEffect();
          } else {
            rewardBox.classList.remove("unlocked");
            rewardStatus.textContent = `Cần thêm ${20 - currentStars}★ nữa để mở khóa phần thưởng`;
          }
        }
      }

      taskItems.forEach((item) => {
        item.addEventListener("click", () => {
          item.classList.toggle("completed");
          calculateStars();
        });
        item.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            item.classList.toggle("completed");
            calculateStars();
          }
        });
      });

      // Simple Zen Confetti Burst Effect
      function triggerConfettiEffect() {
        const burstContainer = document.createElement("div");
        burstContainer.style.position = "fixed";
        burstContainer.style.top = "0";
        burstContainer.style.left = "0";
        burstContainer.style.width = "100vw";
        burstContainer.style.height = "100vh";
        burstContainer.style.pointerEvents = "none";
        burstContainer.style.zIndex = "9999";
        document.body.appendChild(burstContainer);

        const colors = ["#F97316", "#10B981", "#F59E0B", "#F43F5E", "#0D9488"];
        for (let i = 0; i < 40; i++) {
          const p = document.createElement("div");
          p.style.position = "absolute";
          p.style.width = Math.random() * 8 + 6 + "px";
          p.style.height = Math.random() * 8 + 6 + "px";
          p.style.backgroundColor =
            colors[Math.floor(Math.random() * colors.length)];
          p.style.borderRadius = "50%";
          p.style.left = "50%";
          p.style.top = "50%";
          p.style.opacity = "1";
          p.style.transition = "all 1.2s cubic-bezier(0.1, 1, 0.1, 1)";
          burstContainer.appendChild(p);

          const angle = Math.random() * Math.PI * 2;
          const distance = Math.random() * 350 + 100;
          const x = Math.cos(angle) * distance;
          const y = Math.sin(angle) * distance;

          setTimeout(() => {
            p.style.transform = `translate(${x}px, ${y}px) scale(0)`;
            p.style.opacity = "0";
          }, 20);
        }

        setTimeout(() => {
          burstContainer.remove();
        }, 1400);
      }

      // --- 4. FAQ Accordion ---
      const faqItems = document.querySelectorAll(".faq-item");
      faqItems.forEach((item) => {
        const questionBtn = item.querySelector(".faq-question");
        if (questionBtn) {
          questionBtn.addEventListener("click", () => {
            const isActive = item.classList.contains("active");
            faqItems.forEach((i) => i.classList.remove("active"));
            if (!isActive) {
              item.classList.add("active");
            }
          });
        }
      });


      // --- 6. Scroll Reveal & Parallax ---
      const revealElements = document.querySelectorAll(
        ".neu-card, .section-header, .stat-card, .bento-card, .sim-card, .testimonial-card, .cta-banner",
      );

      if ("IntersectionObserver" in window) {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.style.opacity = "1";
                entry.target.style.transform = "translateY(0)";
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
        );

        revealElements.forEach((el) => {
          el.style.opacity = "0";
          el.style.transform = "translateY(24px)";
          el.style.transition =
            "opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)";
          revealObserver.observe(el);
        });
      }

      const heroMockup = document.querySelector(".phone-mockup");
      const heroSection = document.querySelector(".hero-section");

      if (heroMockup && heroSection && window.innerWidth > 992) {
        heroSection.addEventListener("mousemove", (e) => {
          const rect = heroSection.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;

          const rotateY = (x / rect.width) * 10;
          const rotateX = -(y / rect.height) * 10;

          heroMockup.style.transform = `rotate3d(1, 0, 0, ${rotateX}deg) rotate3d(0, 1, 0, ${rotateY}deg) scale(1.01)`;
        });

        heroSection.addEventListener("mouseleave", () => {
          heroMockup.style.transform = "rotate3d(1, 1, 0, 4deg) rotateZ(-1deg)";
        });
      }

      // Ambient Orbs Mouse Tracker
      const orbs = document.querySelectorAll(".zen-orb");
      window.addEventListener("mousemove", (e) => {
        const mouseX = e.clientX / window.innerWidth;
        const mouseY = e.clientY / window.innerHeight;

        orbs.forEach((orb, i) => {
          const speed = (i + 1) * 12;
          const x = (mouseX - 0.5) * speed;
          const y = (mouseY - 0.5) * speed;
          orb.style.transform = `translate(${x}px, ${y}px)`;
        });
      });
    })();
  </script>
</MainLayout>
