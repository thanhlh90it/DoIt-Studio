---
import MainLayout from "../../layouts/MainLayout.astro";

const APP_STORE_URL =
  "https://apps.apple.com/us/app/nhàta-quản-lý-gia-đình-con/id6804749534";
const PLAY_STORE_URL =
  "https://play.google.com/store/apps/details?id=com.doitstudio.nhata.app";
---

<MainLayout
  title="NhàTa – Không Gian Gia Đình Số | Một Mái Nhà, Vạn Niềm Vui"
  description="NhàTa — Không gian số khép kín, an toàn và tràn đầy tình yêu thương cho mọi gia đình Việt. Cùng con phân chia việc nhà tích sao đổi quà, quản lý thời khóa biểu 9s, lưu giữ kỷ niệm và cân bằng tài chính."
  showHeader={false}
  showFooter={false}
>
  <style is:global>
    /* ==========================================================================
       NhàTa Landing Page — Modern Zen & Soft Neumorphism Design System v3.0
       Brand: NhàTa ("Một mái nhà, vạn niềm vui")
       ========================================================================== */
    @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap");

    :root {
      /* Brand Primary: Sunset Orange 500 */
      --nt-primary: #f97316;
      --nt-primary-dark: #c2410c;
      --nt-primary-light: #fff7ed;
      --nt-primary-surface: #ffedd5;
      --nt-primary-gradient: linear-gradient(
        135deg,
        #fb923c 0%,
        #f97316 55%,
        #ea580c 100%
      );
      --nt-primary-glow: 0 10px 25px rgba(249, 115, 22, 0.32);

      /* Brand Secondary: Mindful Sage & Emerald */
      --nt-secondary: #10b981;
      --nt-secondary-dark: #047857;
      --nt-secondary-light: #ecfdf5;
      --nt-secondary-gradient: linear-gradient(
        135deg,
        #34d399 0%,
        #10b981 100%
      );

      /* Accent: Sun Amber Glow */
      --nt-accent: #f59e0b;
      --nt-accent-dark: #b45309;
      --nt-accent-light: #fef3c7;
      --nt-accent-gold: #fbbf24;

      /* Feature Specific */
      --nt-moments: #f43f5e;
      --nt-moments-light: #ffe4e6;
      --nt-finance: #0d9488;
      --nt-finance-light: #ccfbf1;

      /* Neutrals: Soft Warm Ivory */
      --nt-bg: #fdfbf7;
      --nt-bg-warm: #f8f5ee;
      --nt-surface: #ffffff;
      --nt-card-bg: #ffffff;
      --nt-border: #f3e8df;
      --nt-border-light: rgba(243, 232, 223, 0.7);
      --nt-muted-bg: #f5efeb;

      /* Typography Colors */
      --nt-text-primary: #1c1917;
      --nt-text-secondary: #57534e;
      --nt-text-muted: #8c827a;
      --nt-text-light: #faf8f5;

      /* Neumorphic Shadow Tokens */
      --nt-neu-convex-sm:
        -4px -4px 12px #ffffff, 4px 4px 14px rgba(67, 20, 7, 0.05);
      --nt-neu-convex-md:
        -8px -8px 20px #ffffff, 8px 8px 24px rgba(67, 20, 7, 0.06);
      --nt-neu-convex-lg:
        -12px -12px 30px #ffffff, 12px 12px 36px rgba(67, 20, 7, 0.08);
      --nt-neu-hover:
        -10px -10px 24px #ffffff, 10px 10px 30px rgba(67, 20, 7, 0.1);
      --nt-neu-debossed:
        inset -3px -3px 8px #ffffff, inset 3px 3px 8px rgba(67, 20, 7, 0.08);
      --nt-neu-debossed-deep:
        inset -4px -4px 10px #ffffff, inset 4px 4px 12px rgba(67, 20, 7, 0.12);

      /* Radius Scales */
      --nt-radius-sm: 12px;
      --nt-radius-md: 18px;
      --nt-radius-card: 28px;
      --nt-radius-pill: 9999px;

      /* Typography */
      --nt-font-heading:
        "Outfit", -apple-system, BlinkMacSystemFont, sans-serif;
      --nt-font-body:
        "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;

      /* Layout */
      --nt-container-max: 1240px;
      --nt-header-height: 80px;
      --nt-touch-target: 56px;
      --nt-transition-smooth: all 0.28s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* Page Scope */
    .nhata-body {
      font-family: var(--nt-font-body);
      background-color: var(--nt-bg);
      color: var(--nt-text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      position: relative;
      width: 100%;
      min-height: 100vh;
    }

    .nhata-body * {
      box-sizing: border-box;
    }

    /* Zen Ambient Background Orbs */
    .zen-ambient-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .zen-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.45;
      transition: transform 12s ease-in-out infinite alternate;
    }

    .zen-orb-1 {
      width: 550px;
      height: 550px;
      background: radial-gradient(
        circle,
        rgba(251, 146, 60, 0.35) 0%,
        rgba(254, 215, 170, 0.05) 70%
      );
      top: -150px;
      right: -100px;
    }

    .zen-orb-2 {
      width: 600px;
      height: 600px;
      background: radial-gradient(
        circle,
        rgba(16, 185, 129, 0.2) 0%,
        rgba(209, 250, 229, 0.03) 70%
      );
      bottom: 20%;
      left: -200px;
    }

    .zen-orb-3 {
      width: 450px;
      height: 450px;
      background: radial-gradient(
        circle,
        rgba(245, 158, 11, 0.25) 0%,
        rgba(254, 243, 199, 0.05) 70%
      );
      top: 45%;
      right: -150px;
    }

    /* Container */
    .nhata-container {
      width: 100%;
      max-width: var(--nt-container-max);
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 1;
    }

    .nhata-body a {
      text-decoration: none;
      color: inherit;
      transition: var(--nt-transition-smooth);
    }

    .nhata-body button {
      border: none;
      background: none;
      font-family: inherit;
      cursor: pointer;
      outline: none;
      transition: var(--nt-transition-smooth);
    }

    .nhata-body img,
    .nhata-body svg {
      display: block;
      max-width: 100%;
    }

    .nhata-body h1,
    .nhata-body h2,
    .nhata-body h3,
    .nhata-body h4,
    .nhata-body h5,
    .nhata-body h6 {
      font-family: var(--nt-font-heading);
      color: var(--nt-text-primary);
      font-weight: 700;
      line-height: 1.25;
    }

    /* Section Common Header */
    .section-header {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 56px;
    }

    .section-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      background: var(--nt-surface);
      box-shadow: var(--nt-neu-convex-sm);
      border: 1px solid var(--nt-border-light);
      border-radius: var(--nt-radius-pill);
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--nt-primary-dark);
      margin-bottom: 16px;
      letter-spacing: 0.02em;
    }

    .section-tag svg {
      width: 16px;
      height: 16px;
      color: var(--nt-primary);
    }

    .section-title {
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      letter-spacing: -0.02em;
      margin-bottom: 16px;
      color: var(--nt-text-primary);
    }

    .section-title span.highlight {
      color: var(--nt-primary);
      position: relative;
      display: inline-block;
    }

    .section-subtitle {
      font-size: 1.125rem;
      color: var(--nt-text-secondary);
      line-height: 1.65;
    }

    /* Neumorphic Reusable Components */
    .neu-card {
      background: var(--nt-surface);
      border-radius: var(--nt-radius-card);
      box-shadow: var(--nt-neu-convex-md);
      border: 1px solid var(--nt-border-light);
      padding: 32px;
      transition: var(--nt-transition-smooth);
      position: relative;
      overflow: hidden;
    }

    .neu-card:hover {
      box-shadow: var(--nt-neu-hover);
      transform: translateY(-3px);
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-family: var(--nt-font-heading);
      font-weight: 600;
      font-size: 1rem;
      padding: 14px 28px;
      min-height: 52px;
      border-radius: var(--nt-radius-pill);
      cursor: pointer;
      transition: var(--nt-transition-smooth);
      user-select: none;
      white-space: nowrap;
    }

    .btn-primary {
      background: var(--nt-primary-gradient);
      color: #ffffff !important;
      box-shadow:
        var(--nt-primary-glow),
        -3px -3px 10px rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow:
        0 14px 30px rgba(249, 115, 22, 0.4),
        -4px -4px 14px rgba(255, 255, 255, 0.9);
    }

    .btn-primary:active {
      transform: translateY(1px);
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
    }

    .btn-neu {
      background: var(--nt-surface);
      color: var(--nt-text-primary);
      box-shadow: var(--nt-neu-convex-sm);
      border: 1px solid var(--nt-border-light);
    }

    .btn-neu:hover {
      transform: translateY(-2px);
      box-shadow: var(--nt-neu-convex-md);
      color: var(--nt-primary);
    }

    .btn-store {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      padding: 10px 22px;
      background: var(--nt-surface);
      border-radius: var(--nt-radius-md);
      box-shadow: var(--nt-neu-convex-sm);
      border: 1px solid var(--nt-border-light);
      color: var(--nt-text-primary);
      min-width: 185px;
    }

    .btn-store:hover {
      transform: translateY(-2px);
      box-shadow: var(--nt-neu-convex-md);
      border-color: rgba(249, 115, 22, 0.3);
    }

    .btn-store svg {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }

    .btn-store .store-meta {
      display: flex;
      flex-direction: column;
      text-align: left;
    }

    .btn-store .store-meta span.sub {
      font-size: 0.7rem;
      color: var(--nt-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
    }

    .btn-store .store-meta span.name {
      font-family: var(--nt-font-heading);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--nt-text-primary);
      line-height: 1.15;
    }

    /* Top DoIT-Studio Studio Bar */
    .top-studio-bar {
      position: relative;
      z-index: 1001;
      padding: 8px 0;
      background: rgba(253, 251, 247, 0.9);
      border-bottom: 1px solid var(--nt-border);
      font-size: 13px;
    }

    .top-studio-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--nt-text-secondary);
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .top-studio-link:hover {
      color: var(--nt-primary);
    }

    /* Navbar */
    .navbar-wrap {
      position: sticky;
      top: 14px;
      left: 0;
      width: 100%;
      z-index: 1000;
      padding: 0 16px;
    }

    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: var(--nt-radius-pill);
      padding: 10px 24px;
      box-shadow: var(--nt-neu-convex-md);
      border: 1px solid rgba(255, 255, 255, 0.9);
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .nav-brand img.logo-img {
      height: 38px;
      width: auto;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-link {
      font-size: 0.938rem;
      font-weight: 600;
      color: var(--nt-text-secondary);
      padding: 8px 16px;
      border-radius: var(--nt-radius-pill);
      transition: var(--nt-transition-smooth);
    }

    .nav-link:hover {
      color: var(--nt-primary);
      background: var(--nt-primary-light);
    }

    .nav-cta {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .nav-cta .btn {
      padding: 10px 22px;
      min-height: 44px;
      font-size: 0.938rem;
    }

    .mobile-toggle {
      display: none;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--nt-surface);
      box-shadow: var(--nt-neu-convex-sm);
      align-items: center;
      justify-content: center;
      color: var(--nt-text-primary);
    }

    .mobile-nav-menu {
      display: none;
    }

    section[id] {
      scroll-margin-top: 100px;
    }

    /* Hero Section */
    .hero-section {
      padding: 48px 0 80px;
      position: relative;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
      align-items: center;
    }

    .hero-content {
      max-width: 620px;
    }

    .hero-pill-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px 20px;
      background: var(--nt-surface);
      box-shadow: var(--nt-neu-convex-sm);
      border: 1px solid var(--nt-border-light);
      border-radius: var(--nt-radius-pill);
      margin-bottom: 24px;
    }

    .hero-pill-badge .dot {
      width: 8px;
      height: 8px;
      background: var(--nt-secondary);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--nt-secondary);
      animation: pulse-glow 2s infinite;
    }

    .hero-pill-badge span {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--nt-text-primary);
    }

    .hero-title {
      font-size: clamp(2.5rem, 4.2vw, 3.65rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.15;
      margin-bottom: 24px;
      color: var(--nt-text-primary);
    }

    .hero-title .zen-text {
      background: linear-gradient(135deg, #f97316 20%, #ea580c 80%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-desc {
      font-size: 1.188rem;
      color: var(--nt-text-secondary);
      line-height: 1.7;
      margin-bottom: 36px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
      margin-bottom: 40px;
    }

    .hero-social-proof {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-top: 20px;
      border-top: 1px solid var(--nt-border);
    }

    .proof-avatars {
      display: flex;
      align-items: center;
    }

    .proof-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 3px solid #ffffff;
      box-shadow: var(--nt-neu-convex-sm);
      margin-left: -10px;
      background-color: var(--nt-primary-light);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.8rem;
      color: var(--nt-primary-dark);
    }

    .proof-avatar:first-child {
      margin-left: 0;
    }

    .proof-text {
      font-size: 0.938rem;
      color: var(--nt-text-secondary);
      line-height: 1.4;
    }

    .proof-text strong {
      color: var(--nt-text-primary);
    }

    .proof-rating {
      display: flex;
      align-items: center;
      gap: 4px;
      color: var(--nt-accent-gold);
    }

    /* Hero Phone Mockup Visual */
    .hero-visual {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .phone-mockup-wrapper {
      position: relative;
      z-index: 2;
      perspective: 1000px;
    }

    .phone-mockup {
      width: 320px;
      height: 650px;
      background: #1c1917;
      border-radius: 50px;
      padding: 14px;
      box-shadow:
        0 25px 60px rgba(67, 20, 7, 0.22),
        -8px -8px 24px #ffffff;
      border: 4px solid #38332e;
      position: relative;
      transform: rotate3d(1, 1, 0, 4deg) rotateZ(-1deg);
      transition: transform 0.5s ease;
    }

    .phone-mockup:hover {
      transform: rotate3d(0, 0, 0, 0deg) scale(1.02);
    }

    .phone-screen {
      width: 100%;
      height: 100%;
      border-radius: 40px;
      overflow: hidden;
      background: var(--nt-bg);
      position: relative;
    }

    .phone-screen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }

    /* Floating Micro Cards on Hero */
    .hero-float-card {
      position: absolute;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 14px 18px;
      border-radius: var(--nt-radius-md);
      box-shadow: var(--nt-neu-convex-md);
      border: 1px solid rgba(255, 255, 255, 0.9);
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 5;
      animation: float-slow 4s ease-in-out infinite alternate;
    }

    .float-card-left {
      bottom: 80px;
      left: -40px;
    }

    .float-card-right {
      top: 100px;
      right: -30px;
      animation-delay: 1.5s;
    }

    .float-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .float-icon.orange {
      background: var(--nt-primary-light);
      color: var(--nt-primary);
    }

    .float-icon.green {
      background: var(--nt-secondary-light);
      color: var(--nt-secondary);
    }

    .float-icon.amber {
      background: var(--nt-accent-light);
      color: var(--nt-accent-dark);
    }

    .float-info h4 {
      font-size: 0.938rem;
      font-weight: 700;
      margin-bottom: 2px;
    }

    .float-info p {
      font-size: 0.813rem;
      color: var(--nt-text-muted);
      margin: 0;
    }

    /* Quick Stats Banner */
    .stats-section {
      padding: 40px 0 60px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }

    .stat-card {
      background: var(--nt-surface);
      border-radius: var(--nt-radius-card);
      box-shadow: var(--nt-neu-convex-sm);
      border: 1px solid var(--nt-border-light);
      padding: 28px 24px;
      text-align: center;
      transition: var(--nt-transition-smooth);
    }

    .stat-card:hover {
      box-shadow: var(--nt-neu-convex-md);
      transform: translateY(-3px);
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      margin: 0 auto 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--nt-neu-debossed);
      background: var(--nt-bg-warm);
    }

    .stat-icon svg {
      width: 22px;
      height: 22px;
    }

    .stat-number {
      font-family: var(--nt-font-heading);
      font-size: 2.25rem;
      font-weight: 800;
      color: var(--nt-text-primary);
      margin-bottom: 6px;
      letter-spacing: -0.02em;
    }

    .stat-label {
      font-size: 0.938rem;
      color: var(--nt-text-secondary);
      font-weight: 600;
    }

    /* Interactive Feature Showcase */
    .showcase-section {
      padding: 80px 0;
      background: var(--nt-bg-warm);
      position: relative;
    }

    .showcase-wrapper {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    /* Tab Selectors */
    .showcase-nav {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .showcase-tab {
      display: flex;
      align-items: flex-start;
      gap: 20px;
      padding: 22px 24px;
      background: var(--nt-surface);
      border-radius: var(--nt-radius-card);
      box-shadow: var(--nt-neu-convex-sm);
      border: 1px solid var(--nt-border-light);
      cursor: pointer;
      transition: var(--nt-transition-smooth);
      text-align: left;
      position: relative;
    }

    .showcase-tab:hover {
      box-shadow: var(--nt-neu-convex-md);
      transform: translateX(4px);
    }

    .showcase-tab.active {
      background: var(--nt-surface);
      box-shadow: var(--nt-neu-debossed-deep);
      border-color: rgba(249, 115, 22, 0.4);
    }

    .showcase-tab.active::before {
      content: "";
      position: absolute;
      left: 0;
      top: 20%;
      height: 60%;
      width: 5px;
      background: var(--nt-primary);
      border-radius: 0 4px 4px 0;
    }

    .tab-icon-wrap {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      background: var(--nt-bg);
      box-shadow: var(--nt-neu-convex-sm);
    }

    .showcase-tab.active .tab-icon-wrap {
      background: var(--nt-primary-light);
      color: var(--nt-primary);
      box-shadow: none;
    }

    .tab-content h3 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--nt-text-primary);
    }

