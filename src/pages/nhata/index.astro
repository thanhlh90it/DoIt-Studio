  <!-- ==========================================================================
       SCRIPTS: PHONE MOCKUP INTERACTION, CONFETTI & FAQ
       ========================================================================== -->
  <script is:inline>
    // 1. Confetti Engine
    class ConfettiEngine {
      constructor() {
        this.canvas = document.getElementById('nt-confetti-canvas');
        if (!this.canvas) return;
        this.ctx = this.canvas.getContext('2d');
        this.particles = [];
        this.animationId = null;

        this.resize = this.resize.bind(this);
        this.loop = this.loop.bind(this);

        window.addEventListener('resize', this.resize);
        this.resize();
      }

      resize() {
        if (!this.canvas) return;
        this.canvas.width = window.innerWidth;
        this.canvas.height = window.innerHeight;
      }

      fire(x = window.innerWidth / 2, y = window.innerHeight / 2, count = 35) {
        const colors = ['#F59E0B', '#FBBF24', '#D97706', '#3B82F6', '#10B981', '#EC4899'];
        for (let i = 0; i < count; i++) {
          const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.5;
          const speed = Math.random() * 7 + 3;
          this.particles.push({
            x, y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 2,
            size: Math.random() * 8 + 6,
            color: colors[Math.floor(Math.random() * colors.length)],
            rotation: Math.random() * Math.PI * 2,
            rotationSpeed: (Math.random() - 0.5) * 0.2,
            opacity: 1,
            life: 0,
            maxLife: Math.random() * 30 + 40
          });
        }
        if (!this.animationId) this.loop();
      }

      loop() {
        if (!this.ctx || !this.canvas) return;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          p.life++;
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.2;
          p.vx *= 0.98;
          p.rotation += p.rotationSpeed;
          p.opacity = Math.max(0, 1 - p.life / p.maxLife);

          this.ctx.save();
          this.ctx.globalAlpha = p.opacity;
          this.ctx.translate(p.x, p.y);
          this.ctx.rotate(p.rotation);
          this.ctx.fillStyle = p.color;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
          this.ctx.fill();
          this.ctx.restore();

          if (p.life >= p.maxLife) this.particles.splice(i, 1);
        }

        if (this.particles.length > 0) {
          this.animationId = requestAnimationFrame(this.loop);
        } else {
          this.animationId = null;
          this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        }
      }
    }

    const ntConfetti = new ConfettiEngine();

    // 2. Phone Mockup Tabs Controller
    (function initMockup() {
      const outerBtns = document.querySelectorAll('.nt-outer-tab-btn');
      const innerBtns = document.querySelectorAll('.nt-phone-tab-btn');
      const panels = document.querySelectorAll('.nt-screen-panel');
      let stars = 25;

      function switchTab(tabId) {
        outerBtns.forEach((btn) => {
          if (btn.dataset.tab === tabId) {
            btn.classList.add('active', 'bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-500/25');
            btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          } else {
            btn.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-500/25');
            btn.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          }
        });

        innerBtns.forEach((btn) => {
          if (btn.dataset.tab === tabId) btn.classList.add('active');
          else btn.classList.remove('active');
        });

        panels.forEach((p) => {
          if (p.id === `nt-screen-${tabId}`) p.classList.add('active');
          else p.classList.remove('active');
        });
      }

      outerBtns.forEach((btn) => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));
      innerBtns.forEach((btn) => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));

      // Interactive Chores in Mockup
      document.querySelectorAll('.nt-task-item').forEach((item) => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          const checkBtn = item.querySelector('.nt-check-btn');
          const isDone = item.classList.contains('completed');
          const starVal = parseInt(item.dataset.stars || '5', 10);

          if (!isDone) {
            item.classList.add('completed', 'opacity-70');
            if (checkBtn) {
              checkBtn.textContent = '✓';
              checkBtn.classList.add('bg-emerald-600', 'border-emerald-600');
            }
            stars += starVal;
            const rect = item.getBoundingClientRect();
            ntConfetti.fire(rect.left + rect.width / 2, rect.top, 35);
          } else {
            item.classList.remove('completed', 'opacity-70');
            if (checkBtn) {
              checkBtn.textContent = '';
              checkBtn.classList.remove('bg-emerald-600', 'border-emerald-600');
            }
            stars = Math.max(0, stars - starVal);
          }

          document.querySelectorAll('.nt-live-stars').forEach((el) => {
            el.textContent = stars;
          });
        });
      });

      // Like Button in Mockup
      document.querySelectorAll('.nt-like-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const countEl = btn.querySelector('.nt-like-count');
          let count = parseInt(countEl?.textContent || '18', 10);
          const isLiked = btn.classList.contains('liked');

          if (!isLiked) {
            btn.classList.add('liked');
            if (countEl) countEl.textContent = count + 1;
            const rect = btn.getBoundingClientRect();
            ntConfetti.fire(rect.left + rect.width / 2, rect.top, 20);
          } else {
            btn.classList.remove('liked');
            if (countEl) countEl.textContent = Math.max(0, count - 1);
          }
        });
      });
    })();

    // 3. FAQ Accordion
    document.querySelectorAll('.nt-faq-item').forEach((item) => {
      const btn = item.querySelector('.nt-faq-btn');
      btn?.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        document.querySelectorAll('.nt-faq-item').forEach((other) => {
          if (other !== item) other.classList.remove('active');
        });
        if (!isActive) item.classList.add('active');
        else item.classList.remove('active');
      });
    });

    // 4. QR Modal
    (function initModal() {
      const modal = document.getElementById('nt-qr-modal');
      function openModal() {
        if (!modal) return;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closeModal() {
        if (!modal) return;
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.js-open-qr-modal').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openModal();
        });
      });

      document.querySelectorAll('.js-close-qr-modal').forEach((btn) => {
        btn.addEventListener('click', closeModal);
      });

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal?.classList.contains('active')) {
          closeModal();
        }
      });

      // Copy Link Button
      document.querySelectorAll('.js-copy-nhata-link').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-url') || window.location.href;
          const textEl = btn.querySelector('.js-copy-text');
          try {
            await navigator.clipboard.writeText(url);
            if (textEl) {
              const old = textEl.textContent;
              textEl.textContent = 'Đã sao chép liên kết!';
              btn.classList.add('bg-emerald-600');
              setTimeout(() => {
                textEl.textContent = old;
                btn.classList.remove('bg-emerald-600');
              }, 2000);
            }
          } catch (err) {
            console.error('Copy failed:', err);
          }
        });
      });
    })();
  </script>
</MainLayout>
