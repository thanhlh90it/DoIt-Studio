---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout
  title="NhàTa – Một Mái Nhà, Vạn Niềm Vui | DoIT-Studio"
  description="Không gian số ấm áp, riêng tư giúp bố mẹ và con cái cùng quản lý lịch biểu, phân chia việc nhà tích sao đổi quà, và lưu giữ trọn vẹn từng khoảnh khắc gia đình vô giá."
>
  <style>
    /* ==========================================================================
       DESIGN TOKENS & SCOPED STYLES - NHÀTA LANDING
       ========================================================================== */
    :root {
      --nt-primary: #2563EB;
      --nt-primary-dark: #1D4ED8;
      --nt-primary-light: #DBEAFE;
      --nt-primary-50: #EFF6FF;
      --nt-primary-gradient: linear-gradient(135deg, #3B82F6 0%, #2563EB 50%, #1D4ED8 100%);
      --nt-primary-glow: rgba(37, 99, 235, 0.28);

      --nt-secondary: #059669;
      --nt-secondary-dark: #047857;
      --nt-secondary-light: #D1FAE5;
      --nt-secondary-50: #ECFDF5;

      --nt-accent: #F59E0B;
      --nt-accent-amber: #D97706;
      --nt-accent-light: #FEF3C7;
      --nt-accent-50: #FFFBEB;
      --nt-accent-gradient: linear-gradient(135deg, #FBBF24 0%, #F59E0B 50%, #D97706 100%);
      --nt-accent-glow: rgba(245, 158, 11, 0.35);

      --nt-heart: #EC4899;
      --nt-bg: #F8FAFC;
      --nt-surface: #FFFFFF;
      --nt-border: #E2E8F0;
      --nt-muted: #F1F5F9;

      --nt-text-primary: #0F172A;
      --nt-text-secondary: #475569;
      --nt-text-muted: #94A3B8;

      --nt-font-heading: 'Outfit', 'Plus Jakarta Sans', sans-serif;
      --nt-font-body: 'Plus Jakarta Sans', 'Inter', sans-serif;
    }

    .nt-page {
      font-family: var(--nt-font-body);
      background-color: var(--nt-bg);
      color: var(--nt-text-primary);
      position: relative;
      overflow-x: hidden;
      width: 100%;
    }

    .nt-page h1, .nt-page h2, .nt-page h3, .nt-page h4 {
      font-family: var(--nt-font-heading);
      font-weight: 700;
    }

    /* Ambient Glowing Background Orbs */
    .nt-ambient {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      overflow: hidden; pointer-events: none; z-index: 0;
    }
    .nt-blob {
      position: absolute; border-radius: 9999px; filter: blur(80px); opacity: 0.45; pointer-events: none;
    }
    .nt-blob-1 {
      top: 3%; left: -5%; width: 460px; height: 460px;
      background: radial-gradient(circle, rgba(59, 130, 246, 0.28) 0%, rgba(219, 234, 254, 0) 70%);
      animation: nt-float-1 18s ease-in-out infinite;
    }
    .nt-blob-2 {
      top: 18%; right: -5%; width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.22) 0%, rgba(254, 243, 199, 0) 70%);
      animation: nt-float-2 22s ease-in-out infinite;
    }
    .nt-blob-3 {
      top: 50%; left: 8%; width: 480px; height: 480px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.18) 0%, rgba(209, 250, 229, 0) 70%);
      animation: nt-float-3 20s ease-in-out infinite;
    }

    @keyframes nt-float-1 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(35px, -25px) scale(1.08); }
    }
    @keyframes nt-float-2 {
      0%, 100% { transform: translate(0, 0) scale(1.05); }
      50% { transform: translate(-30px, 20px) scale(0.95); }
    }
    @keyframes nt-float-3 {
      0%, 100% { transform: translate(0, 0) scale(0.95); }
      50% { transform: translate(20px, 30px) scale(1.06); }
    }

    /* Gradient Texts */
    .nt-gradient-primary {
      background: var(--nt-primary-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }
    .nt-gradient-gold {
      background: var(--nt-accent-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    /* Buttons */
    .nt-btn-primary {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px 24px; border-radius: 9999px; font-weight: 700; font-size: 15px;
      background: var(--nt-primary-gradient); color: #FFFFFF; border: none; cursor: pointer; text-decoration: none;
      box-shadow: 0 10px 24px -4px var(--nt-primary-glow);
      transition: transform .2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow .2s ease;
    }
    .nt-btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -4px rgba(37, 99, 235, 0.45);
    }
    .nt-btn-secondary {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px 22px; border-radius: 9999px; font-weight: 600; font-size: 15px;
      background: #FFFFFF; color: var(--nt-text-primary); border: 1.5px solid var(--nt-border); cursor: pointer; text-decoration: none;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
      transition: transform .2s ease, background .2s ease, border-color .2s ease;
    }
    .nt-btn-secondary:hover {
      background: var(--nt-primary-50); border-color: var(--nt-primary-light); color: var(--nt-primary);
      transform: translateY(-2px);
    }
    .nt-btn-qr {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      padding: 8px 16px; border-radius: 9999px; font-weight: 600; font-size: 13px;
      background: #FFFFFF; color: var(--nt-text-secondary); border: 1px solid var(--nt-border); cursor: pointer;
      transition: all .2s ease;
    }
    .nt-btn-qr:hover {
      background: var(--nt-primary-50); color: var(--nt-primary); border-color: var(--nt-primary-light);
    }

    /* Section Header Badges */
    .nt-tag {
      display: inline-flex; align-items: center; gap: 6px; padding: 4px 14px;
      background: var(--nt-primary-50); color: var(--nt-primary-dark);
      font-size: 13px; font-weight: 700; border-radius: 9999px; border: 1px solid rgba(37, 99, 235, 0.2);
      margin-bottom: 12px;
    }
    .nt-tag.secondary {
      background: var(--nt-secondary-50); color: var(--nt-secondary-dark); border-color: rgba(5, 150, 105, 0.2);
    }
    .nt-tag.accent {
      background: var(--nt-accent-50); color: var(--nt-accent-amber); border-color: rgba(245, 158, 11, 0.25);
    }

    /* Floating Badges */
    .nt-float-badge {
      position: absolute; background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.95);
      padding: 8px 12px; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.1);
      display: flex; align-items: center; gap: 10px; z-index: 10; max-width: 240px;
    }

    /* Phone Mockup Frame */
    .nt-phone-wrapper {
      position: relative; z-index: 5; width: 100%; max-width: 285px; margin: 0 auto;
    }
    .nt-phone-frame {
      width: 100%; height: 535px; background: #0F172A; border-radius: 40px; padding: 10px;
      box-shadow: 0 30px 60px -15px rgba(15, 23, 42, 0.25), 0 0 0 1px rgba(15, 23, 42, 0.08);
      position: relative; border: 3.5px solid #334155; overflow: hidden;
    }
    .nt-phone-screen {
      width: 100%; height: 100%; background: #F8FAFC; border-radius: 30px; overflow: hidden;
      display: flex; flex-direction: column; position: relative;
    }
    .nt-phone-body {
      flex: 1; overflow-y: auto; overflow-x: hidden; position: relative; scrollbar-width: none;
    }
    .nt-phone-body::-webkit-scrollbar { display: none; }

    .nt-screen-panel {
      display: none; padding: 8px 10px 52px 10px; animation: nt-fadeIn 0.25s ease-out;
    }
    .nt-screen-panel.active { display: block; }
    @keyframes nt-fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .nt-phone-nav {
      position: absolute; bottom: 0; left: 0; width: 100%; height: 48px;
      background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);
      border-top: 1px solid #E2E8F0; display: flex; align-items: center; justify-content: space-around;
      padding: 0 2px 4px 2px; z-index: 30;
    }
    .nt-phone-tab-btn {
      display: flex; flex-direction: column; align-items: center; gap: 2px;
      color: #94A3B8; font-size: 8px; font-weight: 600; cursor: pointer; transition: color 0.2s;
      padding: 2px; flex: 1;
    }
    .nt-phone-tab-btn.active { color: #2563EB; font-weight: 700; }

    /* Bento Cards */
    .nt-bento-card {
      background: #FFFFFF; border-radius: 24px; padding: 32px;
      border: 1px solid var(--nt-border); box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.04);
      transition: all 0.25s ease; display: flex; flex-direction: column; justify-content: space-between;
    }
    .nt-bento-card:hover {
      transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.08);
      border-color: rgba(37, 99, 235, 0.25);
    }

    /* FAQ Accordion */
    .nt-faq-item {
      background: #FFFFFF; border: 1px solid var(--nt-border); border-radius: 18px;
      overflow: hidden; transition: border-color 0.2s;
    }
    .nt-faq-item:hover { border-color: var(--nt-primary-light); }
    .nt-faq-btn {
      width: 100%; padding: 18px 20px; display: flex; align-items: center; justify-content: space-between;
      font-size: 16px; font-weight: 700; color: var(--nt-text-primary); text-align: left;
      background: none; border: none; cursor: pointer; gap: 12px;
    }
    .nt-faq-answer {
      max-height: 0; overflow: hidden; transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 0 20px; color: var(--nt-text-secondary); font-size: 15px; line-height: 1.6;
    }
    .nt-faq-item.active .nt-faq-answer {
      max-height: 240px; padding-bottom: 18px;
    }
    .nt-faq-item.active .nt-faq-icon {
      transform: rotate(45deg); color: #DC2626;
    }

    /* Modal */
    .nt-modal-overlay {
      position: fixed; inset: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(8px);
      display: none; align-items: center; justify-content: center; z-index: 1000; padding: 16px;
    }
    .nt-modal-overlay.active { display: flex; }
    .nt-modal-box {
      background: #FFFFFF; border-radius: 28px; padding: 32px 28px; max-width: 380px; width: 100%;
      text-align: center; box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25); position: relative;
      animation: nt-modalPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes nt-modalPop {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }

    /* Canvas Confetti */
    #nt-confetti-canvas {
      position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999;
    }

    @media (max-width: 768px) {
      .nt-float-badge { display: none !important; }
      .nt-hero-grid { grid-template-columns: 1fr !important; text-align: center !important; }
      .nt-hero-content { align-items: center !important; }
    }
  </style>

  <div class="nt-page">
    <canvas id="nt-confetti-canvas" aria-hidden="true"></canvas>

    <!-- Ambient Glowing Blobs Background -->
    <div class="nt-ambient" aria-hidden="true">
      <div class="nt-blob nt-blob-1"></div>
      <div class="nt-blob nt-blob-2"></div>
      <div class="nt-blob nt-blob-3"></div>
    </div>

    <!-- ==========================================================================
         TOP BAR & BREADCRUMB
         ========================================================================== -->
    <header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-slate-200/80 transition-all">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/apps" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition-colors flex items-center gap-1.5 font-mono">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
            <span>DoIT-Studio // APPS</span>
          </a>
          <span class="text-slate-300">/</span>
          <div class="flex items-center gap-2">
            <img src="/nhata/icons/app-icon.svg" alt="NhàTa Logo" width="28" height="28" class="rounded-lg shadow-sm" />
            <span class="font-extrabold text-slate-900 text-lg tracking-tight font-['Outfit']">NhàTa</span>
          </div>
        </div>

        <div class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-600">
          <a href="#features" class="hover:text-blue-600 transition-colors">Tính năng</a>
          <a href="#interactive-demo" class="hover:text-blue-600 transition-colors">Trải nghiệm thử</a>
          <a href="#onboarding" class="hover:text-blue-600 transition-colors">Giao diện app</a>
          <a href="#family-story" class="hover:text-blue-600 transition-colors">Nhịp sống gia đình</a>
          <a href="#faq" class="hover:text-blue-600 transition-colors">Hỏi đáp</a>
        </div>

        <div class="flex items-center gap-3">
          <button type="button" class="nt-btn-qr js-open-qr-modal" aria-label="Quét mã QR tải app">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span class="hidden sm:inline">Quét mã QR</span>
          </button>
          <a href="#download" class="nt-btn-primary text-sm py-2 px-4">Tải App</a>
        </div>
      </div>
    </header>

    <!-- ==========================================================================
         HERO SECTION
         ========================================================================== -->
    <section class="pt-10 pb-16 sm:pt-16 sm:pb-24 relative z-10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center nt-hero-grid">
          
          <!-- Hero Left Content -->
          <div class="lg:col-span-7 flex flex-col items-start nt-hero-content">
            <div class="nt-tag">
              <span>✨</span>
              <span>Ứng Dụng Gia Đình #1 Dành Cho Tổ Ấm Việt</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.1] mb-5">
              Một Mái Nhà, <br />
              <span class="nt-gradient-primary">Vạn Niềm Vui</span>
            </h1>

            <p class="text-slate-600 text-lg sm:text-xl leading-relaxed mb-8 max-w-xl">
              Không gian số ấm áp, riêng tư giúp bố mẹ và con cái cùng quản lý lịch biểu, phân chia việc nhà tích sao đổi quà, và lưu giữ trọn vẹn từng khoảnh khắc gia đình vô giá.
            </p>

            <div class="flex flex-wrap gap-3 mb-10 w-full sm:w-auto">
              <a href="#download" class="nt-btn-primary w-full sm:w-auto text-base py-3.5 px-7">
                <span>Tải App Cho Cả Nhà</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
              <a href="#interactive-demo" class="nt-btn-secondary w-full sm:w-auto text-base py-3.5 px-6">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <span>Trải Nghiệm Thử</span>
              </a>
            </div>

            <!-- Trust Indicators -->
            <div class="pt-6 border-t border-slate-200/80 flex flex-wrap items-center gap-6 text-xs sm:text-sm font-semibold text-slate-600">
              <div class="flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>100% Riêng tư & Bảo mật</span>
              </div>
              <div class="flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>1 Giao diện cho cả nhà</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-amber-500 font-bold">★ 4.9/5</span>
                <span>Được phụ huynh yêu thích</span>
              </div>
            </div>
          </div>

          <!-- Hero Right Visual: Interactive iPhone Mockup -->
          <div class="lg:col-span-5 relative flex justify-center items-center">
            
            <!-- Floating Badges -->
            <div class="nt-float-badge" style="top: 10%; left: -30px;">
              <div style="width: 32px; height: 32px; border-radius: 50%; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 16px;">⭐</div>
              <div>
                <div style="font-size: 11px; font-weight: 700; color: #0F172A; line-height: 1.2;">Bé Bống vừa nhận +5 Sao!</div>
                <div style="font-size: 10px; color: #94A3B8;">Tưới cây ban công xong</div>
              </div>
            </div>

            <div class="nt-float-badge" style="bottom: 22%; right: -25px;">
              <div style="width: 32px; height: 32px; border-radius: 50%; background: #DBEAFE; color: #1D4ED8; display: flex; align-items: center; justify-content: center; font-size: 16px;">📅</div>
              <div>
                <div style="font-size: 11px; font-weight: 700; color: #0F172A; line-height: 1.2;">Lịch dã ngoại cuối tuần</div>
                <div style="font-size: 10px; color: #94A3B8;">Bố Minh vừa tạo · Chủ nhật</div>
              </div>
            </div>

            <!-- Phone Frame Component -->
            <div class="nt-phone-wrapper">
              <div class="nt-phone-frame">
                <div class="nt-phone-screen">
                  
                  <!-- Status Bar -->
                  <div class="h-9 px-4 pt-1 flex items-center justify-between text-[10px] font-bold text-slate-800 relative z-20">
                    <span>09:41</span>
                    <div class="w-20 h-5 bg-black rounded-full absolute left-1/2 -translate-x-1/2 top-2 flex items-center justify-between px-2">
                      <div class="w-1.5 h-1.5 rounded-full bg-slate-800"></div>
                      <div class="w-2 h-2 rounded-full bg-slate-900 border border-slate-800"></div>
                    </div>
                    <span>5G 􀛨</span>
                  </div>

                  <!-- Screen Panels Body -->
                  <div class="nt-phone-body">
                    
                    <!-- 1. Screen Today -->
                    <div class="nt-screen-panel active" id="nt-screen-today">
                      <div class="flex items-center justify-between mb-2.5">
                        <div class="flex items-center gap-2">
                          <div class="w-7 h-7 rounded-full bg-blue-100 border border-white flex items-center justify-center font-bold text-blue-700 text-xs shadow-sm">B</div>
                          <div>
                            <div class="text-xs font-bold text-slate-900">Chào Bé Bống!</div>
                            <div class="text-[9px] text-slate-500">Nhà Mình · Thứ Hai</div>
                          </div>
                        </div>
                        <div class="bg-amber-100 border border-amber-200 px-2 py-0.5 rounded-full flex items-center gap-1 text-xs font-bold text-amber-800">
                          <span>⭐</span>
                          <span class="nt-live-stars">25</span>
                        </div>
                      </div>

                      <!-- Card: Lịch hôm nay -->
                      <div class="bg-white rounded-xl p-2.5 mb-2 shadow-sm border border-slate-100">
                        <div class="flex items-center justify-between text-[11px] font-bold text-slate-800 mb-1.5">
                          <span>📅 Sự kiện hôm nay</span>
                          <span class="text-blue-600 text-[10px]">Xem lịch &gt;</span>
                        </div>
                        <div class="flex items-center gap-2 p-1.5 bg-blue-50/80 rounded-lg border-l-4 border-blue-600">
                          <div class="text-[11px] font-bold text-blue-700">17:30</div>
                          <div class="text-[11px] font-semibold text-slate-800">Đón con &amp; Học bơi</div>
                        </div>
                      </div>

                      <!-- Card: Việc nhà nhận sao -->
                      <div class="bg-white rounded-xl p-2.5 mb-2 shadow-sm border border-slate-100">
                        <div class="flex items-center justify-between text-[11px] font-bold text-slate-800 mb-2">
                          <span>✨ Việc nhà nhận sao</span>
                          <span class="text-emerald-600 text-[10px]">Tự giác</span>
                        </div>

                        <div class="flex items-center justify-between p-2 bg-slate-50 rounded-lg mb-1.5 nt-task-item cursor-pointer hover:bg-emerald-50/60 transition-colors" data-stars="5">
                          <div class="flex items-center gap-2">
                            <button type="button" class="w-4 h-4 rounded border border-slate-300 bg-white flex items-center justify-center text-[9px] text-white font-bold nt-check-btn"></button>
                            <span class="text-[11px] font-medium text-slate-800">Tưới cây ban công</span>
                          </div>
                          <span class="text-[10px] font-bold text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded-md">+5 ⭐</span>
                        </div>

                        <div class="flex items-center justify-between p-2 bg-slate-50 rounded-lg nt-task-item cursor-pointer hover:bg-emerald-50/60 transition-colors" data-stars="10">
                          <div class="flex items-center gap-2">
                            <button type="button" class="w-4 h-4 rounded border border-slate-300 bg-white flex items-center justify-center text-[9px] text-white font-bold nt-check-btn"></button>
                            <span class="text-[11px] font-medium text-slate-800">Gấp quần áo gọn gàng</span>
                          </div>
