  <!-- INTERACTIVE JAVASCRIPT CONTROLLERS -->
  <script>
    // 1. Screenshots Data Matrix
    const screenshotsData = [
      {
        title: "Đăng nhập Bảo mật",
        category: "Bắt đầu & Thiết lập",
        desc: "Đăng nhập 1 chạm an toàn qua Google và Apple Sign-In. Lưu trữ hồ sơ người dùng trên nền tảng đám mây Firebase Authentication.",
        src: "/yopolo/screenshots/1-login.jpg"
      },
      {
        title: "1. Chọn Ngôn ngữ Mục tiêu",
        category: "Onboarding",
        desc: "Hỗ trợ linh hoạt 6 ngôn ngữ thông dụng: Tiếng Anh, Pháp, Trung, Hàn, Nhật và Tiếng Việt. Ngôn ngữ giải thích lỗi sai mặc định là Tiếng Việt.",
        src: "/yopolo/screenshots/2-1-onboarding-lang.jpg"
      },
      {
        title: "2. Chọn Chủ đề Quan tâm",
        category: "Onboarding",
        desc: "Lựa chọn từ 1 đến 5 chủ đề bạn yêu thích nhất (Công nghệ & IT, Công sở & Sự nghiệp, Du lịch & Văn hoá, Đời sống, Giải trí...).",
        src: "/yopolo/screenshots/2-2-onboarding-topics.jpg"
      },
      {
        title: "3. Giờ Nhắc Học Thông Minh",
        category: "Onboarding",
        desc: "Cấu hình khung giờ nhận thông báo nhắc nhở hàng ngày (Local Notification) giúp bạn duy trì kỷ luật học tập ngắt quãng 5–10 phút.",
        src: "/yopolo/screenshots/2-3-onboarding-time.jpg"
      },
      {
        title: "AI Khởi tạo Chủ đề Ngẫu nhiên",
        category: "Đàm thoại AI",
        desc: "Mỗi ngày mở màn hình Chat, Yopolo AI tự động tạo một chủ đề thảo luận thú vị theo sở thích của bạn, kèm bài đọc B1-B2 và câu hỏi kích thích phản xạ.",
        src: "/yopolo/screenshots/4-1-ai-chat-starter.jpg"
      },
      {
        title: "Bóc tách Từ vựng & Cú pháp",
        category: "Đàm thoại AI",
        desc: "Trong từng câu đàm thoại, AI bóc tách các pill [+ Từ vựng] và [+ Cú pháp] đắt giá kèm giải thích cặn kẽ để bạn lưu vào sổ tay chỉ với 1 chạm.",
        src: "/yopolo/screenshots/4-2-ai-chat-dialog.jpg"
      },
      {
        title: "Sổ tay Cá nhân & Flashcards",
        category: "Sổ tay & Ôn tập",
        desc: "Tất cả từ vựng đã lưu được nhóm theo chủ đề và ngôn ngữ. Hỗ trợ chế độ lật thẻ Flashcard tương tác giúp ghi nhớ dài hạn không áp lực.",
        src: "/yopolo/screenshots/5-notebook.jpg"
      },
      {
        title: "Hồ sơ & Đổi Cấu hình",
        category: "Trang chủ & Profile",
        desc: "Quản lý hồ sơ cá nhân, cấp độ học tập, tùy chỉnh lại danh sách chủ đề, ngôn ngữ và quét mã QR để đăng nhập ngay trên Web Client.",
        src: "/yopolo/screenshots/3-home-profile.jpg"
      }
    ];

    let currentScreenshotIdx = 0;

    // 2. Filter Tabs Functionality
    const filterTabs = document.querySelectorAll('.filter-tab');
    const screenshotCards = document.querySelectorAll('.screenshot-card');

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const filter = tab.getAttribute('data-filter');
        screenshotCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 3. Lightbox Modal Functionality
    const lightboxModal = document.getElementById('lightboxModal');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxDesc = document.getElementById('lightboxDesc');
    const lightboxCategory = document.getElementById('lightboxCategory');
    const lightboxClose = document.getElementById('lightboxClose');
    const lightboxPrev = document.getElementById('lightboxPrev');
    const lightboxNext = document.getElementById('lightboxNext');

    function openLightbox(index) {
      currentScreenshotIdx = index;
      const data = screenshotsData[index];
      lightboxImg.src = data.src;
      lightboxTitle.textContent = data.title;
      lightboxDesc.textContent = data.desc;
      lightboxCategory.textContent = data.category;
      lightboxModal.classList.add('active');
      lightboxModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightboxModal.classList.remove('active');
      lightboxModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    screenshotCards.forEach(card => {
      card.addEventListener('click', () => {
        const index = parseInt(card.getAttribute('data-index'), 10);
        openLightbox(index);
      });
    });

    lightboxClose.addEventListener('click', closeLightbox);

    lightboxModal.addEventListener('click', (e) => {
      if (e.target === lightboxModal) {
        closeLightbox();
      }
    });

    lightboxPrev.addEventListener('click', () => {
      currentScreenshotIdx = (currentScreenshotIdx - 1 + screenshotsData.length) % screenshotsData.length;
      openLightbox(currentScreenshotIdx);
    });

    lightboxNext.addEventListener('click', () => {
      currentScreenshotIdx = (currentScreenshotIdx + 1) % screenshotsData.length;
      openLightbox(currentScreenshotIdx);
    });

    // Keyboard Navigation for Lightbox
    window.addEventListener('keydown', (e) => {
      if (!lightboxModal.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') lightboxPrev.click();
      if (e.key === 'ArrowRight') lightboxNext.click();
    });

    // 4. FAQ Accordion Functionality
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const header = item.querySelector('.faq-header');
      header.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        faqItems.forEach(i => {
          i.classList.remove('active');
          i.querySelector('.faq-header').setAttribute('aria-expanded', 'false');
        });
        if (!isActive) {
          item.classList.add('active');
          header.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>
</body>

