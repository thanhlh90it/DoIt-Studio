---
// Yopolo Landing Page - DoIT Studio
// Route: /yopolo/
const APP_STORE_URL = "https://apps.apple.com/us/app/yopolo-luyện-ngoại-ngữ-ai/id6829576014";
const GOOGLE_PLAY_URL = "https://play.google.com/store/apps/details?id=com.doitstudio.yopolo";
---
<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yopolo: Trợ Lý Ngoại Ngữ AI · Luyện Phản Xạ 24/7 | DoIT-Studio</title>
  <meta name="description"
    content="Yopolo là trợ lý luyện giao tiếp ngoại ngữ AI đa nền tảng. Khởi tạo chủ đề hàng ngày, bóc tách từ vựng, sửa lỗi ngữ pháp tức thì và lưu flashcards 1 chạm.">
  <meta name="keywords"
    content="yopolo, học ngoại ngữ ai, luyện phản xạ giao tiếp, sửa lỗi ngữ pháp, flashcard, ai language partner, gemini ai, doit studio">
  <meta name="author" content="DoIT Studio" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href="https://doitstudio.tech/yopolo/" />
  <meta name="theme-color" content="#05070B" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/yopolo/assets/yopolo-monogram.svg">
  <link rel="apple-touch-icon" href="/yopolo/assets/yopolo-icon.svg">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Yopolo" />
  <meta property="og:url" content="https://doitstudio.tech/yopolo/" />
  <meta property="og:title" content="Yopolo: Trợ Lý Ngoại Ngữ AI · Luyện Phản Xạ 24/7 | DoIT-Studio" />
  <meta property="og:description"
    content="Mở lối ngoại ngữ, tự do đối thoại cùng Trợ lý AI Deep Tech. Luyện phản xạ 15 phút mỗi ngày, sửa lỗi ngữ pháp tức thì và lưu sổ tay flashcard 1 chạm." />
  <meta property="og:image" content="https://doitstudio.tech/yopolo/assets/yopolo-og-banner.png" />
  <meta property="og:image:secure_url" content="https://doitstudio.tech/yopolo/assets/yopolo-og-banner.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Yopolo - Trợ Lý Ngoại Ngữ AI · Luyện Phản Xạ 24/7 | DoIT-Studio" />
  <meta property="og:locale" content="vi_VN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://doitstudio.tech/yopolo/" />
  <meta name="twitter:title" content="Yopolo: Trợ Lý Ngoại Ngữ AI · Luyện Phản Xạ 24/7 | DoIT-Studio" />
  <meta name="twitter:description"
    content="Mở lối ngoại ngữ, tự do đối thoại cùng Trợ lý AI Deep Tech. Luyện phản xạ 15 phút mỗi ngày, sửa lỗi ngữ pháp tức thì và lưu sổ tay flashcard 1 chạm." />
  <meta name="twitter:image" content="https://doitstudio.tech/yopolo/assets/yopolo-og-banner.png" />
  <meta name="twitter:image:alt" content="Yopolo - Trợ Lý Ngoại Ngữ AI · DoIT-Studio" />

  <!-- Google Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/yopolo/assets/design-tokens.css">
  <link rel="stylesheet" href="/yopolo/assets/yopolo-landing.css">

  <!-- Google Analytics 4 (Only loaded in Production) -->
  {import.meta.env.PROD && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-64YJ3QLMEM"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-64YJ3QLMEM', {
          page_path: window.location.pathname,
        });
      </script>
    </>
  )}

  <!-- Structured Data (JSON-LD) with SoftwareApplication, BreadcrumbList & FAQPage -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "SoftwareApplication",
        "@id": "https://doitstudio.tech/yopolo/#software",
        "name": "Yopolo: Trợ Lý Ngoại Ngữ AI",
        "operatingSystem": "iOS, Android, Web",
        "applicationCategory": "EducationalApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "VND"
        },
        "image": "https://doitstudio.tech/yopolo/assets/yopolo-og-banner.png",
        "screenshot": [
          "https://doitstudio.tech/yopolo/screenshots/1-login.jpg",
          "https://doitstudio.tech/yopolo/screenshots/2-1-onboarding-lang.jpg",
          "https://doitstudio.tech/yopolo/screenshots/2-2-onboarding-topics.jpg",
          "https://doitstudio.tech/yopolo/screenshots/2-3-onboarding-time.jpg",
          "https://doitstudio.tech/yopolo/screenshots/4-1-ai-chat-starter.jpg",
          "https://doitstudio.tech/yopolo/screenshots/4-2-ai-chat-dialog.jpg",
          "https://doitstudio.tech/yopolo/screenshots/5-notebook.jpg",
          "https://doitstudio.tech/yopolo/screenshots/3-home-profile.jpg"
        ],
        "featureList": [
          "Luyện phản xạ đàm thoại ngoại ngữ 15 phút mỗi ngày",
          "Bóc tách từ vựng & sửa lỗi ngữ pháp tức thì bằng tiếng mẹ đẻ (Tiếng Việt)",
          "Hỗ trợ 6 ngôn ngữ thông dụng: Tiếng Anh, Pháp, Trung (Pinyin), Hàn (Kính ngữ), Nhật (Romaji), Việt",
          "Đăng nhập bảo mật đa nền tảng không cần mật khẩu với mã QR Web Client",
          "Sổ tay cá nhân hóa 1 chạm & hệ thống ôn tập Flashcards thông minh",
          "Mô hình ngôn ngữ lớn Deep Tech Gemini AI 1.5 Flash phản hồi mượt mà"
        ],
        "author": {
          "@type": "Organization",
          "name": "DoIT-Studio",
          "url": "https://doitstudio.tech"
        },
        "description": "Yopolo là trợ lý luyện giao tiếp ngoại ngữ AI đa nền tảng. Khởi tạo chủ đề hàng ngày, bóc tách từ vựng, sửa lỗi ngữ pháp tức thì và lưu flashcards 1 chạm.",
        "url": "https://doitstudio.tech/yopolo/",
        "downloadUrl": "https://apps.apple.com/us/app/yopolo-luyện-ngoại-ngữ-ai/id6829576014",
        "installUrl": "https://play.google.com/store/apps/details?id=com.doitstudio.yopolo"
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Trang chủ",
            "item": "https://doitstudio.tech"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Dự án & Ứng dụng",
            "item": "https://doitstudio.tech/apps"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Yopolo",
            "item": "https://doitstudio.tech/yopolo/"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Yopolo hiện đang hỗ trợ những ngôn ngữ nào?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yopolo hỗ trợ 6 ngôn ngữ chính: Tiếng Anh, Tiếng Pháp, Tiếng Trung (kèm phiên âm Pinyin), Tiếng Hàn (chú thích kính ngữ), Tiếng Nhật (kèm Furigana/Romaji) và Tiếng Việt. Bạn có thể tự do chuyển đổi ngôn ngữ mục tiêu bất kỳ lúc nào trong phần Cài đặt Profile."
            }
          },
          {
            "@type": "Question",
            "name": "Người mới bắt đầu có học được với Yopolo không?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ứng dụng được tối ưu hóa cho trình độ từ tiền trung cấp đến trung cấp (B1-B2) nhằm kích hoạt phản xạ giao tiếp. Tuy nhiên, người mới bắt đầu vẫn hoàn toàn có thể luyện tập vì Yopolo luôn bóc tách từ vựng, ngữ pháp và giải thích cặn kẽ bằng tiếng Việt giúp bạn theo kịp nhịp đàm thoại."
            }
          },
          {
            "@type": "Question",
            "name": "Ứng dụng Yopolo có miễn phí không?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yopolo cung cấp hạn ngạch đàm thoại miễn phí mỗi ngày (25 tin nhắn/ngày), đủ để bạn hoàn thành trọn vẹn một bài học chủ đề và lưu từ vựng vào sổ tay mà không phát sinh bất kỳ chi phí nào."
            }
          },
          {
            "@type": "Question",
            "name": "Tính năng đăng nhập Web qua mã QR hoạt động như thế nào?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Khi bạn mở bản Web trên máy tính, hệ thống tạo một mã QR bảo mật phiên làm việc. Bạn chỉ cần mở app Yopolo trên điện thoại, bấm nút Quét QR Web để ủy quyền đăng nhập trong 1 giây mà không cần nhớ hay nhập mật khẩu."
            }
          },
          {
            "@type": "Question",
            "name": "Dữ liệu và nội dung trò chuyện của tôi có được bảo mật không?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Toàn bộ dữ liệu của bạn được mã hóa truyền tải an toàn qua giao thức HTTPS/TLS và lưu trữ bảo mật trên Firebase. Yopolo cam kết không bao giờ bán thông tin cá nhân hay nội dung học tập của bạn cho bất kỳ bên thứ ba nào."
            }
          }
        ]
      }
    ]
  }
  </script>
</head>

<body>
<!-- AURORA AMBIENT GLOW SYSTEM -->
  <div class="aurora-bg">
    <div class="aurora-orb orb-cyan"></div>
    <div class="aurora-orb orb-violet"></div>
    <div class="aurora-orb orb-pink"></div>
  </div>
  <div class="grid-overlay"></div>

  <!-- STICKY SITE HEADER -->
  <header class="site-header">
    <div class="container nav-container">
      <a href="/yopolo/" class="brand-logo" aria-label="Yopolo Home">
        <img src="/yopolo/assets/yopolo-logo-horizontal.svg" alt="Yopolo AI Multi-Language Partner">
      </a>

      <ul class="nav-links">
        <li><a href="#features" class="nav-link">Tính năng</a></li>
        <li><a href="#showcase" class="nav-link">Khám phá App</a></li>
        <li><a href="#web-sync" class="nav-link">Trải nghiệm Web</a></li>
        <li><a href="#reviews" class="nav-link">Đánh giá</a></li>
        <li><a href="#faq" class="nav-link">FAQ</a></li>
      </ul>

      <div class="nav-actions">
        <a href="/apps" class="btn btn-secondary nav-btn-ecosystem" style="padding: 8px 14px; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
          <span>DoIT Apps</span>
        </a>
        <a href="#download" class="btn btn-primary nav-btn-download">
          <span>Tải Ứng Dụng</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- MAIN HERO SECTION -->
  <section class="hero-section" id="hero">
    <div class="container">
      <div class="hero-grid">

        <!-- Left: Text Content -->
        <div class="hero-content">
          <div class="badge-pill hero-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path
                d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
            </svg>
            <span>AI Language Partner • Powered by Gemini 1.5</span>
          </div>

          <h1 class="hero-title">
            Luyện Phản Xạ Giao Tiếp <span class="gradient-text">24/7 Cùng Trợ Lý AI</span>
          </h1>

          <p class="hero-desc">
            Không áp lực, không sợ phán xét. Mỗi ngày mở app, Yopolo AI tự động khởi tạo chủ đề đàm thoại thực tiễn, bóc
            tách từ vựng đắt giá và sửa lỗi ngữ pháp tức thì bằng tiếng Việt.
          </p>

          <div class="hero-cta-group">
            <!-- App Store Button -->
            <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="store-btn" aria-label="Tải Yopolo trên App Store (iOS)">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 1.01-2.87-.96.04-2.14.64-2.83 1.44-.57.65-1.07 1.72-.94 2.76 1.07.08 2.14-.58 2.76-1.33z" />
              </svg>
              <div class="store-btn-text">
                <span>Tải về trên</span>
                <strong>App Store</strong>
              </div>
            </a>

            <!-- Google Play Button -->
            <a href={GOOGLE_PLAY_URL} target="_blank" rel="noopener noreferrer" class="store-btn" aria-label="Tải Yopolo trên Google Play (Android)">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M3.609 1.814L13.792 12 3.61 22.186c-.198-.225-.31-.539-.31-.886V2.7c0-.347.112-.661.31-.886zm11.235 11.238l2.257 2.257-11.45 6.495 9.193-8.752zm0-2.104L5.651 2.196l11.45 6.495-2.257 2.257zm1.488 1.052l3.414 1.936c.642.365.642.96 0 1.325l-3.414 1.936-2.106-2.106 2.106-2.091z" />
              </svg>
              <div class="store-btn-text">
                <span>Tải về trên</span>
                <strong>Google Play</strong>
              </div>
            </a>

            <!-- Web QR Trigger -->
            <a href="#web-sync" class="btn btn-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2" />
                <path d="M7 7h.01" />
                <path d="M17 7h.01" />
                <path d="M7 17h.01" />
                <path d="M17 17h.01" />
              </svg>
              <span>Quét QR Web</span>
            </a>
          </div>

          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-num">6+</div>
              <p>Ngôn ngữ mục tiêu</p>
            </div>
            <div class="stat-item">
              <div class="stat-num">B1 - B2</div>
              <p>Trình độ đàm thoại</p>
            </div>
            <div class="stat-item">
              <div class="stat-num">1 Chạm</div>
              <p>Lưu Sổ tay tức thì</p>
            </div>
          </div>
        </div>

        <!-- Right: 3D Phone Mockup with Real App Screenshot -->
        <div class="hero-visual">

          <!-- Floating Feature Badge 1 -->
          <div class="glass-card floating-card floating-card-1">
            <div class="floating-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
              </svg>
            </div>
            <div class="floating-card-text">
              <strong>+ woven themselves into</strong>
              <span>Gợi ý lưu sổ tay từ vựng</span>
            </div>
          </div>

          <!-- Floating Feature Badge 2 -->
          <div class="glass-card floating-card floating-card-2">
            <div class="floating-card-icon"
              style="background: rgba(139, 92, 246, 0.15); color: var(--yp-aurora-violet);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="m5 13 4 4L19 7" />
              </svg>
            </div>
            <div class="floating-card-text">
              <strong>Sửa lỗi ngữ pháp</strong>
              <span>Giải thích bằng tiếng Việt</span>
            </div>
          </div>

          <!-- Phone Chassis -->
          <div class="phone-mockup-wrap">
            <div class="phone-notch"></div>
            <div class="phone-screen">
              <img src="/yopolo/screenshots/4-1-ai-chat-starter.jpg" alt="Màn hình Yopolo AI Core Chatting">
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- PROBLEM VS SOLUTION -->
  <section class="problem-section" id="solution">
    <div class="container">
      <div class="section-title-wrap">
        <div class="badge-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
          </svg>
          <span>Khác biệt cốt lõi</span>
        </div>
        <h2 class="section-title">Tại sao cách học ngoại ngữ cũ <span class="gradient-text">khiến bạn ngại nói?</span>
        </h2>
        <p class="section-desc">Phần lớn người học bỏ cuộc vì thiếu môi trường giao tiếp thực tế và sợ mắc sai lầm trước
          mặt người khác.</p>
      </div>

      <div class="comparison-grid">
        <!-- Traditional Way -->
        <div class="compare-column traditional">
          <div class="column-header">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="m15 9-6 6" />
              <path d="m9 9 6 6" />
            </svg>
            <h3 style="color: #F87171;">Cách học truyền thống</h3>
          </div>
          <ul class="compare-list">
            <li class="compare-item bad">
              <div class="compare-item-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.5">
                  <path d="M18 6 6 18" />
                  <path d="m6 6 12 12" />
                </svg></div>
              <div class="compare-item-text">
                <strong>Áp lực tâm lý khi nói chuyện với người lạ</strong>
                <p>Nỗi sợ bị phán xét hoặc phát âm sai khiến bạn luôn do dự trước khi mở lời.</p>
              </div>
            </li>
            <li class="compare-item bad">
              <div class="compare-item-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.5">
                  <path d="M18 6 6 18" />
                  <path d="m6 6 12 12" />
                </svg></div>
              <div class="compare-item-text">
                <strong>Học vẹt ngữ pháp rời rạc, mau quên</strong>
                <p>Học hàng trăm công thức nhưng không có ngữ cảnh hội thoại cụ thể để áp dụng vào thực tế.</p>
              </div>
            </li>
            <li class="compare-item bad">
              <div class="compare-item-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.5">
                  <path d="M18 6 6 18" />
                  <path d="m6 6 12 12" />
                </svg></div>
