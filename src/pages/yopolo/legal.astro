  <!-- INTERACTIVE TAB & TOC CONTROLLER SCRIPT -->
  <script>
    // Tab Elements
    const tabPrivacyBtn = document.getElementById('tabPrivacyBtn');
    const tabTermsBtn = document.getElementById('tabTermsBtn');
    const privacyPane = document.getElementById('privacyPane');
    const termsPane = document.getElementById('termsPane');
    const privacyToc = document.getElementById('privacyToc');
    const termsToc = document.getElementById('termsToc');

    function switchTab(target) {
      if (target === 'terms') {
        tabPrivacyBtn.classList.remove('active');
        tabPrivacyBtn.setAttribute('aria-selected', 'false');
        tabTermsBtn.classList.add('active');
        tabTermsBtn.setAttribute('aria-selected', 'true');

        privacyPane.classList.remove('active');
        termsPane.classList.add('active');

        privacyToc.style.display = 'none';
        termsToc.style.display = 'flex';

        window.history.replaceState(null, null, '#terms');
      } else {
        tabTermsBtn.classList.remove('active');
        tabTermsBtn.setAttribute('aria-selected', 'false');
        tabPrivacyBtn.classList.add('active');
        tabPrivacyBtn.setAttribute('aria-selected', 'true');

        termsPane.classList.remove('active');
        privacyPane.classList.add('active');

        termsToc.style.display = 'none';
        privacyToc.style.display = 'flex';

        window.history.replaceState(null, null, '#privacy');
      }
    }

    tabPrivacyBtn.addEventListener('click', () => switchTab('privacy'));
    tabTermsBtn.addEventListener('click', () => switchTab('terms'));

    // Handle initial hash in URL
    function handleHash() {
      const hash = window.location.hash.toLowerCase();
      if (hash.startsWith('#terms')) {
        switchTab('terms');
      } else {
        switchTab('privacy');
      }
    }

    window.addEventListener('DOMContentLoaded', handleHash);
    window.addEventListener('hashchange', handleHash);

    // Active TOC link on scroll
    const tocLinks = document.querySelectorAll('.toc-link');
    window.addEventListener('scroll', () => {
      const activePane = privacyPane.classList.contains('active') ? privacyPane : termsPane;
      const headers = activePane.querySelectorAll('h2[id], h3[id]');
      let currentId = '';

      headers.forEach(h => {
        const rect = h.getBoundingClientRect();
        if (rect.top <= 160) {
          currentId = h.id;
        }
      });

      if (currentId) {
        tocLinks.forEach(link => {
          if (link.getAttribute('href') === '#' + currentId) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    });
  </script>
