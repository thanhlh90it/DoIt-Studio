---
// Pledgo Landing Page - DoIT Studio
// Route: /pledgo/
const GOOGLE_PLAY_URL = "https://play.google.com/store/apps/details?id=com.doitstudio.pledgo";
const APP_STORE_URL = "https://apps.apple.com/us/app/pledgo-mục-tiêu-thói-quen/id6824138142";
---
<!doctype html>
<html lang="vi" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pledgo: Bắt Trọn Mục Tiêu Năm &amp; Thói Quen 365 Ngày | DoIT-Studio</title>
  <meta name="description" content="Pledgo biến mục tiêu năm thành một khế ước danh dự 365 ngày. Tuyên thệ, khoá chỉ tiêu và hành động mỗi ngày trước dòng nước thời gian đang rút." />
  <meta name="keywords" content="pledgo, pledge and go, goal tracker, habit tracker, muc tieu nam, thoi quen, quan ly muc tieu, gamification discipline, doit studio" />
  <meta name="author" content="DoIT Studio" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href="https://doitstudio.tech/pledgo/" />
  <meta name="theme-color" content="#090A0F" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Pledgo" />
  <meta property="og:url" content="https://doitstudio.tech/pledgo/" />
  <meta property="og:title" content="Pledgo: Bắt Trọn Mục Tiêu Năm · Pledge &amp; Go" />
  <meta property="og:description" content="Own Your Year. Honor Your Pledge. Biến mục tiêu năm thành khế ước danh dự 365 ngày." />
  <meta property="og:image" content="https://doitstudio.tech/pledgo/assets/pledgo-og-banner.png" />
  <meta property="og:image:secure_url" content="https://doitstudio.tech/pledgo/assets/pledgo-og-banner.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Pledgo - Bắt Trọn Mục Tiêu Năm &amp; Khế Ước Danh Dự 365 Ngày | DoIT-Studio" />
  <meta property="og:locale" content="vi_VN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://doitstudio.tech/pledgo/" />
  <meta name="twitter:title" content="Pledgo: Bắt Trọn Mục Tiêu Năm · Pledge &amp; Go" />
  <meta name="twitter:description" content="Own Your Year. Honor Your Pledge. Biến mục tiêu năm thành khế ước danh dự 365 ngày." />
  <meta name="twitter:image" content="https://doitstudio.tech/pledgo/assets/pledgo-og-banner.png" />
  <meta name="twitter:image:alt" content="Pledgo - Bắt Trọn Mục Tiêu Năm · DoIT-Studio" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/pledgo/assets/brand/app-icon.svg" />
  <link rel="apple-touch-icon" href="/pledgo/assets/brand/app-icon.svg" />

  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Google Fonts: JetBrains Mono, Outfit, Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CDN & Custom Config for Pledgo Standalone Landing -->
  <script is:inline src="https://cdn.tailwindcss.com/3.4.16"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            void: '#090A0F',
            card: '#12151E',
            elevated: '#1A1F2C',
            hairline: '#242B3A',
            frost: '#F8FAFC',
            muted: '#94A3B8',
            bronze: { DEFAULT: '#D97706', dark: '#B45309', light: '#F59E0B' },
            cobalt: { DEFAULT: '#3B82F6', dark: '#1D4ED8', light: '#60A5FA' },
            sage: { DEFAULT: '#10B981', dark: '#059669', light: '#34D399' },
            gold: '#FDE68A',
            crimson: '#DC2626',
          },
          fontFamily: {
            heading: ['Outfit', 'sans-serif'],
            body: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
        },
      },
    };
  </script>

  <style is:inline>
    :root { color-scheme: dark; }
    body { background: #090A0F; }

    h1, h2, h3 { text-wrap: balance; }

    .text-bronze-grad {
      background: linear-gradient(100deg, #FCD34D 0%, #F59E0B 40%, #D97706 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }

    /* Ambient backdrop */
    .backdrop-glow {
      background:
        radial-gradient(60% 50% at 70% 10%, rgba(217, 119, 6, 0.16), transparent 70%),
        radial-gradient(40% 40% at 10% 30%, rgba(59, 130, 246, 0.07), transparent 70%);
    }
    .hairline-grid {
      background-image:
        linear-gradient(rgba(148, 163, 184, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(148, 163, 184, 0.05) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse at 50% 0%, #000 30%, transparent 75%);
    }

    /* Phone mockup — screenshots already include status bar + dynamic island */
    .phone {
      position: relative;
      aspect-ratio: 1206 / 2622;
      border-radius: 13% / 6%;
      padding: 3.2%;
      background: linear-gradient(145deg, #3A4152 0%, #1A1F2C 35%, #0D0F15 100%);
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.06) inset,
        0 40px 80px -20px rgba(0, 0, 0, 0.9),
        0 0 60px -10px rgba(217, 119, 6, 0.22);
    }
    .phone img {
      display: block; width: 100%; height: 100%;
      object-fit: cover; border-radius: 10.5% / 4.9%;
    }

    /* Year ring */
    .ring-today { filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.9)); }

    /* Scroll reveal (only when JS runs) */
    .js .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
    .js .reveal.is-visible { opacity: 1; transform: none; }

    /* Gallery */
    .gallery { scrollbar-width: none; }
    .gallery::-webkit-scrollbar { display: none; }

    @keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    .floaty { animation: floaty 6s ease-in-out infinite; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .js .reveal { opacity: 1; transform: none; transition: none; }
      .floaty { animation: none; }
      * { transition-duration: 0.01ms !important; }
    }
  </style>

  <!-- Google Analytics 4 (Only loaded in Production) -->
  {import.meta.env.PROD && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-64YJ3QLMEM"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-64YJ3QLMEM', {
          page_path: window.location.pathname,
        });
      </script>
    </>
  )}

  <!-- Structured Data (JSON-LD) with SoftwareApplication & BreadcrumbList -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "SoftwareApplication",
        "@id": "https://doitstudio.tech/pledgo/#software",
        "name": "Pledgo - Pledge & Go",
        "operatingSystem": "iOS, Android",
        "applicationCategory": "LifestyleApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "VND"
        },
        "image": "https://doitstudio.tech/pledgo/assets/pledgo-og-banner.png",
        "screenshot": [
          "https://doitstudio.tech/pledgo/assets/screens/year-dashboard@2x.jpg",
          "https://doitstudio.tech/pledgo/assets/screens/today@2x.jpg",
          "https://doitstudio.tech/pledgo/assets/screens/habit-goal@2x.jpg",
          "https://doitstudio.tech/pledgo/assets/screens/cumulative-goal@2x.jpg",
          "https://doitstudio.tech/pledgo/assets/screens/epic-goal@2x.jpg",
          "https://doitstudio.tech/pledgo/assets/screens/museum@2x.jpg"
        ],
        "featureList": [
          "Vòng đếm ngược năm 365 ngày thời gian thực",
          "Nghi thức khóa tuyên thệ danh dự (The Pledge Rule)",
          "Bản đồ nhiệt thói quen 12 tháng",
          "Theo dõi mục tiêu tích lũy & dự án Epic",
          "Bảo tàng cá nhân lưu giữ thành tựu vinh danh"
        ],
        "author": {
          "@type": "Organization",
          "name": "DoIT-Studio",
          "url": "https://doitstudio.tech"
        },
        "description": "Pledgo biến mục tiêu năm thành một khế ước danh dự 365 ngày. Tuyên thệ, khoá chỉ tiêu và hành động mỗi ngày trước dòng nước thời gian đang rút.",
        "url": "https://doitstudio.tech/pledgo/",
        "downloadUrl": "https://apps.apple.com/us/app/pledgo-mục-tiêu-thói-quen/id6824138142",
        "installUrl": "https://play.google.com/store/apps/details?id=com.doitstudio.pledgo"
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Trang chủ",
            "item": "https://doitstudio.tech"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Dự án & Ứng dụng",
            "item": "https://doitstudio.tech/apps"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Pledgo",
            "item": "https://doitstudio.tech/pledgo/"
          }
        ]
      }
    ]
  }
  </script>
</head>

<body class="bg-void text-frost font-body antialiased selection:bg-bronze/40">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-bronze-light focus:px-4 focus:py-2 focus:text-black" data-i18n="a11y.skip">Bỏ qua tới nội dung</a>

  <!-- ============ NAV ============ -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-hairline/70 bg-void/75 backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6" data-i18n-aria-label="a11y.nav" aria-label="Điều hướng chính">
      <div class="flex items-center gap-6">
        <a href="#top" class="group flex items-center gap-2.5 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-bronze-light" aria-label="Pledgo">
          <img src="/pledgo/assets/brand/app-icon.svg" alt="Pledgo Icon" width="32" height="32" class="h-8 w-8" />
          <span class="font-heading text-xl font-bold tracking-tight">pled<span class="text-bronze-grad">go</span></span>
        </a>
        <a href="/apps" class="hidden text-xs font-mono font-semibold text-muted/70 hover:text-frost transition-colors sm:inline-flex items-center gap-1.5 py-1 px-2.5 rounded-md border border-hairline/50 hover:border-hairline bg-card/40">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          DoIT Studio
        </a>
      </div>

      <ul class="hidden items-center gap-7 text-sm font-medium text-muted md:flex">
        <li><a href="#ritual" class="rounded transition-colors hover:text-frost focus:outline-none focus-visible:text-frost focus-visible:ring-2 focus-visible:ring-bronze-light" data-i18n="nav.ritual">Triết lý</a></li>
        <li><a href="#goals" class="rounded transition-colors hover:text-frost focus:outline-none focus-visible:text-frost focus-visible:ring-2 focus-visible:ring-bronze-light" data-i18n="nav.goals">Mục tiêu</a></li>
        <li><a href="#today" class="rounded transition-colors hover:text-frost focus:outline-none focus-visible:text-frost focus-visible:ring-2 focus-visible:ring-bronze-light" data-i18n="nav.today">Hôm nay</a></li>
        <li><a href="#museum" class="rounded transition-colors hover:text-frost focus:outline-none focus-visible:text-frost focus-visible:ring-2 focus-visible:ring-bronze-light" data-i18n="nav.museum">Bảo tàng</a></li>
      </ul>

      <div class="flex items-center gap-2 sm:gap-3">
        <div class="flex rounded-full border border-hairline bg-card p-0.5 font-mono text-xs font-bold" role="group" data-i18n-aria-label="a11y.lang" aria-label="Chọn ngôn ngữ">
          <button type="button" data-lang="vi" aria-pressed="true" class="cursor-pointer rounded-full px-2.5 py-1.5 text-muted transition-colors hover:text-frost focus:outline-none focus-visible:ring-2 focus-visible:ring-bronze-light aria-pressed:bg-bronze-light aria-pressed:text-black">VI</button>
          <button type="button" data-lang="en" aria-pressed="false" class="cursor-pointer rounded-full px-2.5 py-1.5 text-muted transition-colors hover:text-frost focus:outline-none focus-visible:ring-2 focus-visible:ring-bronze-light aria-pressed:bg-bronze-light aria-pressed:text-black">EN</button>
        </div>
        <a href="#download" class="hidden cursor-pointer rounded-full bg-bronze-light px-4 py-2 text-sm font-semibold text-black transition hover:bg-[#FBBF24] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-frost focus-visible:ring-offset-2 focus-visible:ring-offset-void sm:inline-flex" data-i18n="nav.cta">Tải app</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section id="top" class="relative overflow-hidden pt-28 sm:pt-32">
      <div class="backdrop-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="hairline-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-8 lg:pb-28">
        <div class="text-center lg:text-left">
          <p class="inline-flex items-center gap-2 rounded-full border border-bronze/40 bg-bronze/10 px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-bronze-light">
            <span class="h-1.5 w-1.5 rounded-full bg-bronze-light" aria-hidden="true"></span>
            <span data-i18n="hero.eyebrow">Pledge &amp; Go · Mục tiêu năm</span>
          </p>
          <h1 class="mt-6 font-heading text-[2.6rem] font-extrabold leading-[1.05] tracking-[-0.03em] sm:text-6xl lg:text-[3.5rem] xl:text-[3.9rem]" data-i18n-html="hero.title">
            Bắt trọn mục tiêu năm.<br /><span class="text-bronze-grad">Giữ trọn lời thề.</span>
          </h1>
          <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg lg:mx-0" data-i18n="hero.sub">
            Pledgo biến mục tiêu thành một khế ước danh dự 365 ngày. Tuyên thệ một lần, khoá chỉ tiêu, và hành động mỗi ngày trước dòng nước thời gian đang rút.
          </p>

          <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
            <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="store-badge group inline-flex w-full max-w-[220px] cursor-pointer items-center gap-3 rounded-2xl bg-bronze-light px-5 py-3 text-black transition hover:-translate-y-0.5 hover:bg-[#FBBF24] hover:shadow-[0_12px_30px_-10px_rgba(245,158,11,0.7)] active:translate-y-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-frost focus-visible:ring-offset-2 focus-visible:ring-offset-void sm:w-auto" aria-label="Tải Pledgo trên App Store">
              <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 1.43c0 1.14-.5 2.27-1.18 3.08-.74.9-1.99 1.57-2.99 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.57-2.27 1.2-2.98.81-.94 2.15-1.64 3.25-1.68.03.13.06.28.06.43Zm4.56 15.71c-.03.07-.46 1.58-1.52 3.12-.94 1.34-1.94 2.71-3.43 2.71-1.52 0-1.9-.88-3.63-.88-1.7 0-2.3.91-3.67.91-1.38 0-2.33-1.26-3.43-2.8-1.29-1.82-2.32-4.63-2.32-7.28 0-4.28 2.8-6.55 5.55-6.55 1.45 0 2.67.95 3.6.95.86 0 2.22-1.01 3.9-1.01.61 0 2.89.06 4.37 2.19-.13.09-2.38 1.37-2.38 4.19 0 3.26 2.85 4.42 2.96 4.45Z"/></svg>
              <span class="flex flex-col text-left leading-tight">
                <span class="text-[11px] font-medium" data-i18n="store.iosTop">Tải về trên</span>
                <span class="font-heading text-lg font-bold">App Store</span>
              </span>
            </a>
            <a href={GOOGLE_PLAY_URL} target="_blank" rel="noopener noreferrer" class="store-badge group inline-flex w-full max-w-[220px] cursor-pointer items-center gap-3 rounded-2xl border border-hairline bg-card px-5 py-3 text-frost transition hover:-translate-y-0.5 hover:border-bronze-light/70 active:translate-y-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-bronze-light focus-visible:ring-offset-2 focus-visible:ring-offset-void sm:w-auto" aria-label="Tải Pledgo trên Google Play">
              <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M3.6 1.8 13.8 12 3.6 22.2c-.37-.2-.6-.6-.6-1.1V2.9c0-.5.23-.9.6-1.1Z"/><path fill="#34A853" d="M3.6 1.8c.3-.17.7-.18 1.08.03L16.9 8.9 13.8 12Z"/><path fill="#EA4335" d="M3.6 22.2 13.8 12l3.1 3.1-12.22 7.07c-.38.21-.78.2-1.08.03Z"/><path fill="#FBBC04" d="m16.9 8.9 3.7 2.14c.86.5.86 1.42 0 1.92l-3.7 2.14L13.8 12Z"/></svg>
              <span class="flex flex-col text-left leading-tight">
                <span class="text-[11px] font-medium text-muted" data-i18n="store.playTop">Tải về trên</span>
                <span class="font-heading text-lg font-bold">Google Play</span>
              </span>
            </a>
          </div>

          <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-muted lg:justify-start">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span data-i18n="hero.trust1">iOS &amp; Android</span></li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span data-i18n="hero.trust2">Đồng bộ đám mây</span></li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span data-i18n="hero.trust3">Đăng nhập Google</span></li>
          </ul>
        </div>

        <!-- Hero visual: 365-tick year ring + phone -->
        <div class="relative mx-auto aspect-[3/4] w-full max-w-[600px] sm:aspect-square">
          <svg id="year-ring" class="absolute inset-0 h-full w-full" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid meet" role="img" data-i18n-aria-label="hero.ringLabel" aria-label="Vòng 365 ngày của năm"></svg>

          <div class="phone floaty absolute left-1/2 top-1/2 h-[92%] -translate-x-1/2 -translate-y-1/2">
            <img src="/pledgo/assets/screens/year-dashboard.jpg" srcset="/pledgo/assets/screens/year-dashboard.jpg 600w, /pledgo/assets/screens/year-dashboard@2x.jpg 1206w" sizes="(min-width: 1024px) 270px, 45vw" width="600" height="1304" alt="Màn hình Năm của Pledgo: đếm ngược ngày còn lại, vòng tiến độ 12 tháng" data-i18n-alt="alt.year" fetchpriority="high" />
          </div>

          <!-- Live countdown chip -->
          <div class="absolute bottom-[4%] left-1/2 z-10 w-max -translate-x-1/2 rounded-2xl border border-hairline bg-elevated/90 px-4 py-2.5 shadow-2xl backdrop-blur sm:bottom-[6%] sm:left-auto sm:right-[-2%] sm:translate-x-0">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-muted" data-i18n="hero.liveLabel">Đếm ngược thời gian thực</p>
            <p class="mt-1 flex items-baseline gap-2">
              <span id="cd-days" class="font-heading text-3xl font-extrabold tracking-tight text-frost">--</span>
              <span class="text-sm text-muted"><span data-i18n="hero.daysLeft">ngày còn lại</span> · <span id="cd-year">2026</span></span>
            </p>
          </div>

          <div class="absolute left-[-1%] top-[16%] z-10 hidden items-center gap-2 rounded-full border border-bronze/50 bg-void/85 px-3 py-1.5 backdrop-blur sm:flex">
