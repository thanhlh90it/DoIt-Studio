---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Giới thiệu - DoIT Studio Specs" description="Nền tảng phát triển ứng dụng web hiện đại, tối ưu tốc độ và trải nghiệm người dùng.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12 font-mono">
      <span class="px-3.5 py-1 rounded-md bg-blue-600/20 text-cyan-300 border border-cyan-400/30 text-xs font-bold">
        // STUDIO_SYSTEM_SPECIFICATIONS
      </span>
      <h1 class="font-tech text-4xl font-black text-white mt-4 mb-4 tracking-tight">Về DoIT-Studio</h1>
      <p class="text-slate-400 text-lg max-w-xl mx-auto leading-relaxed font-['Plus_Jakarta_Sans',sans-serif]">Nền tảng phát triển ứng dụng web hiện đại, tối ưu tốc độ và trải nghiệm người dùng.</p>
    </div>

    <div class="space-y-6">
      <div class="glass-card hud-corners p-8 rounded-2xl border border-slate-800 shadow-xl">
        <h2 class="font-tech text-xl font-bold text-cyan-400 mb-4 flex items-center gap-2">
          <span>🛠️ Công Nghệ Cốt Lõi (Core Specs)</span>
        </h2>
        <ul class="space-y-4 text-slate-300 text-sm font-mono">
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-md bg-blue-600/20 text-cyan-300 border border-cyan-400/30 flex items-center justify-center font-bold text-xs shrink-0">✓</span>
            <span><strong>Astro 5+</strong> (Static Site Generation - SSG với tốc độ vượt trội)</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-md bg-blue-600/20 text-cyan-300 border border-cyan-400/30 flex items-center justify-center font-bold text-xs shrink-0">✓</span>
            <span><strong>Tailwind CSS v4</strong> với Space Grotesk & Glassmorphism HUD utilities</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-md bg-blue-600/20 text-cyan-300 border border-cyan-400/30 flex items-center justify-center font-bold text-xs shrink-0">✓</span>
            <span><strong>MDX (@astrojs/mdx)</strong> viết bài viết tương tác & lưu trữ tri thức</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-md bg-blue-600/20 text-cyan-300 border border-cyan-400/30 flex items-center justify-center font-bold text-xs shrink-0">✓</span>
            <span><strong>Space Grotesk + JetBrains Mono</strong> Typography System</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</MainLayout>
