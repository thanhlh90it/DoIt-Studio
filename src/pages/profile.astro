---
import MainLayout from '../layouts/MainLayout.astro';

const skillGroups = [
  { category: 'Frontend Ecosystem', icon: '⚡', items: ['Astro 5', 'Tailwind CSS v4', 'TypeScript', 'React.js', 'Next.js', 'Vue.js'] },
  { category: 'Backend & Cloud', icon: '📡', items: ['Node.js', 'REST APIs', 'Cloudflare Workers', 'Static Site Generation', 'Git & CI/CD'] },
  { category: 'Architecture & Design', icon: '🧩', items: ['Cybernetic UI/UX', 'HUD Design Tokens', 'PKM & Knowledge Graph', 'Agile Engineering'] },
];

const timeline = [
  {
    year: '2024 - PRESENT',
    role: 'Founder & Principal Engineer — DoIT-Studio',
    desc: 'Tập trung nghiên cứu, thiết kế và phát triển các sản phẩm phần mềm tinh gọn, hiện đại và tối ưu hiệu suất trải nghiệm người dùng.'
  },
  {
    year: '2022 - 2024',
    role: 'Senior Frontend Engineer',
    desc: 'Phát triển hệ thống Design System quy mô lớn và ứng dụng Web App phục vụ hàng triệu truy cập hàng tháng.'
  },
  {
    year: '2020 - 2022',
    role: 'Web Developer & UI Designer',
    desc: 'Thiết kế giao diện và xây dựng trang web thương mại cho các dự án khởi nghiệp công nghệ.'
  }
];
---

<MainLayout title="Trang Cá Nhân | DoIT-Studio Telemetry" description="Thông tin giới thiệu cá nhân, kỹ năng chuyên môn và hành trình sáng tạo tại DoIT-Studio.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 w-full">
    <!-- Profile Banner & Cyber HUD Bio Card -->
    <div class="glass-card hud-corners p-5 sm:p-8 md:p-10 rounded-2xl mb-10 sm:mb-14 relative overflow-hidden flex flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8 text-center md:text-left border border-blue-900/60 shadow-2xl">
      <!-- Ambient Laser Glow -->
      <div class="absolute -top-16 -left-16 w-48 sm:w-60 h-48 sm:h-60 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Cyber Avatar Ring -->
      <div class="relative shrink-0">
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-gradient-to-tr from-blue-700 via-blue-600 to-cyan-400 p-0.5 shadow-2xl shadow-cyan-500/40">
          <div class="w-full h-full bg-black rounded-[14px] flex items-center justify-center text-white font-tech font-bold text-2xl sm:text-3xl tracking-wider">
            TL
          </div>
        </div>
        <span class="absolute -bottom-1 -right-1 flex h-4 w-4">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-4 w-4 bg-cyan-400 border-2 border-black"></span>
        </span>
      </div>

      <div class="flex-grow z-10 font-mono w-full">
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5 sm:gap-3 mb-2">
          <h1 class="font-tech text-2xl sm:text-3xl font-bold text-white tracking-tight">Thành Lê</h1>
          <span class="px-2.5 sm:px-3 py-1 rounded-md text-[9px] sm:text-[10px] font-bold bg-cyan-500/15 text-cyan-300 border border-cyan-400/40 uppercase tracking-widest">
            AVAILABLE_FOR_PROJECTS
          </span>
        </div>

        <p class="text-cyan-400 font-bold text-[11px] sm:text-xs mb-3 sm:mb-4">
          SOFTWARE DEVELOPER & CREATOR // DOIT-STUDIO
        </p>

        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6 max-w-xl font-['Plus_Jakarta_Sans',sans-serif]">
          Xin chào! Tôi là một nhà phát triển phần mềm đam mê sự tối giản và hiệu quả. Tại DoIT-Studio, tôi tập trung biến các ý tưởng phức tạp thành những trải nghiệm số mượt mà, tiện dụng và trực quan.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-3 w-full sm:w-auto">
          <a href="mailto:contact@doit.studio" class="w-full sm:w-auto text-center px-5 py-2.5 rounded-xl bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-600 text-white text-xs font-bold shadow-lg shadow-blue-600/40 border border-cyan-400/40 hover:scale-[1.02] transition-all">
            ✉️ SEND_DIRECT_EMAIL
          </a>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto text-center px-5 py-2.5 rounded-xl glass-card text-slate-200 text-xs font-bold border border-slate-800 hover:bg-slate-900 transition-all">
            GITHUB_PROFILE ↗
          </a>
        </div>
      </div>
    </div>

    <!-- Skills Matrix Section -->
    <div class="mb-12 sm:mb-16 font-mono w-full">
      <div class="flex items-center justify-between mb-6 sm:mb-8">
        <div>
          <span class="text-[10px] sm:text-xs font-bold text-cyan-400 uppercase tracking-widest">
            // TECHNICAL_EXPERTISE_MATRIX
          </span>
          <h2 class="font-tech text-xl sm:text-2xl font-bold text-white mt-1">Kỹ Năng & Công Nghệ</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {skillGroups.map((group) => (
          <div class="glass-card hud-corners p-5 sm:p-6 rounded-2xl border border-slate-800 hover:border-cyan-400/50 transition-colors">
            <div class="flex items-center gap-2 mb-3 sm:mb-4">
              <span class="text-lg sm:text-xl">{group.icon}</span>
              <h3 class="text-xs font-bold text-cyan-300 uppercase tracking-wider">
                {group.category}
              </h3>
            </div>
            <div class="flex flex-wrap gap-1.5 sm:gap-2">
              {group.items.map((skill) => (
                <span class="text-[10px] sm:text-[11px] font-medium px-2 sm:px-2.5 py-1 rounded-md bg-black text-slate-300 border border-slate-800">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Career Circuit Timeline Section -->
    <div class="font-mono w-full">
      <div class="mb-6 sm:mb-8">
        <span class="text-[10px] sm:text-xs font-bold text-cyan-400 uppercase tracking-widest">
          // CAREER_CIRCUIT_TIMELINE
        </span>
        <h2 class="font-tech text-xl sm:text-2xl font-bold text-white mt-1">Hành Trình Phát Triển</h2>
      </div>

      <div class="space-y-4 sm:space-y-6 relative pl-7 sm:pl-10 before:absolute before:inset-0 before:left-3 sm:before:left-4 before:w-0.5 before:bg-gradient-to-b before:from-cyan-400 before:via-blue-600 before:to-slate-900">
        {timeline.map((item) => (
          <div class="relative">
            <div class="absolute -left-7 sm:-left-10 top-2 w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-black border-2 border-cyan-400 flex items-center justify-center shadow-md shadow-cyan-500/50">
              <div class="w-1.5 h-1.5 rounded-full bg-cyan-400"></div>
            </div>

            <div class="glass-card hud-corners p-5 sm:p-6 rounded-2xl border border-slate-800 hover:border-cyan-400/50 transition-colors">
              <span class="text-[9px] sm:text-[10px] font-bold text-cyan-300 px-2 sm:px-2.5 py-0.5 rounded bg-blue-600/20 border border-cyan-400/30">
                {item.year}
              </span>
              <h3 class="font-tech text-base sm:text-lg font-bold text-white mt-2 mb-1.5 sm:mb-2">{item.role}</h3>
              <p class="text-slate-400 text-xs sm:text-sm leading-relaxed font-['Plus_Jakarta_Sans',sans-serif]">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
