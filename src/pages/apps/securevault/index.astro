          class="sv-btn-playstore"
          style="width: 100%; justify-content: center; padding: 13px 20px; font-size: 14px;"
        >
          <span id="js-modal-btn-text">Mở trên Google Play Store</span>
        </a>

        <button
          type="button"
          class="sv-btn-outline js-copy-link-btn"
          id="js-modal-copy-btn"
          data-url={PLAY_STORE_URL}
          style="width: 100%; justify-content: center; padding: 12px 20px; font-size: 13px;"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          <span class="js-copy-text">Sao chép liên kết</span>
        </button>
      </div>

      <div id="js-modal-id-text" style="margin-top: 16px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #64748B;">
        ID: <span style="color: var(--sv-cyan);">com.thanhle.securevault</span>
      </div>
    </div>
  </div>

  <!-- ========================================================================
       CLIENT-SIDE INTERACTIVITY SCRIPTS
       ======================================================================== -->
  <script is:inline define:vars={{ PLAY_STORE_URL, APP_STORE_URL }}>
    (function () {
      const qrModal = document.getElementById('sv-qr-modal');

      function openModal(modal) {
        if (!modal) return;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal(modal) {
        if (!modal) return;
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      // Open QR modal
      document.querySelectorAll('.js-open-qr-modal').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openModal(qrModal);
        });
      });

      // Close QR modal
      document.querySelectorAll('.js-close-qr-modal').forEach((btn) => {
        btn.addEventListener('click', () => closeModal(qrModal));
      });

      // Backdrop click
      if (qrModal) {
        qrModal.addEventListener('click', (e) => {
          if (e.target === qrModal) {
            closeModal(qrModal);
          }
        });
      }

      // Escape key to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal(qrModal);
        }
      });

      // Platform configs
      const configs = {
        android: {
          url: PLAY_STORE_URL,
          qr: '/securevault/qr-playstore.svg',
          badgeText: 'GOOGLE PLAY OFFICIAL STORE',
          title: 'Cài đặt trực tiếp trên Android',
          desc: 'Tương thích tối ưu cho các thiết bị Android 10 trở lên. Hỗ trợ chặn quay màn hình và xác thực vân tay Touch ID / Face Unlock.',
          btnText: 'Mở Google Play Store',
          btnClass: 'sv-btn-playstore',
          id: 'com.thanhle.securevault'
        },
        ios: {
          url: APP_STORE_URL,
          qr: '/securevault/qr-appstore.svg',
          badgeText: 'APPLE APP STORE OFFICIAL',
          title: 'Cài đặt trực tiếp trên iPhone / iPad',
          desc: 'Tương thích tối ưu cho iOS 16.0 trở lên. Hỗ trợ xác thực Face ID, Touch ID và bảo vệ dữ liệu bằng App Sandbox.',
          btnText: 'Mở Apple App Store',
          btnClass: 'sv-btn-appstore',
          id: 'id6800250737'
        }
      };

      // Terminal Tab Switcher
      const terminalTabs = document.querySelectorAll('.js-terminal-tab');
      const terminalQrImg = document.getElementById('js-terminal-qr-img');
      const terminalBadge = document.getElementById('js-terminal-badge');
      const terminalTitle = document.getElementById('js-terminal-title');
      const terminalDesc = document.getElementById('js-terminal-desc');
      const terminalLink = document.getElementById('js-terminal-link');
      const terminalBtnText = document.getElementById('js-terminal-btn-text');
      const terminalCopyBtn = document.getElementById('js-terminal-copy-btn');
      const terminalIdText = document.getElementById('js-terminal-id-text');

      terminalTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const platform = tab.getAttribute('data-platform') || 'android';
          terminalTabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');

          const cfg = configs[platform];
          if (!cfg) return;

          if (terminalQrImg) terminalQrImg.src = cfg.qr;
          if (terminalBadge) {
            terminalBadge.querySelector('span:last-child').textContent = cfg.badgeText;
          }
          if (terminalTitle) terminalTitle.textContent = cfg.title;
          if (terminalDesc) terminalDesc.textContent = cfg.desc;
          if (terminalLink) {
            terminalLink.href = cfg.url;
            terminalLink.className = cfg.btnClass;
          }
          if (terminalBtnText) terminalBtnText.textContent = cfg.btnText;
          if (terminalCopyBtn) terminalCopyBtn.setAttribute('data-url', cfg.url);
          if (terminalIdText) terminalIdText.textContent = cfg.id;
        });
      });

      // Modal Tab Switcher
      const modalTabs = document.querySelectorAll('.js-modal-tab');
      const modalQrImg = document.getElementById('js-modal-qr-img');
      const modalLink = document.getElementById('js-modal-link');
      const modalBtnText = document.getElementById('js-modal-btn-text');
      const modalCopyBtn = document.getElementById('js-modal-copy-btn');
      const modalIdText = document.getElementById('js-modal-id-text');

      modalTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const platform = tab.getAttribute('data-platform') || 'android';
          modalTabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');

          const cfg = configs[platform];
          if (!cfg) return;

          if (modalQrImg) modalQrImg.src = cfg.qr;
          if (modalLink) {
            modalLink.href = cfg.url;
            modalLink.className = cfg.btnClass;
            modalLink.style.width = '100%';
            modalLink.style.justifyContent = 'center';
            modalLink.style.padding = '13px 20px';
          }
          if (modalBtnText) modalBtnText.textContent = cfg.btnText;
          if (modalCopyBtn) modalCopyBtn.setAttribute('data-url', cfg.url);
          if (modalIdText) {
            modalIdText.innerHTML = `ID: <span style="color: var(--sv-cyan);">${cfg.id}</span>`;
          }
        });
      });

      // Copy link buttons
      document.querySelectorAll('.js-copy-link-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          const url = btn.getAttribute('data-url') || PLAY_STORE_URL;
          const textEl = btn.querySelector('.js-copy-text');
          try {
            await navigator.clipboard.writeText(url);
            if (textEl) {
              const oldText = textEl.textContent;
              textEl.textContent = 'Đã sao chép liên kết!';
              btn.style.borderColor = 'rgba(74, 222, 128, 0.6)';
              btn.style.color = '#4ADE80';
              setTimeout(() => {
                textEl.textContent = oldText;
                btn.style.borderColor = '';
                btn.style.color = '';
              }, 2000);
            }
          } catch (err) {
            console.error('Clipboard copy failed:', err);
          }
        });
      });
    })();
  </script>
</MainLayout>
