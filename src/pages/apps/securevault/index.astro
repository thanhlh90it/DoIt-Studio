---
import MainLayout from '../../../layouts/MainLayout.astro';

const PLAY_STORE_URL = "https://play.google.com/store/apps/details?id=com.thanhle.securevault";
const APP_STORE_URL = "https://apps.apple.com/us/app/securevault-ẩn-ảnh-mật-khẩu/id6800250737";
---

<MainLayout
  title="SecureVault – Két Sắt Số Cá Nhân & Quản Lý Mật Khẩu | DoIT-Studio"
  description="Két sắt cá nhân đa năng bảo vệ hình ảnh, video riêng tư và quản lý mật khẩu an toàn. 100% cục bộ, mã hóa đầu cuối AES-256-GCM, Zero-Knowledge. Đã chính thức có mặt trên App Store & Google Play."
>
  <!-- ========================================================
       GLOBAL STYLES – SecureVault Landing (UI/UX Pro Max)
  ======================================================== -->
  <style>
    /* ── Design tokens ── */
    :root {
      --sv-black:         #000000;
      --sv-space:         #070B14;
      --sv-card:          #0D1525;
      --sv-card-hover:    #121E36;
      --sv-cyan:          #00F0FF;
      --sv-blue:          #007AFF;
      --sv-emerald:       #10B981;
      --sv-body:          #94A3B8;
      --sv-white:         #FFFFFF;
      --sv-border:        rgba(0, 240, 255, 0.16);
      --sv-border-subtle: rgba(255, 255, 255, 0.08);
      --sv-glow-c:        rgba(0, 240, 255, 0.28);
      --sv-glow-b:        rgba(0, 122, 255, 0.22);
    }

    /* ── Reset & Typography ── */
    .sv-page * { box-sizing: border-box; }
    .sv-page {
      font-family: 'Space Grotesk', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--sv-white);
      background: var(--sv-black);
      overflow-x: hidden;
    }

    /* ── Glassmorphism card ── */
    .sv-glass {
      background: rgba(13, 21, 37, 0.72);
      border: 1px solid var(--sv-border);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .sv-glass-hover {
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.25s ease;
    }
    .sv-glass-hover:hover {
      transform: translateY(-4px);
      border-color: rgba(0, 240, 255, 0.35);
      box-shadow: 0 16px 40px rgba(0, 240, 255, 0.12);
    }

    /* ── Glowing Typography ── */
    .sv-glow-text {
      color: var(--sv-cyan);
      text-shadow: 0 0 20px rgba(0, 240, 255, 0.55), 0 0 44px rgba(0, 240, 255, 0.2);
    }
    .sv-glow-emerald {
      color: #34D399;
      text-shadow: 0 0 20px rgba(52, 211, 153, 0.5);
    }

    /* ── Primary Action Buttons ── */
    .sv-btn-appstore {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px 24px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 15px;
      background: #FFFFFF;
      color: #000000;
      border: 1px solid #FFFFFF;
      cursor: pointer;
      text-decoration: none;
      box-shadow: 0 0 24px rgba(255, 255, 255, 0.25), 0 4px 16px rgba(0, 0, 0, 0.5);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sv-btn-appstore:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 36px rgba(255, 255, 255, 0.45), 0 8px 24px rgba(0, 0, 0, 0.6);
    }

    .sv-btn-playstore {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px 24px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 15px;
      background: linear-gradient(135deg, #00C6FF 0%, #007AFF 100%);
      color: #000000;
      border: none;
      cursor: pointer;
      text-decoration: none;
      box-shadow: 0 0 28px rgba(0, 240, 255, 0.35), 0 4px 20px rgba(0, 122, 255, 0.4);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sv-btn-playstore:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 40px rgba(0, 240, 255, 0.6), 0 8px 28px rgba(0, 122, 255, 0.6);
    }

    .sv-btn-outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: 14px;
      font-weight: 600;
      font-size: 14px;
      background: rgba(0, 240, 255, 0.05);
      color: var(--sv-cyan);
      border: 1.5px solid rgba(0, 240, 255, 0.4);
      cursor: pointer;
      text-decoration: none;
      transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }
    .sv-btn-outline:hover {
      background: rgba(0, 240, 255, 0.12);
      transform: translateY(-2px);
      box-shadow: 0 0 24px rgba(0, 240, 255, 0.3);
    }

    /* ── Chips and Badges ── */
    .sv-chip {
      display: inline-block;
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: rgba(0, 240, 255, 0.08);
      color: var(--sv-cyan);
      border: 1px solid rgba(0, 240, 255, 0.25);
      font-family: 'JetBrains Mono', monospace;
    }

    /* ── Icon Box ── */
    .sv-icon-box {
      width: 52px;
      height: 52px;
      border-radius: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 240, 255, 0.08);
      border: 1px solid rgba(0, 240, 255, 0.22);
      box-shadow: 0 0 20px rgba(0, 240, 255, 0.1);
      flex-shrink: 0;
    }

    /* ── Realistic Smartphone Frame ── */
    .sv-phone-frame {
      position: relative;
      width: 100%;
      max-width: 270px;
      margin: 0 auto;
      background: #0B0F19;
      border-radius: 42px;
      padding: 10px;
      border: 2.5px solid rgba(0, 240, 255, 0.3);
      box-shadow: 0 0 40px rgba(0, 240, 255, 0.18),
                  0 24px 60px rgba(0, 0, 0, 0.8),
                  inset 0 0 0 1.5px rgba(255, 255, 255, 0.12);
    }

    .sv-phone-screen {
      position: relative;
      border-radius: 34px;
      overflow: hidden;
      background: #000000;
      aspect-ratio: 1224 / 2700;
      box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.5);
    }

    .sv-phone-screen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Dynamic Island pill on phone */
    .sv-phone-island {
      position: absolute;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 20px;
      background: #000000;
      border-radius: 20px;
      z-index: 10;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Phone reflection line */
    .sv-phone-glare {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 50%;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, transparent 60%);
      pointer-events: none;
      z-index: 5;
    }

    /* ── Circuit BG overlay ── */
    .sv-circuit-bg {
      position: absolute;
      inset: 0;
      background-image: url('/securevault/digital-bg.webp');
      background-size: cover;
      background-position: center;
      opacity: 0.1;
      pointer-events: none;
    }

    /* ── Animations ── */
    @keyframes sv-pulse-ring {
      0% { box-shadow: 0 0 0 0 rgba(0, 240, 255, 0.5); }
      70% { box-shadow: 0 0 0 14px rgba(0, 240, 255, 0); }
      100% { box-shadow: 0 0 0 0 rgba(0, 240, 255, 0); }
    }
    .sv-pulse { animation: sv-pulse-ring 2.2s ease-out infinite; }

    @keyframes sv-float {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(-8px); }
    }
    .sv-float { animation: sv-float 4s ease-in-out infinite; }

    @keyframes sv-scanline {
      0% { transform: translateY(-100%); opacity: 0; }
      50% { opacity: 0.8; }
      100% { transform: translateY(200%); opacity: 0; }
    }
    .sv-scanner-beam {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #00F0FF, transparent);
      box-shadow: 0 0 10px #00F0FF;
      animation: sv-scanline 3.2s ease-in-out infinite;
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .sv-pulse, .sv-float, .sv-scanner-beam { animation: none !important; }
    }

    /* ── Modal overlay ── */
    .sv-modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .sv-modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    .sv-modal-card {
      background: #0B111E;
      border: 1.5px solid rgba(0, 240, 255, 0.4);
      border-radius: 28px;
      padding: 34px 28px;
      max-width: 480px;
      width: 100%;
      box-shadow: 0 0 50px rgba(0, 240, 255, 0.2), 0 20px 40px rgba(0, 0, 0, 0.8);
      position: relative;
      transform: scale(0.96) translateY(10px);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      text-align: center;
    }
    .sv-modal-overlay.active .sv-modal-card {
      transform: scale(1) translateY(0);
    }
    .sv-modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 36px;
      height: 36px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #94A3B8;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .sv-modal-close:hover {
      background: rgba(239, 68, 68, 0.15);
      border-color: rgba(239, 68, 68, 0.4);
      color: #F87171;
    }

    /* ── Tab Switcher in Modal & Terminal ── */
    .sv-tab-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid transparent;
      background: rgba(255, 255, 255, 0.05);
      color: var(--sv-body);
      transition: all 0.2s ease;
    }
    .sv-tab-btn.active {
      background: rgba(0, 240, 255, 0.12);
      border-color: rgba(0, 240, 255, 0.5);
      color: var(--sv-cyan);
      box-shadow: 0 0 16px rgba(0, 240, 255, 0.18);
    }

    /* ── Responsive helpers ── */
    .sv-section { padding: 84px 0; }
    .sv-container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
    @media (max-width: 900px) {
      .sv-section { padding: 56px 0; }
      .sv-hero-grid { grid-template-columns: 1fr !important; gap: 48px !important; text-align: center; }
      .sv-hero-art { margin: 0 auto; }
      .sv-cta-group { justify-content: center !important; }
      .sv-trust-group { justify-content: center !important; }
      .sv-feature-grid { grid-template-columns: 1fr !important; gap: 36px !important; }
      .sv-feature-grid.reverse > div:first-child { order: 2 !important; }
    }
  </style>

  <div class="sv-page">

    <!-- ============================================================
         BACK BREADCRUMB
    ============================================================ -->
    <div class="sv-container pt-6 pb-0">
      <a href="/apps" class="inline-flex items-center gap-2 text-sm font-mono text-slate-400 hover:text-cyan-300 transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        ← Ý Tưởng &amp; Dự Án
      </a>
    </div>

    <!-- ============================================================
         SECTION 1 – HERO
    ============================================================ -->
    <section class="sv-section relative overflow-hidden" style="padding-top: 48px; padding-bottom: 96px;">
      <!-- Circuit board background -->
      <div class="sv-circuit-bg" aria-hidden="true"></div>
      <!-- Glow orbs -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[760px] h-[440px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse at center, rgba(0,240,255,.13) 0%, transparent 70%); filter: blur(50px);" aria-hidden="true"></div>
      <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(0,122,255,.16) 0%, transparent 70%); filter: blur(70px);" aria-hidden="true"></div>

      <div class="sv-container relative z-10">
        <div class="sv-hero-grid" style="display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items: center;">

          <!-- LEFT: Copy & CTAs -->
          <div>
            <!-- Status badge -->
            <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.35); margin-bottom: 24px;">
              <span class="sv-pulse" style="width: 8px; height: 8px; border-radius: 50%; background: #10B981; display: inline-block;"></span>
              <span style="font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #34D399; font-family: 'JetBrains Mono', monospace;">Official Launch · App Store &amp; Google Play</span>
            </div>

            <h1 style="font-size: clamp(2.1rem, 5vw, 3.6rem); font-weight: 900; line-height: 1.1; letter-spacing: -.025em; margin-bottom: 22px;">
              Két Sắt Số Cá Nhân &amp;<br>
              <span class="sv-glow-text">Quản Lý Mật Khẩu</span><br>
              Bảo Mật Tuyệt Đối.
            </h1>

            <p style="font-size: 17px; line-height: 1.7; color: var(--sv-body); margin-bottom: 36px; max-width: 520px;">
              Giải pháp All-in-one bảo vệ hình ảnh, video riêng tư và quản lý tài khoản mật. Vận hành <strong style="color: var(--sv-white);">100% cục bộ</strong> với mã hóa đầu cuối <strong style="color: var(--sv-cyan);">Client-side AES-256-GCM</strong>. Không máy chủ trung gian, không thu thập dữ liệu.
            </p>

            <!-- Dual Store CTA Buttons Group -->
            <div class="sv-cta-group" style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 38px; align-items: center;">
              <!-- App Store (iOS Link) -->
              <a
                href={APP_STORE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="sv-btn-appstore"
                aria-label="Tải SecureVault trên Apple App Store"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98l-.09.06c-.22.14-2.19 1.3-2.17 3.87.02 3.08 2.69 4.11 2.72 4.12l-.1.09M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                <span>App Store</span>
              </a>

              <!-- Google Play Store Link -->
              <a
                href={PLAY_STORE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="sv-btn-playstore"
                aria-label="Tải SecureVault trên Google Play Store"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199a1 1 0 01.003 1.725l-2.232 1.29L13.2 10.26l1.63-1.628 2.869 1.876zM5.864 2.658L16.8 8.99l-2.302 2.302-8.635-8.634z"/></svg>
                <span>Google Play</span>
              </a>

              <!-- QR Code Trigger -->
              <button
                type="button"
                class="sv-btn-outline js-open-qr-modal"
                aria-label="Mở mã QR quét tải SecureVault"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" rx="1"/>
                  <rect x="14" y="3" width="7" height="7" rx="1"/>
                  <rect x="14" y="14" width="7" height="7" rx="1"/>
                  <rect x="3" y="14" width="7" height="7" rx="1"/>
                  <path d="M7 7h.01M17 7h.01M7 17h.01M17 17h.01"/>
                </svg>
                <span>Quét mã QR</span>
              </button>
            </div>

            <!-- Trust badges -->
            <div class="sv-trust-group" style="display: flex; flex-wrap: wrap; gap: 20px; align-items: center;">
              <div style="display: flex; align-items: center; gap: 7px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span style="font-size: 13px; color: var(--sv-body);">100% Cục bộ (Zero-Knowledge)</span>
              </div>
              <div style="display: flex; align-items: center; gap: 7px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                <span style="font-size: 13px; color: var(--sv-body);">AES-256-GCM &amp; SQLCipher</span>
              </div>
              <div style="display: flex; align-items: center; gap: 7px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2a10 10 0 0 0-10 10c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34"/></svg>
                <span style="font-size: 13px; color: var(--sv-body);">Face ID / Touch ID &lt; 1s</span>
              </div>
            </div>
          </div>

          <!-- RIGHT: App visual showcase (Realistic Phone Mockup) -->
          <div class="sv-hero-art" style="position: relative; display: flex; justify-content: center; align-items: center;">
            <!-- Outer Glow Halo -->
            <div style="position: absolute; width: 320px; height: 320px; border-radius: 50%; background: radial-gradient(circle, rgba(0,240,255,.2) 0%, rgba(0,122,255,.1) 50%, transparent 70%); filter: blur(30px); pointer-events: none;" aria-hidden="true"></div>

            <!-- Background Secondary Phone (Tilted/Offset) -->
            <div style="position: absolute; right: 0; transform: rotate(8deg) translate(28px, -15px) scale(0.9); opacity: 0.7; z-index: 1;" class="sv-hero-bg-phone">
              <div class="sv-phone-frame" style="max-width: 230px;">
                <div class="sv-phone-island"></div>
                <div class="sv-phone-screen">
                  <img
                    src="/securevault/screenshots/start.webp"
                    alt="Màn hình khởi động SecureVault"
                    width="230"
                    height="507"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              </div>
            </div>

            <!-- Primary Phone in Front (Face ID / PIN code / Passwords) -->
            <div style="position: relative; z-index: 2;" class="sv-float">
              <div class="sv-phone-frame" style="max-width: 250px;">
                <div class="sv-phone-island"></div>
                <div class="sv-phone-glare"></div>
                <div class="sv-phone-screen">
                  <img
                    src="/securevault/screenshots/pincode.webp"
                    alt="Màn hình nhập mã PIN bảo mật SecureVault"
                    width="250"
                    height="551"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              </div>
            </div>

            <!-- Floating App Icon badge -->
            <div style="position: absolute; bottom: -10px; left: 10px; z-index: 3; display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 16px; background: rgba(11,17,30,.88); border: 1px solid rgba(0,240,255,.4); box-shadow: 0 10px 30px rgba(0,0,0,.8), 0 0 20px rgba(0,240,255,.25); backdrop-filter: blur(12px);">
              <img src="/securevault/app-icon.webp" alt="SecureVault Icon" width="36" height="36" style="border-radius: 9px; object-fit: cover;" />
              <div style="text-align: left;">
                <div style="font-size: 13px; font-weight: 800; color: #FFFFFF;">SecureVault</div>
                <div style="font-size: 11px; font-family: 'JetBrains Mono', monospace; color: var(--sv-cyan);">All-in-one Vault</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 2 – 4 TRỤ CỘT BẢO MẬT (CORE USP BENTO GRID)
    ============================================================ -->
    <section class="sv-section" style="background: var(--sv-space); border-top: 1px solid var(--sv-border-subtle); border-bottom: 1px solid var(--sv-border-subtle);">
      <div class="sv-container">
        <div style="text-align: center; margin-bottom: 56px;">
          <span class="sv-chip">// SECURITY_ARCHITECTURE</span>
