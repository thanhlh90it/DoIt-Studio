---
import MainLayout from '../../../layouts/MainLayout.astro';
---

<MainLayout
  title="SecureVault – Két Sắt Số Cá Nhân | DoIT-Studio"
  description="Bảo mật cục bộ – An tâm tuyệt đối. Ứng dụng két sắt cá nhân bảo mật cao, lưu trữ ảnh & video riêng tư hoàn toàn trên thiết bị của bạn. Không máy chủ. Không rò rỉ."
>
  <!-- ========================================================
       GLOBAL STYLES – SecureVault Landing
  ======================================================== -->
  <style>
    /* ── Design tokens ── */
    :root {
      --sv-black:   #000000;
      --sv-space:   #0A0E17;
      --sv-card:    #0D1525;
      --sv-cyan:    #00F0FF;
      --sv-blue:    #007AFF;
      --sv-body:    #A0A5B5;
      --sv-white:   #FFFFFF;
      --sv-border:  rgba(0,240,255,.12);
      --sv-glow-c:  rgba(0,240,255,.22);
      --sv-glow-b:  rgba(0,122,255,.18);
    }

    /* ── Global reset for this page ── */
    .sv-page * { box-sizing: border-box; }
    .sv-page { font-family: 'Space Grotesk', 'Inter', sans-serif; color: var(--sv-white); background: var(--sv-black); }

    /* ── Glassmorphism card ── */
    .sv-glass {
      background: rgba(13,21,37,.65);
      border: 1px solid var(--sv-border);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    /* ── Neon glow text ── */
    .sv-glow-text {
      color: var(--sv-cyan);
      text-shadow: 0 0 18px rgba(0,240,255,.55), 0 0 40px rgba(0,240,255,.25);
    }

    /* ── Cyan glowing button ── */
    .sv-btn-primary {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 28px; border-radius: 14px; font-weight: 700; font-size: 15px;
      background: linear-gradient(135deg, #007AFF 0%, #00C6FF 100%);
      color: #000; border: none; cursor: pointer; text-decoration: none;
      box-shadow: 0 0 28px rgba(0,240,255,.35), 0 4px 24px rgba(0,122,255,.45);
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .sv-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 0 42px rgba(0,240,255,.55), 0 8px 32px rgba(0,122,255,.55); }

    .sv-btn-outline {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 13px 28px; border-radius: 14px; font-weight: 700; font-size: 15px;
      background: transparent; color: var(--sv-cyan);
      border: 1.5px solid rgba(0,240,255,.5); cursor: pointer; text-decoration: none;
      box-shadow: 0 0 18px rgba(0,240,255,.12);
      transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
    }
    .sv-btn-outline:hover { background: rgba(0,240,255,.08); transform: translateY(-2px); box-shadow: 0 0 30px rgba(0,240,255,.25); }

    /* ── Section label chip ── */
    .sv-chip {
      display: inline-block; padding: 5px 16px;
      border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      background: rgba(0,240,255,.08); color: var(--sv-cyan); border: 1px solid rgba(0,240,255,.3);
    }

    /* ── Feature icon box ── */
    .sv-icon-box {
      width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
      background: rgba(0,240,255,.08); border: 1px solid rgba(0,240,255,.25);
      box-shadow: 0 0 20px rgba(0,240,255,.12);
      flex-shrink: 0;
    }

    /* ── Circuit BG overlay ── */
    .sv-circuit-bg {
      position: absolute; inset: 0;
      background-image: url('/securevault/digital-bg.jpg');
      background-size: cover; background-position: center;
      opacity: .12; pointer-events: none;
    }

    /* ── Step connector line ── */
    .sv-step-line {
      flex: 1; height: 1px;
      background: linear-gradient(90deg, rgba(0,240,255,.4), rgba(0,240,255,.05));
    }

    /* ── Animations ── */
    @keyframes sv-pulse-ring {
      0% { box-shadow: 0 0 0 0 rgba(0,240,255,.5); }
      70% { box-shadow: 0 0 0 16px rgba(0,240,255,0); }
      100% { box-shadow: 0 0 0 0 rgba(0,240,255,0); }
    }
    .sv-pulse { animation: sv-pulse-ring 2.4s ease-out infinite; }

    @keyframes sv-float {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(-10px); }
    }
    .sv-float { animation: sv-float 4s ease-in-out infinite; }

    @media (prefers-reduced-motion: reduce) {
      .sv-pulse, .sv-float { animation: none; }
    }

    /* ── Responsive helpers ── */
    .sv-section { padding: 80px 0; }
    .sv-container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
    @media (max-width: 768px) { .sv-section { padding: 56px 0; } }
  </style>

  <div class="sv-page">

    <!-- ============================================================
         BACK BREADCRUMB
    ============================================================ -->
    <div class="sv-container pt-6 pb-0">
      <a href="/apps" class="inline-flex items-center gap-2 text-sm font-mono text-slate-400 hover:text-cyan-300 transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        ← Ý Tưởng & Dự Án
      </a>
    </div>

    <!-- ============================================================
         SECTION 1 – HERO
    ============================================================ -->
    <section class="sv-section relative overflow-hidden" style="padding-top: 56px; padding-bottom: 96px;">
      <!-- Circuit board background -->
      <div class="sv-circuit-bg" aria-hidden="true"></div>
      <!-- Glow orbs -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse at center, rgba(0,240,255,.12) 0%, transparent 70%); filter: blur(40px);" aria-hidden="true"></div>
      <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(0,122,255,.15) 0%, transparent 70%); filter: blur(60px);" aria-hidden="true"></div>

      <div class="sv-container relative z-10">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;">

          <!-- LEFT: Copy -->
          <div>
            <!-- Status badge -->
            <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: rgba(0,240,255,.07); border: 1px solid rgba(0,240,255,.25); margin-bottom: 28px;">
              <span class="sv-pulse" style="width: 8px; height: 8px; border-radius: 50%; background: var(--sv-cyan); display: inline-block;"></span>
              <span style="font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--sv-cyan); font-family: 'JetBrains Mono', monospace;">MVP 1.0 · Available Now</span>
            </div>

            <h1 style="font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; line-height: 1.08; letter-spacing: -.02em; margin-bottom: 20px;">
              Két Sắt Số Cá Nhân –<br>
              <span class="sv-glow-text">Bảo Mật Ảnh &amp; Video</span><br>
              Tuyệt Đối.
            </h1>

            <p style="font-size: 18px; line-height: 1.7; color: var(--sv-body); margin-bottom: 36px; max-width: 480px;">
              Lưu trữ khép kín hoàn toàn trên thiết bị của bạn. Không máy chủ trung gian, không rò rỉ dữ liệu. <strong style="color: var(--sv-white);">Bảo mật cục bộ – An tâm tuyệt đối.</strong>
            </p>

            <!-- CTA Buttons -->
            <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 44px;">
              <a href="#" class="sv-btn-primary" aria-label="Tải SecureVault trên App Store">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98l-.09.06c-.22.14-2.19 1.3-2.17 3.87.02 3.08 2.69 4.11 2.72 4.12l-.1.09M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                App Store
              </a>
              <a href="#" class="sv-btn-outline" aria-label="Tải SecureVault trên Google Play">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199a1 1 0 01.003 1.725l-2.232 1.29L13.2 10.26l1.63-1.628 2.869 1.876zM5.864 2.658L16.8 8.99l-2.302 2.302-8.635-8.634z"/></svg>
                Google Play
              </a>
            </div>

            <!-- Trust badges -->
            <div style="display: flex; flex-wrap: wrap; gap: 20px; align-items: center;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span style="font-size: 13px; color: var(--sv-body);">100% Cục bộ</span>
              </div>
              <div style="display: flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                <span style="font-size: 13px; color: var(--sv-body);">Sandbox App</span>
              </div>
              <div style="display: flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                <span style="font-size: 13px; color: var(--sv-body);">Face ID / Touch ID</span>
              </div>
            </div>
          </div>

          <!-- RIGHT: App mockup / Icon -->
          <div style="display: flex; justify-content: center; align-items: center; position: relative;">
            <!-- Glow ring behind icon -->
            <div class="sv-float" style="position: relative; z-index: 2;">
              <div style="width: 240px; height: 240px; border-radius: 52px; overflow: hidden; box-shadow: 0 0 80px rgba(0,240,255,.4), 0 0 160px rgba(0,122,255,.2), 0 32px 80px rgba(0,0,0,.8); border: 1.5px solid rgba(0,240,255,.3);">
                <img
                  src="/securevault/app-icon.png"
                  alt="SecureVault app icon – Shield with lock"
                  width="240"
                  height="240"
                  style="width: 100%; height: 100%; object-fit: cover; display: block;"
                />
              </div>
            </div>
            <!-- Rotating ring -->
            <div style="position: absolute; width: 280px; height: 280px; border-radius: 50%; border: 1px dashed rgba(0,240,255,.18); pointer-events: none;" aria-hidden="true"></div>
            <div style="position: absolute; width: 340px; height: 340px; border-radius: 50%; border: 1px dashed rgba(0,240,255,.08); pointer-events: none;" aria-hidden="true"></div>
          </div>

        </div>
      </div>

      <!-- Responsive mobile layout -->
      <style>
        @media (max-width: 768px) {
          #sv-hero-grid { grid-template-columns: 1fr !important; }
          #sv-hero-grid > div:last-child { display: none !important; }
        }
      </style>
    </section>

    <!-- ============================================================
         SECTION 2 – TẠI SAO CHỌN SECUREVAULT? (CORE USP)
    ============================================================ -->
    <section class="sv-section" style="background: var(--sv-space);">
      <div class="sv-container">
        <div style="text-align: center; margin-bottom: 56px;">
          <span class="sv-chip">// CORE_USP</span>
          <h2 style="font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 800; margin-top: 16px; margin-bottom: 12px; letter-spacing: -.02em;">
            Tại Sao Chọn <span class="sv-glow-text">SecureVault?</span>
          </h2>
          <p style="color: var(--sv-body); font-size: 17px; max-width: 540px; margin: 0 auto; line-height: 1.6;">
            Được xây dựng với triết lý <strong style="color: var(--sv-white);">Privacy-First</strong> — dữ liệu của bạn chỉ thuộc về bạn.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
          <!-- USP 1 -->
          <div class="sv-glass" style="border-radius: 24px; padding: 36px 32px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle, rgba(0,240,255,.1) 0%, transparent 70%); pointer-events: none;" aria-hidden="true"></div>
            <div class="sv-icon-box" style="margin-bottom: 24px;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="1.8" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 style="font-size: 19px; font-weight: 700; margin-bottom: 12px;">100% Cục Bộ</h3>
            <p style="color: var(--sv-body); line-height: 1.65; font-size: 15px;">
              Ảnh và video được lưu trong phân vùng <strong style="color: var(--sv-white);">Sandbox khép kín</strong> của hệ điều hành. Tuyệt đối không tải lên đám mây — loại bỏ hoàn toàn rủi ro bị tấn công máy chủ.
            </p>
            <div style="margin-top: 20px; padding: 10px 14px; border-radius: 10px; background: rgba(0,240,255,.06); border: 1px solid rgba(0,240,255,.15); font-size: 12px; font-family: 'JetBrains Mono', monospace; color: var(--sv-cyan);">
              ✓ App Sandbox · Local Storage Only
            </div>
          </div>

          <!-- USP 2 -->
          <div class="sv-glass" style="border-radius: 24px; padding: 36px 32px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle, rgba(0,122,255,.12) 0%, transparent 70%); pointer-events: none;" aria-hidden="true"></div>
            <div class="sv-icon-box" style="margin-bottom: 24px;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="1.8" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/><circle cx="12" cy="12" r="3"/><path d="M12 8v8"/><path d="M9 12h6"/></svg>
            </div>
            <h3 style="font-size: 19px; font-weight: 700; margin-bottom: 12px;">Sinh Trắc Học Tích Hợp</h3>
            <p style="color: var(--sv-body); line-height: 1.65; font-size: 15px;">
              Mở khóa két sắt tức thì dưới <strong style="color: var(--sv-white);">1 giây</strong> bằng Face ID, Touch ID hoặc mã PIN bảo mật. Dữ liệu sinh trắc học được xử lý hoàn toàn bởi hệ điều hành, không lưu trữ.
            </p>
            <div style="margin-top: 20px; padding: 10px 14px; border-radius: 10px; background: rgba(0,240,255,.06); border: 1px solid rgba(0,240,255,.15); font-size: 12px; font-family: 'JetBrains Mono', monospace; color: var(--sv-cyan);">
              ✓ Face ID · Touch ID · PIN Hash
            </div>
          </div>

          <!-- USP 3 -->
          <div class="sv-glass" style="border-radius: 24px; padding: 36px 32px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle, rgba(0,240,255,.08) 0%, transparent 70%); pointer-events: none;" aria-hidden="true"></div>
            <div class="sv-icon-box" style="margin-bottom: 24px;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="1.8" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <h3 style="font-size: 19px; font-weight: 700; margin-bottom: 12px;">Mượt Mà &amp; Hiệu Năng Cao</h3>
            <p style="color: var(--sv-body); line-height: 1.65; font-size: 15px;">
              Cuộn mượt không độ trễ ngay cả với <strong style="color: var(--sv-white);">1000+ ảnh &amp; video HD</strong>. Công nghệ Lazy Load tối ưu đảm bảo trải nghiệm nhanh và nhẹ nhàng.
            </p>
            <div style="margin-top: 20px; padding: 10px 14px; border-radius: 10px; background: rgba(0,240,255,.06); border: 1px solid rgba(0,240,255,.15); font-size: 12px; font-family: 'JetBrains Mono', monospace; color: var(--sv-cyan);">
              ✓ Lazy Load · Virtualized Grid
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 3 – FEATURE SHOWCASE (Z-pattern)
    ============================================================ -->
    <section class="sv-section" style="background: var(--sv-black);">
      <div class="sv-container">
        <div style="text-align: center; margin-bottom: 64px;">
          <span class="sv-chip">// FEATURE_MODULES</span>
          <h2 style="font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 800; margin-top: 16px; letter-spacing: -.02em;">
            Khám Phá <span class="sv-glow-text">Tính Năng Cốt Lõi</span>
          </h2>
        </div>

        <!-- Feature rows (Z-pattern simulation using full cards) -->
        <div style="display: flex; flex-direction: column; gap: 32px;">

          <!-- Feature 1 – Album Management -->
          <div class="sv-glass" style="border-radius: 28px; padding: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;">
            <div>
              <div style="display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px;">
                <div class="sv-icon-box" style="width: 44px; height: 44px; border-radius: 12px;">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="1.8" aria-hidden="true"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
                </div>
                <span class="sv-chip" style="font-size: 11px;">TÍNH NĂNG 01</span>
              </div>
              <h3 style="font-size: clamp(1.3rem, 3vw, 1.75rem); font-weight: 800; margin-bottom: 16px; line-height: 1.2;">Quản Lý Album<br><span class="sv-glow-text">Đa Tầng</span></h3>
              <p style="color: var(--sv-body); line-height: 1.7; font-size: 16px; margin-bottom: 24px;">
                Phân loại hình ảnh, video nhạy cảm thành từng thư mục chuyên biệt. Dễ dàng di chuyển, sắp xếp tệp linh hoạt theo ý muốn — như một hệ thống quản lý tệp riêng biệt.
              </p>
              <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px;">
                <li style="display: flex; align-items: center; gap: 10px; color: var(--sv-body); font-size: 14px;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Tạo thư mục lồng nhau đa cấp
                </li>
                <li style="display: flex; align-items: center; gap: 10px; color: var(--sv-body); font-size: 14px;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Di chuyển & sao chép nhanh
                </li>
                <li style="display: flex; align-items: center; gap: 10px; color: var(--sv-body); font-size: 14px;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Grid view & list view tùy chỉnh
                </li>
              </ul>
            </div>
            <!-- Mockup placeholder (screenshot_2_albums) -->
            <div style="position: relative;">
              <div style="background: linear-gradient(135deg, rgba(0,240,255,.08) 0%, rgba(0,122,255,.06) 100%); border: 1px solid var(--sv-border); border-radius: 20px; aspect-ratio: 9/16; max-height: 380px; display: flex; align-items: center; justify-content: center; overflow: hidden; margin: 0 auto; max-width: 200px;">
                <div style="text-align: center; padding: 20px;">
                  <div style="width: 64px; height: 64px; border-radius: 20px; background: rgba(0,240,255,.1); border: 1px solid rgba(0,240,255,.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--sv-cyan)" stroke-width="1.5" aria-hidden="true"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
                  </div>
                  <p style="color: var(--sv-cyan); font-size: 12px; font-family: 'JetBrains Mono', monospace; opacity: .7;">Albums View</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Feature 2 – Full Screen Viewer -->
          <div class="sv-glass" style="border-radius: 28px; padding: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;">
            <!-- Mockup on LEFT for Z-pattern -->
