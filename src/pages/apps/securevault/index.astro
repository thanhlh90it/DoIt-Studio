  <!-- ========================================================================
       CLIENT-SIDE INTERACTIVITY SCRIPTS
       ======================================================================== -->
  <script is:inline>
    (function () {
      const qrModal = document.getElementById('sv-qr-modal');
      const iosModal = document.getElementById('sv-ios-modal');

      function openModal(modal) {
        if (!modal) return;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal(modal) {
        if (!modal) return;
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      // QR Modal triggers
      document.querySelectorAll('.js-open-qr-modal').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openModal(qrModal);
        });
      });

      document.querySelectorAll('.js-close-qr-modal').forEach((btn) => {
        btn.addEventListener('click', () => closeModal(qrModal));
      });

      // iOS Modal triggers
      document.querySelectorAll('.js-open-ios-modal').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openModal(iosModal);
        });
      });

      document.querySelectorAll('.js-close-ios-modal').forEach((btn) => {
        btn.addEventListener('click', () => closeModal(iosModal));
      });

      // Backdrop click
      [qrModal, iosModal].forEach((modal) => {
        if (!modal) return;
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            closeModal(modal);
          }
        });
      });

      // Escape key to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal(qrModal);
          closeModal(iosModal);
        }
      });

      // Copy link buttons
      document.querySelectorAll('.js-copy-link-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          const url = btn.getAttribute('data-url') || 'https://play.google.com/store/apps/details?id=com.thanhle.securevault';
          const textEl = btn.querySelector('.js-copy-text');
          try {
            await navigator.clipboard.writeText(url);
            if (textEl) {
              const oldText = textEl.textContent;
              textEl.textContent = 'Đã sao chép!';
              btn.style.borderColor = 'rgba(74, 222, 128, 0.6)';
              btn.style.color = '#4ADE80';
              setTimeout(() => {
                textEl.textContent = oldText;
                btn.style.borderColor = '';
                btn.style.color = '';
              }, 2000);
            }
          } catch (err) {
            console.error('Clipboard copy failed:', err);
          }
        });
      });
    })();
  </script>
