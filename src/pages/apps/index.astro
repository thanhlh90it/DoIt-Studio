---
import MainLayout from '../../layouts/MainLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import StructuredData from '../../components/StructuredData.astro';
import { getSoftwareAppSchema } from '../../utils/seoSchemas';

const appsSchemas = [
  getSoftwareAppSchema({
    name: "SecureVault",
    description: "Két sắt cá nhân bảo mật cao trên di động - 100% local-first privacy, không máy chủ, mã hóa AES-256-GCM.",
    applicationCategory: "SecurityApplication",
    url: "https://doitstudio.tech/apps/securevault",
    downloadUrl: "https://apps.apple.com/us/app/securevault-ẩn-ảnh-mật-khẩu/id6800250737"
  }),
  getSoftwareAppSchema({
    name: "NhàTa",
    description: "Không gian số ấm áp, riêng tư cho tổ ấm gia đình: Lịch biểu chung & TKB, phân chia việc nhà, tích sao đổi quà.",
    applicationCategory: "LifestyleApplication",
    url: "https://doitstudio.tech/nhata"
  }),
  getSoftwareAppSchema({
    name: "NoduleTrack",
    description: "Ứng dụng di động y tế cá nhân chuyên biệt hỗ trợ số hóa hồ sơ siêu âm, theo dõi tốc độ tăng trưởng của nang, nhân, hạch chuẩn TI-RADS.",
    applicationCategory: "HealthApplication",
    url: "https://doitstudio.tech/noduletrack"
  }),
  getSoftwareAppSchema({
    name: "Tevy",
    description: "Hệ sinh thái giám sát thời gian xem TV cho trẻ em thông minh: Khóa màn hình tức thì từ xa qua điện thoại, tự động ngắt nghỉ 30 phút bảo vệ mắt trẻ chuẩn y khoa.",
    applicationCategory: "ParentingApplication",
    url: "https://doitstudio.tech/tevy"
  })
];

const appIdeas = [
  {
    slug: '/tevy',
    title: 'Tevy',
    description: 'Hệ sinh thái kiểm soát thời gian xem TV cho trẻ em thông minh: Khóa màn hình tức thì 1 chạm từ xa qua điện thoại, giới hạn phiên xem 30 phút bảo vệ thị lực chuẩn y khoa và chế độ ru ngủ ban đêm.',
    date: '25/09/2026',
    status: 'Đã hoàn thiện Landing Page & TV Simulator',
    tags: ['Android TV', 'Google TV', 'Parental Control', 'Digital Wellbeing', 'React Native']
  },
  {
    slug: '/nhata',
    title: 'NhàTa',
    description: 'Không gian số ấm áp, riêng tư cho tổ ấm gia đình: Lịch biểu chung & TKB, phân chia việc nhà tích sao đổi quà rèn luyện tính tự lập cho con, album kỷ niệm và quản lý chi tiêu.',
    date: '04/09/2026',
    status: 'Đã phát hành (App Store & Google Play)',
    tags: ['React Native', 'Expo', 'Firebase', 'Family', 'Gamification']
  },
  {
    slug: '/apps/securevault',
    title: 'SecureVault',
    description: 'Két sắt cá nhân đa năng bảo vệ ảnh, video riêng tư và quản lý mật khẩu mã hóa AES-256-GCM. 100% cục bộ, Face ID, Blur Shield, tự động xóa clipboard. Không máy chủ.',
    date: '08/09/2026',
    status: 'Đã phát hành (App Store & Google Play)',
    tags: ['React Native', 'Expo', 'AES-256', 'Privacy', 'iOS', 'Android']
  },
  {
    slug: '/noduletrack',
    title: 'NoduleTrack',
    description: 'Ứng dụng di động y tế cá nhân chuyên biệt hỗ trợ số hóa hồ sơ siêu âm, theo dõi tốc độ tăng trưởng của nang, nhân, hạch và nhắc lịch tái khám chuẩn TI-RADS/BI-RADS.',
    date: '18/08/2026',
    status: 'Đã phát hành (Google Play)',
    tags: ['HealthTech', 'TI-RADS', 'Google Play', 'Mobile']
  },
  {
    slug: 'dotask-minimalist',
    title: 'DoTask Minimalist',
    description: 'Ứng dụng quản lý công việc theo phương pháp Kanban kết hợp Pomodoro tối giản, giúp tập trung cao độ.',
    date: '14/08/2026',
    status: 'Đang phát triển',
    tags: ['Astro', 'Tailwind', 'TypeScript']
  },
  {
    slug: 'mindspace-notes',
    title: 'MindSpace Notes',
    description: 'Công cụ ghi chú liên kết dạng mạng lưới (Bi-directional linking) dành cho việc quản lý tri thức cá nhân (PKM).',
    date: '10/08/2026',
    status: 'Ý tưởng',
    tags: ['MDX', 'React', 'LocalFirst']
  },
  {
    slug: 'ambient-focus-audio',
    title: 'Ambient Focus Audio',
    description: 'Trình phát âm thanh tiếng ồn trắng (White noise) và âm thanh thiên nhiên giúp tăng cường khả năng sáng tạo khi lập trình.',
    date: '05/08/2026',
    status: 'Thử nghiệm (Beta)',
    tags: ['Web Audio API', 'Astro']
  },
  {
    slug: 'budgetlite-tracker',
    title: 'BudgetLite Tracker',
    description: 'Sổ thu chi tối giản không cần đăng nhập, lưu trữ dữ liệu an toàn trực tiếp trên trình duyệt của người dùng.',
    date: '28/07/2026',
    status: 'Ý tưởng',
    tags: ['IndexedDB', 'Tailwind CSS']
  }
];
---

<MainLayout title="Ý Tưởng Ứng Dụng | DoIT-Studio Telemetry" description="Bộ sưu tập các ý tưởng và dự án ứng dụng phần mềm đang được phát triển tại DoIT-Studio.">
  <StructuredData schema={appsSchemas} />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 w-full">
    <!-- Header HUD -->
    <div class="max-w-4xl mb-14 font-mono">
      <span class="px-4 py-1.5 rounded-lg bg-blue-600/20 text-cyan-300 border border-cyan-400/35 text-xs sm:text-sm font-bold">
        // SHOWCASE_MODULES & APPS
      </span>
      <h1 class="font-tech text-4xl sm:text-6xl font-black text-white mt-4 mb-5 tracking-tight">
        Ý Tưởng & Dự Án Ứng Dụng
      </h1>
      <p class="text-slate-300 text-base sm:text-[19px] leading-relaxed font-['Plus_Jakarta_Sans',sans-serif]">
        Nơi tổng hợp các ý tưởng sản phẩm số, thiết kế giao diện thử nghiệm và các dự án tiện ích cá nhân do DoIT-Studio nghiên cứu & phát triển.
      </p>

      <!-- Status Indicator Pills HUD -->
      <div class="flex flex-wrap gap-2.5 mt-8 font-mono">
        <span class="px-4 py-1.5 rounded-lg bg-black text-slate-200 text-xs sm:text-sm font-bold border border-slate-800">
          ALL (6)
        </span>
        <span class="px-4 py-1.5 rounded-lg bg-blue-500/20 text-cyan-300 text-xs sm:text-sm font-bold border border-blue-500/40">
          ● IN_DEV (1)
        </span>
        <span class="px-4 py-1.5 rounded-lg bg-sky-500/20 text-sky-200 text-xs sm:text-sm font-bold border border-sky-500/40">
          ● CONCEPT (2)
        </span>
        <span class="px-4 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-200 text-xs sm:text-sm font-bold border border-cyan-400/50">
          ● BETA (3)
        </span>
      </div>
    </div>

    <!-- App Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {appIdeas.map((app) => (
        <ProjectCard
          title={app.title}
          description={app.description}
          date={app.date}
          slug={app.slug}
          status={app.status}
          tags={app.tags}
        />
      ))}
    </div>
  </div>
</MainLayout>
